# k8s.bu
variant: fcos
version: 1.5.0

ignition:
   config: 
     merge: 
        - local: ./k8s-base.ign
storage:      
  files:
    - path: "/etc/node-type"
      mode: 420
      contents:
        inline: worker
    - path: "/etc/k8s-config.yaml"
      mode: 420
      contents:
        local: overrides/worker/k8s-config-worker.yaml 
    - path: "/usr/local/bin/setup-k8s-init.sh"
      mode: 0755
      contents:
        local: overrides/worker/setup-k8s-init.sh
    - path: "/usr/local/bin/join_cluster.sh"
      mode: 0755
      contents:
        local: overrides/worker/join_cluster.sh
    - path: "/usr/local/bin/setup-k8s-ph3.sh"
      mode: 0755
      contents:
        local: overrides/worker/setup-k8s-ph3.sh
    - path: "/usr/local/bin/auto-join.sh"
      mode: 0755
      contents:
        local: overrides/control-worker/auto-join.sh
systemd:
  units:
    - name: fck8s-auto-join.service
      enabled: true
      contents: |
        [Unit]
        Description=K4All Auto Join Cluster
        Requires=network-online.target
        After=network-online.target fck8s-k8s-setup-ph3.service
        StartLimitIntervalSec=0

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/auto-join.sh
        RemainAfterExit=yes
        Restart=on-failure
        RestartSec=30

        [Install]
        WantedBy=multi-user.target