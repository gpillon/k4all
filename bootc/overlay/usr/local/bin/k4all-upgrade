class UpgradeError(Exception):
    """A step failed in a way that needs a human; the hop goes to HOLD."""


class NoPathError(Exception):
    """No safe sequence of releases reaches the requested target."""


class RollbackNeeded(UpgradeError):
    """The node booted the new image but is not healthy."""


class NotYet(UpgradeError):
    """The hop cannot start yet, for a reason that passes by itself: another
    node has to go first, or someone has to drain this one. Not a HOLD: the
    plan stays in PREFLIGHT and the timer or the agent tries again at its
    next pass; `run` says why and leaves no plan behind."""


# =========================================================================
# Versions
# =========================================================================
_VERSION_RE = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?$")


def parse_version(text):
    """Return a sortable key for a k4all release version (semver)."""
    match = _VERSION_RE.match(str(text).strip())
    if not match:
        raise ValueError("not a release version: %r" % (text,))
    major, minor, patch, pre = match.groups()
    if pre is None:
        pre_key = (1,)
    else:
        ids = []
        for part in pre.split("."):
            ids.append((0, int(part), "") if part.isdigit() else (1, 0, part))
        pre_key = (0, tuple(ids))
    return (int(major), int(minor), int(patch), pre_key)


def is_version(text):
    try:
        parse_version(text)
        return True
    except ValueError:
        return False


def normalize_version(text):
    text = str(text).strip()
    return text if text.startswith("v") else "v" + text


def stream_of(version):
    """The X.Y stream a release belongs to."""
    key = parse_version(version)
    return key[0], key[1]


def hop_kind(from_version, to_version):
    """A hop is 'patch' inside one X.Y stream, 'minor' otherwise."""
    return "patch" if stream_of(from_version) == stream_of(to_version) else "minor"


def k8s_minor(version):
    """(major, minor) of a Kubernetes version such as 'v1.35.7' or '1.35'."""
    match = re.match(r"^v?(\d+)\.(\d+)", str(version).strip())
    if not match:
        raise ValueError("not a Kubernetes version: %r" % (version,))
    return int(match.group(1)), int(match.group(2))


def k8s_key(version):
    match = re.match(r"^v?(\d+)\.(\d+)(?:\.(\d+))?", str(version).strip())
    if not match:
        raise ValueError("not a Kubernetes version: %r" % (version,))
    return tuple(int(x or 0) for x in match.groups())


# =========================================================================
# Release graph
# =========================================================================
class Release:
    """One entry of the upgrade graph."""

    FIELDS = ("version", "kind", "minFrom", "kubernetes", "crio", "fedora")

    def __init__(self, data):
        missing = [f for f in self.FIELDS if data.get(f) in (None, "")]
        if missing:
            raise ValueError("release %s is missing %s"
                             % (data.get("version", "?"), ", ".join(missing)))
        self.version = normalize_version(data["version"])
        self.kind = str(data["kind"])
        self.min_from = normalize_version(data["minFrom"])
        self.kubernetes = str(data["kubernetes"]).lstrip("v")
        self.crio = str(data["crio"])
        self.fedora = int(data["fedora"])
        self.sync_manifest = bool(data.get("syncManifest", False))
        self.blocked = bool(data.get("blocked", False))
        # The digest of the release's multi-arch index. Graphs carry it as
        # indexDigest; "digest" is the key of older graphs. The tools of
        # v2.2.4 - v2.6.0 read only "digest" and cannot match an image staged
        # by it (see _same_image): a new graph must never use that key.
        self.index_digest = data.get("indexDigest") or data.get("digest") or ""
        self.notes = data.get("notes", "")
        self.key = parse_version(self.version)
        self.min_from_key = parse_version(self.min_from)

    def image_ref(self, image):
        if self.index_digest:
            return "%s@%s" % (image, self.index_digest)
        return "%s:%s" % (image, self.version)

    def to_dict(self):
        out = {"version": self.version, "kind": self.kind,
               "minFrom": self.min_from, "kubernetes": self.kubernetes,
               "crio": self.crio, "fedora": self.fedora,
               "syncManifest": self.sync_manifest, "blocked": self.blocked}
        if self.index_digest:
            out["indexDigest"] = self.index_digest
        if self.notes:
            out["notes"] = self.notes
        return out

    def __repr__(self):
        return "Release(%s)" % self.version


def load_graph(data):
    """Parse a graph document ({"releases": [...]} or a bare list)."""
    entries = data.get("releases", []) if isinstance(data, dict) else data
    releases = sorted((Release(e) for e in entries), key=lambda r: r.key)
    return releases


def validate_graph(releases):
    """Return a list of violations of the k4all versioning rules."""
    errors = []
    seen = set()
    previous = None
    for rel in releases:
        if rel.version in seen:
            errors.append("%s appears twice" % rel.version)
        seen.add(rel.version)
        if rel.kind not in ("minor", "patch"):
            errors.append("%s: kind must be minor or patch" % rel.version)
        if rel.min_from_key >= rel.key:
            errors.append("%s: minFrom must be older than the release" % rel.version)
        if rel.kind == "minor" and rel.key[2] != 0:
            errors.append("%s: a minor release must be X.Y.0" % rel.version)
        if rel.kind == "patch" and rel.key[2] == 0 and previous is not None \
                and stream_of(previous.version) != stream_of(rel.version):
            errors.append("%s: X.Y.0 opening a new stream must be a minor"
                          % rel.version)
        if rel.kind == "patch" and previous is not None \
                and stream_of(previous.version) == stream_of(rel.version):
            stream_start = parse_version("v%d.%d.0" % stream_of(rel.version))
            if rel.min_from_key < stream_start:
                errors.append("%s: a patch must have minFrom >= %d.%d.0"
                              % ((rel.version,) + stream_of(rel.version)))
        try:
            if k8s_minor(rel.crio) > k8s_minor(rel.kubernetes):
                errors.append("%s: CRI-O %s is newer than Kubernetes %s"
                              % (rel.version, rel.crio, rel.kubernetes))
        except ValueError as exc:
            errors.append("%s: %s" % (rel.version, exc))
        if previous is not None:
            errors.extend(_validate_step(previous, rel))
        # A minor release may not be skipped: no other minor release lies
        # strictly between minFrom and the release.
        for other in releases:
            if other.kind == "minor" and rel.min_from_key < other.key < rel.key:
                errors.append("%s: minFrom %s skips minor release %s"
                              % (rel.version, rel.min_from, other.version))
        previous = rel
    return errors


def _validate_step(prev, rel):
    errors = []
    prev_k8s, rel_k8s = k8s_minor(prev.kubernetes), k8s_minor(rel.kubernetes)
    if rel_k8s[1] - prev_k8s[1] > 1 or rel_k8s[0] != prev_k8s[0]:
        errors.append("%s: Kubernetes jumps from %s to %s"
                      % (rel.version, prev.kubernetes, rel.kubernetes))
    if rel_k8s < prev_k8s:
        errors.append("%s: Kubernetes goes backwards" % rel.version)
    k8s_changed = rel_k8s != prev_k8s
    fedora_changed = rel.fedora != prev.fedora
    crio_changed = k8s_minor(rel.crio) != k8s_minor(prev.crio)
    if k8s_changed and fedora_changed:
        errors.append("%s: changes Kubernetes minor and Fedora together"
                      % rel.version)
    if rel.kind == "patch" and (k8s_changed or fedora_changed or crio_changed):
        errors.append("%s: a patch cannot change Kubernetes minor, Fedora or "
                      "CRI-O minor" % rel.version)
    if k8s_minor(prev.crio) == prev_k8s and k8s_minor(rel.crio) != rel_k8s:
        errors.append("%s: CRI-O %s no longer matches Kubernetes %s"
                      % (rel.version, rel.crio, rel.kubernetes))
    return errors


def plan_path(releases, current, target=None):
    """Return the releases to visit, in order, from ``current`` to ``target``.

    Rules: never skip a minor release (minFrom), finish the current X.Y
    stream before crossing into the next one, and never pick a blocked
    release.
    """
    usable = [r for r in releases if not r.blocked]
    if not usable:
        raise NoPathError("the upgrade graph has no usable release")
    cur_key = parse_version(current)
    if target in (None, "", "latest"):
        target_rel = max(usable, key=lambda r: r.key)
    else:
        target_key = parse_version(normalize_version(target))
        matches = [r for r in usable if r.key == target_key]
        if not matches:
            raise NoPathError("release %s is not in the upgrade graph or is "
                              "blocked" % normalize_version(target))
        target_rel = matches[0]
    if target_rel.key <= cur_key:
        return []
    minors = [r for r in releases if r.kind == "minor"]
    path = []
    cur_version = normalize_version(current)
    while cur_key < target_rel.key:
        options = [r for r in usable
                   if cur_key < r.key <= target_rel.key
                   and r.min_from_key <= cur_key
                   and not any(cur_key < m.key < r.key for m in minors)]
        if not options:
            raise NoPathError("no release can be reached from %s on the way "
                              "to %s" % (cur_version, target_rel.version))
        same_stream = [r for r in options
                       if stream_of(r.version) == stream_of(cur_version)]
        crossing = [r for r in options
                    if stream_of(r.version) != stream_of(cur_version)]
        # Finish the stream: a newer usable release of it that no hop
        # reaches from here (its minFrom comes after a blocked patch, say)
        # stops the plan instead of being left behind.
        newer_in_stream = [r for r in usable
                           if stream_of(r.version) == stream_of(cur_version)
                           and r.key > cur_key]
        if crossing and newer_in_stream and not same_stream:
            latest_patch = max(newer_in_stream, key=lambda r: r.key)
            raise NoPathError("cannot leave %s before reaching %s, the "
                              "latest patch of its stream, and no hop "
                              "reaches it from %s (minFrom %s)"
                              % (cur_version, latest_patch.version,
                                 cur_version, latest_patch.min_from))
        if same_stream and crossing:
            nxt = max(same_stream, key=lambda r: r.key)
        else:
            nxt = max(options, key=lambda r: r.key)
        path.append(nxt)
        cur_key, cur_version = nxt.key, nxt.version
    return path


def auto_allowed(path, current, allow):
    """Keep the leading hops that the automatic policy may run."""
    allowed = []
    cur = current
    for rel in path:
        if allow != "minor" and hop_kind(cur, rel.version) != "patch":
            break
        allowed.append(rel)
        cur = rel.version
    return allowed


# =========================================================================
# Policy
# =========================================================================
def merge_config(user):
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    for key, value in (user or {}).items():
        if key == "window" and isinstance(value, dict):
            cfg["window"].update(value)
        else:
            cfg[key] = value
    if cfg["mode"] not in VALID_MODES:
        raise UpgradeError("mode must be one of %s" % ", ".join(VALID_MODES))
    if cfg["autoAllow"] not in VALID_ALLOW:
        raise UpgradeError("autoAllow must be one of %s" % ", ".join(VALID_ALLOW))
    for day in cfg["window"]["days"]:
        if day not in DAY_NAMES:
            raise UpgradeError("unknown window day %r (use %s)"
                               % (day, ", ".join(DAY_NAMES)))
    _parse_hhmm(cfg["window"]["start"])
    most = cfg["podStopMaxSeconds"]
    if isinstance(most, bool) or not isinstance(most, (int, str)) \
            or not re.match(r"^\s*\d+\s*$", str(most)):
        raise UpgradeError("podStopMaxSeconds must be a whole number of "
                           "seconds, got %r" % (most,))
    cfg["podStopMaxSeconds"] = int(most)
    pool = cfg["maxThinPoolPercent"]
    if isinstance(pool, bool) or not isinstance(pool, (int, float)) \
            or not 0 < pool <= 100:
        raise UpgradeError("maxThinPoolPercent must be a percentage above 0 "
                           "and at most 100, got %r" % (pool,))
    return cfg


# The LVs lvs reports for the thin pool check (Upgrader._check_thin_pools).
LVS_FIELDS = ("vg_name,lv_name,lv_attr,pool_lv,data_percent,metadata_percent,"
              "lv_kernel_major,lv_kernel_minor")


def _lvs_percent(value):
    try:
        return float(str(value).strip())
    except ValueError:
        return None


def _pct(value):
    return "unknown" if value is None else "%.1f%%" % value


def thin_pool_of(lvs_report, majmin):
    """(pool "vg/name", data %, metadata %) of the thin pool under the LV
    whose kernel device is ``majmin`` ("253:3"), from `lvs --reportformat
    json`; None when that device is no thin LV (a linear LV, a partition,
    a device lvs does not list). A percent lvs leaves empty is None."""
    lvs = []
    for report in (lvs_report or {}).get("report") or []:
        lvs.extend(report.get("lv") or [])
    lv = next((lv for lv in lvs if "%s:%s" % (
        str(lv.get("lv_kernel_major", "")).strip(),
        str(lv.get("lv_kernel_minor", "")).strip()) == majmin), None)
    # lv_attr: "V" is a thin volume, "t" its pool
    if lv is None or not str(lv.get("lv_attr") or "").startswith("V") \
            or not lv.get("pool_lv"):
        return None
    pool = next((p for p in lvs if p.get("vg_name") == lv.get("vg_name")
                 and p.get("lv_name") == lv["pool_lv"]), None)
    if pool is None:
        return None
    return ("%s/%s" % (pool["vg_name"], pool["lv_name"]),
            _lvs_percent(pool.get("data_percent")),
            _lvs_percent(pool.get("metadata_percent")))


def pod_stop_max_seconds(cfg):
    return max(POD_STOP_SECONDS, int(cfg["podStopMaxSeconds"]))


def _parse_hhmm(text):
    match = re.match(r"^(\d{1,2}):(\d{2})$", str(text))
    if not match or int(match.group(1)) > 23 or int(match.group(2)) > 59:
        raise UpgradeError("window start must be HH:MM, got %r" % (text,))
    return int(match.group(1)), int(match.group(2))


def in_window(now, window):
    """True when ``now`` (local, naive) falls inside a maintenance window.

    A window that starts late on one day may continue past midnight.
    """
    hour, minute = _parse_hhmm(window["start"])
    length = datetime.timedelta(minutes=int(window["durationMinutes"]))
    for days_back in (0, 1):
        day = (now - datetime.timedelta(days=days_back)).date()
        if DAY_NAMES[day.weekday()] not in window["days"]:
            continue
        start = datetime.datetime.combine(day, datetime.time(hour, minute))
        if start <= now < start + length:
            return True
    return False


def next_window_start(now, window, not_before=None):
    """First window start at or after ``max(now, not_before)``."""
    hour, minute = _parse_hhmm(window["start"])
    base = max(now, not_before) if not_before else now
    for offset in range(0, 15):
        day = (base + datetime.timedelta(days=offset)).date()
        if DAY_NAMES[day.weekday()] not in window["days"]:
            continue
        start = datetime.datetime.combine(day, datetime.time(hour, minute))
        if start >= base:
            return start
    return None


# =========================================================================
# ReleaseManifest sync
# =========================================================================
def merge_release_manifest(cluster_cr, new_manifest):
    """Build the ReleaseManifest to apply after a hop.

    The new release decides every component spec, except that the cluster
    keeps its ``custom`` map and any ``management: Unmanaged`` choice.
    Components that the new manifest no longer lists are left untouched;
    removal is always explicit (``management: Removed``).
    """
    merged = json.loads(json.dumps(new_manifest))
    merged.setdefault("metadata", {})["name"] = RELEASE_MANIFEST_NAME
    for field in ("resourceVersion", "uid", "creationTimestamp",
                  "managedFields", "generation", "annotations"):
        merged["metadata"].pop(field, None)
    merged.pop("status", None)
    cluster_components = ((cluster_cr or {}).get("spec") or {}).get(
        "components") or {}
    components = merged.setdefault("spec", {}).setdefault("components", {})
    for name, spec in components.items():
        old = cluster_components.get(name) or {}
        if old.get("custom"):
            spec["custom"] = old["custom"]
        if old.get("management") == "Unmanaged":
            spec["management"] = "Unmanaged"
    for name, old in cluster_components.items():
        if name not in components:
            components[name] = old
    return merged


def operator_only_manifest(cluster_cr, merged):
    """The first sync step: only the k4all-operator component, or None when
    the operator does not change."""
    new = ((merged.get("spec") or {}).get("components") or {}).get(
        OPERATOR_COMPONENT)
    if not new:
        return None
    old = (((cluster_cr or {}).get("spec") or {}).get("components") or {}).get(
        OPERATOR_COMPONENT) or {}
    keys = ("version", "source", "sources", "versionUrl")
    if all(old.get(k) == new.get(k) for k in keys):
        return None
    return {"apiVersion": merged.get("apiVersion"), "kind": merged.get("kind"),
            "metadata": {"name": RELEASE_MANIFEST_NAME},
            "spec": {"components": {OPERATOR_COMPONENT: new}}}


FLOATING_VERSIONS = ("", "latest", "master", "main")
BUSY_STATES = ("Pending", "Installing", "Upgrading", "Uninstalling")


def _plain(version):
    return str(version or "").strip().lstrip("v")


# The start of the status message of a component that k4all-operator (v0.5.7
# on) keeps installed though it should go (its feature off, management
# Removed), because its uninstall would break what runs on it: KubeVirt while
# VMs exist. The component stays Installed at the version it runs.
UNINSTALL_REFUSED = "uninstall refused: "


def uninstall_refusals(cr):
    """[(component, reason)]: the uninstalls k4all-operator refuses."""
    observed = (((cr or {}).get("status") or {}).get("components")) or {}
    refused = []
    for name, st in sorted(observed.items()):
        message = (st or {}).get("message") or ""
        if message.startswith(UNINSTALL_REFUSED):
            refused.append((name, message[len(UNINSTALL_REFUSED):]))
    return refused


def failed_component_messages(cr, names):
    """{component: the operator's message, one bounded line} for ``names``."""
    observed = (((cr or {}).get("status") or {}).get("components")) or {}
    return {name: short_message((observed.get(name) or {}).get("message"))
            for name in names}


def components_settled(cr):
    """(settled, failed, waiting) for a ReleaseManifest after a sync.

    A component is settled when the operator reports it in a final state
    and, for a pinned version, has installed exactly that version. One
    whose uninstall the operator refuses is settled too: it waits on the
    user (delete what runs on it, or set it Unmanaged), not on the hop.
    """
    spec = ((cr or {}).get("spec") or {}).get("components") or {}
    status = (cr or {}).get("status") or {}
    observed = status.get("components") or {}
    refused = {name for name, _ in uninstall_refusals(cr)}
    failed, waiting = [], []
    for name, comp in sorted(spec.items()):
        management = comp.get("management") or "Managed"
        if management == "Unmanaged" or name in refused:
            continue
        st = observed.get(name) or {}
        state = st.get("state")
        if state == "Failed":
            failed.append(name)
            continue
        if management == "Removed":
            if state not in ("Removed", None):
                waiting.append(name)
            continue
        if state in BUSY_STATES or state is None:
            waiting.append(name)
            continue
        want = _plain(comp.get("version"))
        if state == "Installed" and want not in FLOATING_VERSIONS \
                and _plain(st.get("installedVersion")) != want:
            waiting.append(name)
    for cond in status.get("conditions") or []:
        if cond.get("type") == "Ready" and cond.get("status") != "True" \
                and cond.get("reason") == "UpgradeInProgress":
            waiting.append("(operator paused: %s)" % cond.get("message", ""))
    return (not failed and not waiting), failed, waiting


# =========================================================================
# Host access
# =========================================================================
# bootc commands that change deployments. They run as a transient systemd unit
# so that /usr/bin/bootc (install_exec_t) enters the install_t SELinux domain,
# as it does under bootc's own services. Started from this tool, which runs as
# unconfined_service_t, bootc stays in that domain, which lacks mac_admin: the
# kernel then refuses file labels the running policy does not know yet, and a
# new Fedora's policy brings new ones. Seen on F43 -> F45:
# "fsetxattr(security.selinux): Invalid argument".
# No --pipe: from a service, with this tool's stdout and stderr as pipes,
# systemd refuses them ("Failed to start transient service unit: Connection
# reset by peer"). bootc's output goes to the unit's journal instead, which
# Host.run reads back when the command fails.
BOOTC_VIA_SYSTEMD = ("switch", "upgrade", "rollback")


def via_systemd(argv, timeout=None):
    """Wrap deployment-changing bootc commands in systemd-run."""
    if len(argv) < 2 or argv[0] != "bootc" or argv[1] not in BOOTC_VIA_SYSTEMD:
        return argv
    wrapped = ["systemd-run", "--wait", "--collect", "--quiet",
               "--unit", "k4all-bootc-%s-%d" % (argv[1], os.getpid())]
    if timeout:
        # Stop the unit too if this tool gives up waiting for it.
        wrapped += ["--property", "RuntimeMaxSec=%d" % int(timeout)]
    return wrapped + ["--", "/usr/bin/bootc"] + list(argv[1:])


def _as_text(data):
    if data is None:
        return ""
    if isinstance(data, bytes):
        return data.decode("utf-8", "replace")
    return data


class Host:
    """Everything that touches the machine goes through this class, so the
    tests can replace it."""

    def __init__(self, root="/"):
        self.root = root

    # --- files -----------------------------------------------------------
    def path(self, p):
        if self.root in ("", "/"):
            return p
        return os.path.join(self.root, p.lstrip("/"))

    def exists(self, p):
        return os.path.exists(self.path(p))

    def read(self, p):
        with open(self.path(p), encoding="utf-8") as fh:
            return fh.read()

    def write(self, p, text, mode=0o644, tmp_dir=None):
        """Write a file atomically: a temporary file, fsync, rename, fsync of
        the directory. ``tmp_dir`` (on the same filesystem) keeps the
        temporary file out of a directory whose every file counts, such as
        the kubelet's static pod manifests."""
        full = self.path(p)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        if tmp_dir:
            # a name of its own: two writers never share a temporary file
            fd, tmp = tempfile.mkstemp(dir=self.path(tmp_dir), suffix=".k4all-tmp",
                                       prefix=".%s." % os.path.basename(full))
            fh = os.fdopen(fd, "w", encoding="utf-8")
        else:
            tmp = full + ".tmp"
            fh = open(tmp, "w", encoding="utf-8")
        with fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, full)
        dirfd = os.open(os.path.dirname(full), os.O_RDONLY)
        try:
            os.fsync(dirfd)
        finally:
            os.close(dirfd)

    def copy(self, src, dst):
        os.makedirs(os.path.dirname(self.path(dst)), exist_ok=True)
        shutil.copy2(self.path(src), self.path(dst))

    def free_gib(self, p):
        target = self.path(p)
        while not os.path.exists(target):
            target = os.path.dirname(target) or "/"
        return shutil.disk_usage(target).free / (1024 ** 3)

    # --- processes -------------------------------------------------------
    def run(self, argv, check=True, input_text=None, timeout=None):
        """Run a command. A command that times out or cannot start is a
        failed command, never an exception of its own: rc 124 (as with
        timeout(1)) or 127, so that check=False callers see a failure and
        check=True ones raise UpgradeError, which the driver turns into a
        HOLD. A TimeoutExpired escaping from here left the node half way
        with nothing to say why (kubelet stopped, no reboot, no HOLD)."""
        argv = via_systemd(argv, timeout)
        try:
            proc = subprocess.run(argv, input=input_text, capture_output=True,
                                  text=True, timeout=timeout)
        except subprocess.TimeoutExpired as exc:
            proc = subprocess.CompletedProcess(
                argv, 124, stdout=_as_text(exc.stdout),
                stderr=(_as_text(exc.stderr) + "\ntimed out after %s s"
                        % timeout).strip())
        except OSError as exc:
            proc = subprocess.CompletedProcess(argv, 127, stdout="",
                                               stderr=str(exc))
        if check and proc.returncode != 0:
            detail = (proc.stderr or proc.stdout).strip()
            if argv[0] == "systemd-run" and "--unit" in argv:
                # bootc wrote to its transient unit's journal
                unit = argv[argv.index("--unit") + 1]
                journal = subprocess.run(
                    ["journalctl", "-u", unit, "-o", "cat", "--no-pager",
                     "-n", "40"], capture_output=True, text=True, check=False)
                detail = (detail + "\n" + journal.stdout).strip()
            raise UpgradeError("%s failed (rc=%d): %s"
                               % (" ".join(argv), proc.returncode, detail[-800:]))
        return proc

    def run_bytes(self, argv, timeout=None):
        """Run a command and return its raw stdout, or b"" on failure
        (a timeout included)."""
        try:
            proc = subprocess.run(argv, capture_output=True, timeout=timeout,
                                  check=False)
        except (subprocess.TimeoutExpired, OSError):
            return b""
        return proc.stdout if proc.returncode == 0 else b""

    def now(self):
        return datetime.datetime.now()

    def sleep(self, seconds):
        time.sleep(seconds)

    def hostname(self):
        # kubeadm registers the node under the lowercased os hostname
        return socket.gethostname().strip().lower()

    def arch(self):
        machine = platform.machine()
        return {"x86_64": "amd64", "aarch64": "arm64"}.get(machine, machine)

    def fetch(self, url, timeout=20):
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return resp.read()

    def log(self, message):
        print("[k4all-upgrade] %s" % message, flush=True)


def load_yaml_text(host, text):
    """Parse YAML with PyYAML when present, otherwise through yq."""
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return yaml.safe_load(text)
    except ImportError:
        out = host.run(["yq", "-o=json", "eval", "."], input_text=text).stdout
        return json.loads(out) if out.strip() else None


def load_yaml_file(host, path):
    return load_yaml_text(host, host.read(path))


# =========================================================================
# Facts about the node
# =========================================================================
# `bootc status` waits for bootc's lock, and a download holds it for
# minutes (`bootc switch --download-only` of a hop, a `bootc upgrade` by
# hand): every call has a timeout (#131, #49 item 5). The hop's own calls
# wait BOOTC_STATUS_TIMEOUT; the agent's, `status` and the preflight's wait
# BOOTC_STATUS_QUICK, then say bootc is busy and try again later.
BOOTC_STATUS_TIMEOUT = 300
BOOTC_STATUS_QUICK = 30
BOOTC_BUSY = "bootc busy (download in progress)"


class BootcBusy(UpgradeError):
    """`bootc status` did not answer in time: another bootc command holds
    its lock. Nothing changed; the caller falls back or tries later."""


def bootc_status(host, timeout=BOOTC_STATUS_TIMEOUT):
    got = host.run(["bootc", "status", "--json"], check=False, timeout=timeout)
    if got.returncode == 124:
        raise BootcBusy("%s: `bootc status` did not answer within %d s"
                        % (BOOTC_BUSY, timeout))
    if got.returncode != 0:
        raise UpgradeError("bootc status --json failed (rc=%d): %s"
                           % (got.returncode,
                              (got.stderr or got.stdout or "").strip()[-800:]))
    try:
        return json.loads(got.stdout)
    except ValueError as exc:
        raise UpgradeError("bootc status --json printed no JSON: %s" % exc)


def _deployment(status, which):
    return ((status or {}).get("status") or {}).get(which)


def deployment_image(entry):
    image = (entry or {}).get("image") or {}
    ref = (image.get("image") or {}).get("image", "")
    return ref, image.get("imageDigest", "")


def version_from_ref(ref):
    """'ghcr.io/x/k4all-bootc:v2.2.3-amd64' -> 'v2.2.3'."""
    if ":" not in ref.rsplit("/", 1)[-1]:
        return None
    tag = ref.rsplit(":", 1)[1]
    tag = re.sub(r"-(amd64|arm64|x86_64|aarch64)$", "", tag)
    return normalize_version(tag) if is_version(tag) else None


def current_version(host, status=None, timeout=BOOTC_STATUS_TIMEOUT):
    """The k4all release the node is booted into. bootc is asked only when
    the image has neither file (``timeout``: for `bootc status`)."""
    if host.exists(VERSION_FILE):
        text = host.read(VERSION_FILE).strip()
        if is_version(text):
            return normalize_version(text)
    if host.exists(IMAGE_RELEASE_MANIFEST):
        try:
            manifest = load_yaml_file(host, IMAGE_RELEASE_MANIFEST) or {}
            tag = str(((manifest.get("spec") or {}).get("osImage") or {})
                      .get("imageTag", ""))
            tag = re.sub(r"-(amd64|arm64)$", "", tag)
            if is_version(tag):
                return normalize_version(tag)
        except (UpgradeError, ValueError, OSError):
            pass
    status = status if status is not None else bootc_status(host, timeout)
    ref, _ = deployment_image(_deployment(status, "booted"))
    version = version_from_ref(ref)
    if version:
        return version
    raise UpgradeError("cannot tell which k4all release this node runs; pass "
                       "--from vX.Y.Z")


def node_role(host):
    if not host.exists(NODE_TYPE_FILE):
        raise UpgradeError("%s is missing" % NODE_TYPE_FILE)
    role = host.read(NODE_TYPE_FILE).strip()
    if role not in ("bootstrap", "control", "worker"):
        raise UpgradeError("unknown node type %r in %s" % (role, NODE_TYPE_FILE))
    return role


def kubelet_version(host):
    out = host.run(["kubelet", "--version"]).stdout
    match = re.search(r"v(\d+\.\d+\.\d+)", out)
    if not match:
        raise UpgradeError("cannot parse kubelet version from %r" % out)
    return match.group(1)


def kubeconfig_for(host, role):
    if role in ("bootstrap", "control") and host.exists(ADMIN_KUBECONFIG):
        return ADMIN_KUBECONFIG
    if host.exists(KUBELET_KUBECONFIG):
        return KUBELET_KUBECONFIG
    return None


_CN_OID = b"\x06\x03\x55\x04\x03"            # id-at-commonName
_DER_STRINGS = {0x0c: "utf-8", 0x13: "ascii", 0x14: "latin-1", 0x16: "ascii",
                0x1e: "utf-16-be"}
_PEM_CERT_RE = re.compile(r"-----BEGIN CERTIFICATE-----(.*?)"
                          r"-----END CERTIFICATE-----", re.S)
_HOSTNAME_OVERRIDE_RE = re.compile(r"--hostname-override(?:=|\s+)[\"']?"
                                   r"([^\s\"']+)")
NODE_CN_PREFIX = "system:node:"


def certificate_common_names(der):
    """Every commonName in a DER certificate, issuer's and subject's.

    A scan for the attribute OID is enough here: the kubelet's client
    certificate has the CA ("kubernetes") as issuer CN and
    ``system:node:<name>`` as subject CN.
    """
    names, start = [], 0
    while True:
        i = der.find(_CN_OID, start)
        if i < 0:
            return names
        j = start = i + len(_CN_OID)
        if j + 2 > len(der) or der[j] not in _DER_STRINGS:
            continue
        length, k = der[j + 1], j + 2
        if length & 0x80:
            count = length & 0x7f
            if count not in (1, 2) or k + count > len(der):
                continue
            length = int.from_bytes(der[k:k + count], "big")
            k += count
        value = der[k:k + length]
        if len(value) != length:
            continue
        try:
            names.append(value.decode(_DER_STRINGS[der[j]]))
        except UnicodeDecodeError:
            continue


def pem_certificates(text):
    """The DER bytes of every certificate in a PEM text."""
    out = []
    for body in _PEM_CERT_RE.findall(text or ""):
        try:
            out.append(base64.b64decode("".join(body.split()), validate=True))
        except ValueError:
            continue
    return out


def _kubelet_client_pems(host):
    """PEM texts of the client certificates kubelet.conf points at."""
    if not host.exists(KUBELET_KUBECONFIG):
        return []
    try:
        cfg = load_yaml_file(host, KUBELET_KUBECONFIG)
    except Exception:  # pylint: disable=broad-except
        return []
    if not isinstance(cfg, dict):
        return []
    texts = []
    for entry in cfg.get("users") or []:
        user = (entry or {}).get("user") or {}
        data = user.get("client-certificate-data")
        if data:
            try:
                texts.append(base64.b64decode(data).decode("ascii", "replace"))
            except ValueError:
                pass
        path = user.get("client-certificate")
        if path:
            if not path.startswith("/"):
                path = os.path.join(os.path.dirname(KUBELET_KUBECONFIG), path)
            try:
                if host.exists(path):
                    texts.append(host.read(path))
            except (OSError, UnicodeDecodeError):
                pass
    return texts


def kubelet_node_name(host):
    """The name of this node's Node object: the kubelet's own identity.

    1. the CN ``system:node:<name>`` of the kubelet client certificate in
       kubelet.conf (the name NodeRestriction lets the kubelet patch);
    2. ``--hostname-override`` in the kubelet flags;
    3. the hostname, lowercased as kubeadm registers it.
    """
    for text in _kubelet_client_pems(host):
        for der in pem_certificates(text):
            for name in certificate_common_names(der):
                if name.startswith(NODE_CN_PREFIX) and name != NODE_CN_PREFIX:
                    return name[len(NODE_CN_PREFIX):]
    for path in KUBELET_FLAG_FILES:
        try:
            text = host.read(path) if host.exists(path) else ""
        except (OSError, UnicodeDecodeError):
            text = ""
        match = _HOSTNAME_OVERRIDE_RE.search(text)
        if match:
            return match.group(1).strip().lower()
    return host.hostname()


def kubectl(host, kubeconfig, args, check=True, input_text=None):
    return host.run(["kubectl", "--kubeconfig", host.path(kubeconfig)] + args,
                    check=check, input_text=input_text)


def kubectl_json(host, kubeconfig, args):
    return json.loads(kubectl(host, kubeconfig, args + ["-o", "json"]).stdout)


def server_version(host, kubeconfig):
    out = kubectl(host, kubeconfig, ["version", "-o", "json"]).stdout
    git = (json.loads(out).get("serverVersion") or {}).get("gitVersion", "")
    return git.lstrip("v")


def node_ready(node):
    for cond in (node.get("status") or {}).get("conditions") or []:
        if cond.get("type") == "Ready":
            return cond.get("status") == "True"
    return False


K4ALL_BOOTSTRAP_PREFIX = "kube-bootstrap-"     # set-hostname.sh


def find_bootstrap_node(nodes, me):
    """The bootstrap node's Node among ``nodes``, other than ``me``: the one
    whose node-type annotation says so (published from v2.2.4), else the one
    named as k4all names a bootstrap node. None when there is no single one."""
    others = [n for n in nodes or []
              if (n.get("metadata") or {}).get("name") != me]
    for match in (
            lambda n: ((n.get("metadata") or {}).get("annotations") or {}).get(
                ANNOTATION_NODE_TYPE) == "bootstrap",
            lambda n: str((n.get("metadata") or {}).get("name", "")).startswith(
                K4ALL_BOOTSTRAP_PREFIX)):
        found = [n for n in others if match(n)]
        if len(found) == 1:
            return found[0]
        if found:
            return None
    return None


def bootstrap_behind(nodes, me, hop):
    """Why a control plane may not start ``hop`` yet, or None.

    The bootstrap node goes first. Its Node tells how far it is: the release
    annotation once a v2.2.4 or newer k4all-upgrade has written it (the last
    committed hop), otherwise only the kubelet version, which shows the hops
    that change Kubernetes. A hop that changes neither cannot be checked
    before the bootstrap node publishes its release."""
    boot = find_bootstrap_node(nodes, me)
    if boot is None:
        return None
    name = boot["metadata"]["name"]
    release = ((boot["metadata"].get("annotations") or {}).get(
        ANNOTATION_RELEASE) or "").strip()
    if is_version(release):
        if parse_version(release) < parse_version(hop["to"]):
            return ("the bootstrap node %s runs %s: run the hop to %s there "
                    "first (its release annotation changes when the hop is "
                    "committed)" % (name, normalize_version(release), hop["to"]))
        return None
    kubelet = ((boot.get("status") or {}).get("nodeInfo") or {}).get(
        "kubeletVersion", "")
    try:
        if k8s_key(kubelet) < k8s_key(hop["kubernetes"]):
            return ("the bootstrap node %s runs kubelet %s, the hop to %s "
                    "brings %s: run it there first"
                    % (name, kubelet, hop["to"], hop["kubernetes"]))
    except ValueError:
        pass
    return None


# One failed check in the /readyz body. kubectl quotes the body in its error
# message, so the checks are separated by a literal "\n" there.
READYZ_FAILED_CHECK = re.compile(r"\[-\]([^\s\"\\]+) failed")


def readyz_problem(proc):
    """None when ``kubectl get --raw /readyz`` answered ok, else why not, in
    one short line: the failed checks when the apiserver lists them,
    otherwise the end of what kubectl printed."""
    if proc.returncode == 0 and (proc.stdout or "").strip() == "ok":
        return None
    text = " ".join(" ".join(t for t in (proc.stdout, proc.stderr) if t).split())
    failed = list(dict.fromkeys(READYZ_FAILED_CHECK.findall(text)))
    if failed:
        return "failed checks: %s" % ", ".join(failed)
    if not text:
        return "no answer (rc=%d)" % proc.returncode
    return text if len(text) <= 300 else "..." + text[-297:]


# A static pod's mirror: a drain leaves it alone.
MIRROR_ANNOTATION = "kubernetes.io/config.mirror"
# The labels of a CloudNativePG instance pod.
CNPG_CLUSTER_LABEL = "cnpg.io/cluster"
CNPG_ROLE_LABEL = "cnpg.io/instanceRole"
DRAIN_DOCS = "docs/upgrades.md, Drains that never end"
BARE_PODS_DOCS = "docs/upgrades.md, Pods that declare no controller"


def selector_matches(selector, labels):
    """Whether a LabelSelector selects ``labels``. As for a policy/v1
    PodDisruptionBudget, an empty selector selects every pod and a missing
    one none; an operator it does not know selects nothing."""
    if selector is None:
        return False
    labels = labels or {}
    for key, value in (selector.get("matchLabels") or {}).items():
        if labels.get(key) != value:
            return False
    for expr in selector.get("matchExpressions") or []:
        key, op = expr.get("key"), expr.get("operator")
        values = expr.get("values") or []
        if op == "In":
            ok = key in labels and labels[key] in values
        elif op == "NotIn":
            ok = key not in labels or labels[key] not in values
        elif op == "Exists":
            ok = key in labels
        elif op == "DoesNotExist":
            ok = key not in labels
        else:
            return False
        if not ok:
            return False
    return True


def evicted_under_budget(pod):
    """Whether a drain evicts ``pod`` and its PodDisruptionBudget decides:
    a running pod, not a DaemonSet's, not a static pod's mirror, not
    terminating. The eviction API lets pending and finished pods go
    whatever their budget says."""
    meta = pod.get("metadata") or {}
    if meta.get("deletionTimestamp") \
            or (pod.get("status") or {}).get("phase") != "Running" \
            or MIRROR_ANNOTATION in (meta.get("annotations") or {}):
        return False
    return not any(o.get("kind") == "DaemonSet"
                   for o in meta.get("ownerReferences") or [])


def budget_never_allows(pdb):
    """Whether a PodDisruptionBudget allows no disruption although every pod
    it expects is healthy: waiting changes nothing (the primary of a
    single-instance CloudNativePG cluster, minAvailable 1 of 1). A budget
    short of healthy pods is not one: its pods are starting, and the drain
    retries its evictions until its timeout. Nor is one the disruption
    controller has not seen yet."""
    meta, status = pdb.get("metadata") or {}, pdb.get("status") or {}
    if int(status.get("observedGeneration") or 0) < int(meta.get("generation") or 0):
        return False
    return int(status.get("disruptionsAllowed") or 0) == 0 and \
        int(status.get("currentHealthy") or 0) >= int(status.get("expectedPods") or 0)


def pod_ready(pod):
    return any(c.get("type") == "Ready" and c.get("status") == "True"
               for c in (pod.get("status") or {}).get("conditions") or [])


def cnpg_primary(pod):
    """The CloudNativePG cluster whose primary ``pod`` is, else None."""
    labels = (pod.get("metadata") or {}).get("labels") or {}
    if labels.get(CNPG_ROLE_LABEL) == "primary":
        return labels.get(CNPG_CLUSTER_LABEL)
    return None


def cnpg_switches_over(pod, replicas):
    """Whether CloudNativePG moves the primary ``pod`` off its node by
    itself: when that node is cordoned it switches over to a replica of the
    cluster, here one ready on another node (CNPG docs, Kubernetes upgrade).
    Its primary budget allows no disruption, and still the drain ends."""
    cluster = cnpg_primary(pod)
    if not cluster:
        return False
    meta = pod.get("metadata") or {}
    for other in replicas:
        other_meta = other.get("metadata") or {}
        labels = other_meta.get("labels") or {}
        if other_meta.get("namespace") == meta.get("namespace") \
                and labels.get(CNPG_CLUSTER_LABEL) == cluster \
                and labels.get(CNPG_ROLE_LABEL) == "replica" \
                and (other.get("spec") or {}).get("nodeName") \
                not in (None, (pod.get("spec") or {}).get("nodeName")) \
                and not other_meta.get("deletionTimestamp") \
                and (other.get("status") or {}).get("phase") == "Running" \
                and pod_ready(other):
            return True
    return False


def drain_blockers(pdbs, pods, replicas=()):
    """[(budget, pod)], each namespace/name, sorted: the pods among ``pods``
    (the ones of the node to drain) whose eviction a budget always refuses,
    so the drain of that node would never end. ``replicas``: the
    CloudNativePG replicas of the cluster, for cnpg_switches_over."""
    blockers = []
    for pdb in pdbs:
        if not budget_never_allows(pdb):
            continue
        meta = pdb.get("metadata") or {}
        namespace = meta.get("namespace")
        selector = (pdb.get("spec") or {}).get("selector")
        for pod in pods:
            pod_meta = pod.get("metadata") or {}
            if pod_meta.get("namespace") == namespace \
                    and evicted_under_budget(pod) \
                    and selector_matches(selector, pod_meta.get("labels")) \
                    and not cnpg_switches_over(pod, replicas):
                blockers.append(("%s/%s" % (namespace, meta.get("name")),
                                 "%s/%s" % (namespace, pod_meta.get("name"))))
    return sorted(blockers)


def drain_blocked_message(node, blockers):
    """The HOLD of a hop whose drain would never end."""
    named = ["PDB %s allows no disruption of pod %s" % b for b in blockers[:3]]
    if len(blockers) > 3:
        named.append("and %d more" % (len(blockers) - 3))
    return ("the drain of %s would never end: %s, and all its pods are "
            "healthy, so waiting does not help. Nothing was changed. For a "
            "single-instance CloudNativePG cluster, allow its disruption for "
            "the hop (enablePDB: false or nodeMaintenanceWindow; see %s), or "
            "move the pod to another node" % (node, "; ".join(named), DRAIN_DOCS))


def _whole_seconds(text):
    try:
        return int(str(text))
    except ValueError:
        return None


def pod_stop_plan(sandboxes, containers, most):
    """How long each ready pod may take to stop right before the reboot:
    [(seconds, pod id, namespace/name, grace)], the longest first.

    ``sandboxes`` and ``containers`` are what `crictl pods -o json` and
    `crictl ps -o json` list. A pod's grace is the largest grace period
    kubelet annotated on its running containers, None when none says. A pod
    gets its grace, at least POD_STOP_SECONDS and at most ``most``; with
    ``containers`` None (they could not be listed) every pod gets ``most``."""
    graces = {}
    for ctr in containers or []:
        grace = _whole_seconds((ctr.get("annotations") or {})
                               .get(GRACE_ANNOTATION, ""))
        pod = ctr.get("podSandboxId")
        if grace is not None and grace > graces.get(pod, -1):
            graces[pod] = grace
    plan = []
    for box in sandboxes:
        meta = box.get("metadata") or {}
        grace = graces.get(box.get("id"))
        if containers is None:
            seconds = most
        else:
            seconds = min(max(grace or 0, POD_STOP_SECONDS), most)
        plan.append((seconds, box.get("id"), "%s/%s" % (meta.get("namespace"),
                                                         meta.get("name")),
                     grace))
    return sorted(plan, key=lambda p: (-p[0], p[2]))


def long_grace_pods(pods, most):
    """[(namespace/name, grace)] of ``pods`` that have not finished and whose
    terminationGracePeriodSeconds is above ``most``, sorted."""
    out = []
    for pod in pods:
        meta = pod.get("metadata") or {}
        if (pod.get("status") or {}).get("phase") in ("Succeeded", "Failed"):
            continue
        grace = (pod.get("spec") or {}).get("terminationGracePeriodSeconds")
        if isinstance(grace, int) and grace > most:
            out.append(("%s/%s" % (meta.get("namespace"), meta.get("name")),
                        grace))
    return sorted(out)


# The hop warning of a single node whose reboot cuts some pods short.
GRACE_WARNING_PREFIX = "a single node is not drained, and the reboot gives"


def long_grace_warning(most, pods):
    named = ["%s asks %d s" % p for p in pods[:3]]
    if len(pods) > 3:
        named.append("and %d more" % (len(pods) - 3))
    return ("%s each pod at most %d s to stop (podStopMaxSeconds): %s. Stop "
            "them before the hop (`virtctl stop` for a VM, `virtctl start` "
            "after it), or raise podStopMaxSeconds in %s"
            % (GRACE_WARNING_PREFIX, most, ", ".join(named), CONFIG_FILE))


# Where a hop keeps what it warns about (#119). Each writer has its own
# field, so the commit keeps what is still true after the hop and drops
# the advice for before it:
# - preflightWarning: PREFLIGHT's advice (the pods a single node's reboot
#   cuts short), shown during the hop only;
# - kubeVipWarning: a kube-vip.yaml POST_BOOT left as it is; still true
#   after the hop, so kept in the history;
# - syncWarnings: what the SYNC could not do (an uninstall the operator
#   refuses), a list; kept in the history.
# "warning" is where a release before v2.7.2 put all three; a hop that
# started there carries its PREFLIGHT advice in it. It is shown during
# the hop and never kept. The history entry keeps "warning" (one string)
# for the readers of state.json.
def hop_warnings(hop):
    """What the hop warns about while it runs, in the order it was found."""
    hop = hop or {}
    out = []
    for text in [hop.get("preflightWarning"), hop.get("warning"),
                 hop.get("kubeVipWarning")] + list(hop.get("syncWarnings") or []):
        if text and text not in out:
            out.append(text)
    return out


def history_warning(hop):
    """The warning a committed hop keeps in the history: what the new
    release found and is still true (kube-vip, the sync's refusals), never
    the preflight's advice. None when there is none."""
    hop = hop or {}
    out = []
    for text in [hop.get("kubeVipWarning")] + list(hop.get("syncWarnings") or []):
        if text and text not in out:
            out.append(text)
    return "; ".join(out) or None


def declares_no_controller(pod):
    """Whether ``pod`` makes `kubectl drain` without --force refuse the
    drain (kubectl's unreplicatedFilter): no ownerReference is its
    controller, so nothing recreates it once evicted. A finished pod (the
    drain deletes it), a static pod's mirror and a pod already terminating
    do not count."""
    meta = pod.get("metadata") or {}
    if meta.get("deletionTimestamp") \
            or (pod.get("status") or {}).get("phase") in ("Succeeded", "Failed") \
            or MIRROR_ANNOTATION in (meta.get("annotations") or {}):
        return False
    return not any(o.get("controller") for o in meta.get("ownerReferences") or [])


def bare_pods(pods):
    """namespace/name of the pods among ``pods`` that declare no controller,
    sorted."""
    return sorted("%s/%s" % ((p.get("metadata") or {}).get("namespace"),
                             (p.get("metadata") or {}).get("name"))
                  for p in pods if declares_no_controller(p))


def _some(names):
    shown = ", ".join(names[:3])
    return shown if len(names) <= 3 else "%s and %d more" % (shown, len(names) - 3)


def bare_pods_message(node, names):
    """The HOLD of a hop whose drain would refuse pods without a controller."""
    return ("the drain of %s would refuse the pods that declare no controller: "
            "%s. Nothing recreates such a pod once it is gone, and `kubectl "
            "drain` deletes it only with --force. Nothing was changed. Delete "
            "them, or recreate them under a controller (a Deployment, a Job), "
            "see %s" % (node, _some(names), BARE_PODS_DOCS))


def bare_pods_note(node, names):
    """What a node that waits for its drain says about its bare pods."""
    return ("Node %s runs pods that declare no controller: %s. Its drain "
            "refuses them, and with --force deletes them for good: delete them "
            "or recreate them under a controller first (see %s)."
            % (node, _some(names), BARE_PODS_DOCS))


def cluster_kubernetes_version(host, kubeconfig):
    cm = kubectl_json(host, kubeconfig,
                      ["-n", "kube-system", "get", "configmap", "kubeadm-config"])
    cfg = load_yaml_text(host, cm.get("data", {}).get("ClusterConfiguration", ""))
    return str((cfg or {}).get("kubernetesVersion", "")).lstrip("v")


# =========================================================================
# State
# =========================================================================
def state_path():
    return STATE_DIR + "/state.json"


def load_state(host):
    if not host.exists(state_path()):
        return None
    return json.loads(host.read(state_path()))


def save_state(host, state):
    state["updatedAt"] = host.now().isoformat(timespec="seconds")
    host.write(state_path(), json.dumps(state, indent=2, sort_keys=True) + "\n")


def new_state(target, mode, path, current, image, previous=None):
    """A new plan. The history of the previous state goes on in it."""
    return {
        "schema": 1,
        "agent": {"version": TOOL_VERSION, "capabilities": CAPABILITIES},
        "mode": mode,
        "target": path[-1].version if path else target,
        "current": current,
        "pending": [r.to_dict() for r in path],
        "image": image,
        "hop": None,
        "phase": "IDLE",
        "rollbacks": 0,
        "hold": None,
        "history": list((previous or {}).get("history") or []),
    }


def start_next_hop(state):
    rel = state["pending"].pop(0)
    state["hop"] = {
        "from": state["current"],
        "to": rel["version"],
        "kind": hop_kind(state["current"], rel["version"]),
        "kubernetes": rel["kubernetes"],
        "syncManifest": bool(rel.get("syncManifest")),
        "image": Release(rel).image_ref(state["image"]),
        "drained": False,
        "startedAt": None,
    }
    state["phase"] = "PREFLIGHT"
    state["rollbacks"] = 0


def put_on_hold(host, state, reason, code=None):
    state["hold"] = {"reason": reason, "phase": state.get("phase"),
                     "at": host.now().isoformat(timespec="seconds")}
    if code:
        state["hold"]["code"] = code
    save_state(host, state)
    host.log("HOLD: %s" % reason)
    host.log("Fix the cause, then run: k4all-upgrade clear-hold && "
             "k4all-upgrade resume")


# =========================================================================
# Node annotations (ClusterUpgrade protocol)
# =========================================================================
def operator_driven(state):
    """True for a plan the k4all-operator asked for with upgrade-target."""
    return bool(state) and state.get("mode") == "operator"


def _active(state):
    return state and state.get("phase") not in (None, "DONE") and \
        (state.get("hop") or state.get("pending"))


def short_message(text):
    """One line, bounded: annotation values end up in tables and UIs."""
    text = " ".join(str(text or "").split())
    if len(text) > MESSAGE_MAX:
        text = text[:MESSAGE_MAX - 3] + "..."
    return text


def sync_left_behind(state, booted, role):
    """The release whose manifest sync an abandoned hop leaves undone: a hop
    to a sync release, past its reboot (REBOOT or SYNC), on the bootstrap
    node that boots that release. None otherwise. The next plan starts from
    the release the node boots, so nothing else would sync it. ``booted``
    None: bootc could not say; SYNC comes only after post_boot saw the new
    release boot."""
    hop = (state or {}).get("hop") or {}
    if not hop.get("syncManifest") or role != "bootstrap" \
            or state.get("phase") not in ("REBOOT", "SYNC"):
        return None
    if booted is None:
        return hop["to"] if state["phase"] == "SYNC" else None
    if parse_version(booted) != parse_version(hop["to"]):
        return None
    return hop["to"]


def sync_pending_message(pending):
    return ("the ReleaseManifest of %s is not synced: its hop was abandoned "
            "after the reboot. Run `sudo k4all-upgrade sync-manifest` on this "
            "node, or `k4all-upgrade clear-hold --sync-done` once it was "
            "synced otherwise" % pending["release"])


def refuse_while_sync_pending(state):
    """No new hop while a sync is pending: it would start from a release
    whose manifest the cluster does not run."""
    pending = (state or {}).get("syncPending")
    if pending:
        raise UpgradeError(sync_pending_message(pending))


def abandoned_message(abandoned):
    text = "hop %s->%s abandoned with `k4all-upgrade clear-hold --abandon`" % (
        abandoned.get("from") or "?", abandoned.get("target") or "?")
    if abandoned.get("reason"):
        text += "; it was on hold: %s" % abandoned["reason"]
    return short_message(text)


def node_report(state, role=None, release=None, problem=None, target=None,
                x86_64_level=None):
    """The annotations k4all-upgrade owns on its Node for ``state``.

    None removes an annotation. ``release`` defaults to the last committed
    release; ``problem`` is an upgrade-target the agent refused; ``target``
    is the upgrade-target on the Node now (None when absent);
    ``x86_64_level`` is node_x86_64_level's answer (the agent's only: None
    leaves the annotation alone, "" removes it).
    """
    state = state or {}
    want = {ANNOTATION_PHASE: None, ANNOTATION_MESSAGE: None,
            ANNOTATION_REASON: None}
    release = release or state.get("current")
    if release:
        want[ANNOTATION_RELEASE] = release
    if role:
        want[ANNOTATION_NODE_TYPE] = role
    if x86_64_level is not None:
        want[ANNOTATION_X86_64_LEVEL] = x86_64_level or None
    if _active(state) and state.get("hold"):
        want[ANNOTATION_PHASE] = PHASE_HOLD
        want[ANNOTATION_MESSAGE] = short_message(state["hold"].get("reason"))
        want[ANNOTATION_REASON] = state["hold"].get("code")
    elif state.get("hop"):
        want[ANNOTATION_PHASE] = state["phase"]
        if state.get("waiting"):
            # why the hop has not started (NotYet): no HOLD; the operator
            # (v0.5.0) reads upgrade-message only next to HOLD
            want[ANNOTATION_MESSAGE] = short_message("waiting: %s"
                                                     % state["waiting"])
        elif hop_warnings(state["hop"]):
            # something to fix that does not stop the hop (a kube-vip.yaml
            # that cannot be read); gone with the hop
            want[ANNOTATION_MESSAGE] = short_message(
                "; ".join(hop_warnings(state["hop"])))
    elif problem:
        want[ANNOTATION_PHASE] = PHASE_HOLD
        want[ANNOTATION_MESSAGE] = short_message(problem)
        want[ANNOTATION_REASON] = REASON_TARGET_REJECTED
    elif state.get("abandoned"):
        want[ANNOTATION_PHASE] = PHASE_ABANDONED
        want[ANNOTATION_MESSAGE] = abandoned_message(state["abandoned"])
    if state.get("syncPending") and not state.get("hop") and not problem:
        # next to ABANDONED, or alone after a plan of the node
        pending = sync_pending_message(state["syncPending"])
        want[ANNOTATION_MESSAGE] = short_message(
            pending if not want[ANNOTATION_MESSAGE]
            else "%s; %s" % (pending, want[ANNOTATION_MESSAGE]))
    # upgrade-done answers the upgrade-target on the Node: it names the
    # target once the node has committed it (in the same patch as release),
    # and goes away with the target. A different target leaves it alone.
    if target is None or not str(target).strip():
        want[ANNOTATION_DONE] = None
    elif release and not state.get("hop") and same_target(target, release):
        # a release whose manifest sync is missing is not done
        want[ANNOTATION_DONE] = None if state.get("syncPending") else release
    return want


def annotation_changes(observed, want):
    """The part of ``want`` that differs from the Node's annotations."""
    observed = observed or {}
    changes = {}
    for key, value in want.items():
        if value is None:
            if key in observed:
                changes[key] = None
        elif observed.get(key) != value:
            changes[key] = value
    return changes


def same_target(a, b):
    try:
        return parse_target(a) == parse_target(b)
    except ValueError:
        return str(a or "").strip() == str(b or "").strip()


def parse_target(value):
    """A normalized release from the upgrade-target annotation.
    Raises ValueError when it is not a release version."""
    text = str(value or "").strip()
    if not is_version(text):
        raise ValueError("upgrade-target %r is not a release version" % text)
    return normalize_version(text)


def check_single_hop(releases, current, target):
    """The release of the hop ``current -> target``, when it is one legal
    hop under the rules of plan_path (minFrom, no skipped minor, no blocked
    release, a stream finished before the next one). Raises NoPathError
    with the reason otherwise."""
    errors = validate_graph(releases)
    if errors:
        raise NoPathError("the upgrade graph is invalid: %s" % "; ".join(errors))
    if parse_version(target) < parse_version(current):
        raise NoPathError("upgrade-target %s is older than %s, the release "
                          "this node runs: k4all never downgrades"
                          % (target, current))
    path = plan_path(releases, current, target)
    if len(path) != 1 or path[0].key != parse_version(target):
        raise NoPathError("%s -> %s is not one hop: the path is %s"
                          % (current, target, " -> ".join(
                              [current] + [r.version for r in path])))
    return path[0]


def next_release(state):
    """The release of the open plan's next hop: the hop that waits, else
    the first pending one."""
    return (state.get("hop") or {}).get("to") or state["pending"][0]["version"]


def stale_hop(releases, state):
    """Why the next hop of the open plan in ``state`` is no longer one
    legal hop on the upgrade graph ``releases``; None while it is. A
    release the graph does not list is not judged: offline the graph is
    the image's, which ends at the release the image was built from."""
    current, nxt = state["current"], next_release(state)
    listed = [r for r in releases if r.key == parse_version(nxt)]
    if not listed:
        return None
    if listed[0].blocked:
        return "%s is blocked" % nxt
    try:
        check_single_hop(releases, current, nxt)
    except NoPathError as exc:
        return str(exc)
    return None


def replan(releases, state, allow):
    """The hops from the committed release of ``state`` toward its target
    on the upgrade graph ``releases``. A plan of the timer goes toward the
    latest release when its target cannot be reached any more, and keeps
    the hops ``allow`` lets it run. NoPathError when no path is left."""
    errors = validate_graph(releases)
    if errors:
        raise NoPathError("the upgrade graph is invalid: %s" % "; ".join(errors))
    current = state["current"]
    if state.get("mode") != "auto":
        return plan_path(releases, current, state.get("target"))
    try:
        path = plan_path(releases, current, state.get("target"))
    except NoPathError:
        path = plan_path(releases, current)
    return auto_allowed(path, current, allow)


# =========================================================================
# kube-vip's static pod
# =========================================================================
# What every k4all control plane runs: the API VIP (cp_enable) and the
# LoadBalancer Services of class kube-vip.io/kube-vip-class (svc_enable with
# lb_class_only). MetalLB ignores Services with a class that is not its own,
# so each address has one announcer. Without svc_election one node, the
# leader of plndr-svcs-lock, announces every Service.
def kube_vip_env(address, interface):
    return [
        {"name": "vip_arp", "value": "true"},
        {"name": "port", "value": "6443"},
        {"name": "vip_nodename",
         "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
        {"name": "vip_interface", "value": interface},
        {"name": "vip_subnet", "value": "32"},
        {"name": "dns_mode", "value": "first"},
        {"name": "cp_enable", "value": "true"},
        {"name": "cp_namespace", "value": "kube-system"},
        {"name": "svc_enable", "value": "true"},
        {"name": "lb_class_only", "value": "true"},
        {"name": "svc_leasename", "value": "plndr-svcs-lock"},
        {"name": "vip_leaderelection", "value": "true"},
        {"name": "vip_leasename", "value": "plndr-cp-lock"},
        {"name": "vip_leaseduration", "value": "15"},
        {"name": "vip_renewdeadline", "value": "10"},
        {"name": "vip_retryperiod", "value": "2"},
        {"name": "address", "value": address},
        {"name": "prometheus_server", "value": ":2112"},
    ]


# Settings an existing manifest gets in any case.
KUBE_VIP_REQUIRED_ENV = ("cp_enable", "svc_enable", "lb_class_only")


def kube_vip_pod(address, interface, version, kubeconfig):
    """The static pod setup-k8s-ph3.sh writes, for one control plane."""
    return {
        "apiVersion": "v1", "kind": "Pod",
        "metadata": {"name": "kube-vip", "namespace": "kube-system"},
        "spec": {
            "containers": [{
                "name": "kube-vip",
                "image": "%s:%s" % (KUBE_VIP_IMAGE, version),
                "imagePullPolicy": "IfNotPresent",
                "args": ["manager"],
                "env": kube_vip_env(address, interface),
                "resources": {},
                "securityContext": {"capabilities": {
                    "add": ["NET_ADMIN", "NET_RAW"], "drop": ["ALL"]}},
                "volumeMounts": [{"mountPath": "/etc/kubernetes/admin.conf",
                                  "name": "kubeconfig"}],
            }],
            "hostAliases": [{"hostnames": ["kubernetes"], "ip": "127.0.0.1"}],
            "hostNetwork": True,
            "volumes": [{"name": "kubeconfig",
                         "hostPath": {"path": kubeconfig}}],
        },
    }


def _kube_vip_container(pod):
    for ctr in ((pod or {}).get("spec") or {}).get("containers") or []:
        if isinstance(ctr, dict) and (ctr.get("name") == "kube-vip"
                                      or "kube-vip" in str(ctr.get("image", ""))):
            return ctr
    return None


def is_k4all_kube_vip(pod):
    """A kube-vip pod with its settings, as setup-k8s-ph3.sh writes it. The
    operator's static-pod type wrote the image alone (no manager)."""
    ctr = _kube_vip_container(pod)
    return bool(ctr) and "manager" in (ctr.get("args") or []) \
        and bool(ctr.get("env"))


def kube_vip_env_value(pod, name):
    for item in (_kube_vip_container(pod) or {}).get("env") or []:
        if item.get("name") == name:
            return item.get("value")
    return None


def want_tag(pod):
    image = str((_kube_vip_container(pod) or {}).get("image", ""))
    return image.rsplit(":", 1)[1] if ":" in image.rsplit("/", 1)[-1] else ""


def desired_kube_vip(existing, ha, interface, version, kubeconfig):
    """kube-vip's static pod for this node, from what it has now.

    A k4all manifest keeps what it says, but gets cp_enable, svc_enable and
    lb_class_only, the pinned version unless it already runs a newer one,
    the kubeconfig of its role and, when the interface is auto, today's
    interface. Anything else (none, the operator's Pod with the image alone)
    is replaced by the full manifest."""
    version = version or want_tag(existing) or "v1.3.1"
    address = str(ha.get("apiControlEndpoint") or "")
    if not is_k4all_kube_vip(existing):
        return kube_vip_pod(address, interface, version, kubeconfig)
    pod = json.loads(json.dumps(existing))
    ctr = _kube_vip_container(pod)
    env = ctr.setdefault("env", [])
    names = [e.get("name") for e in env]
    for name in KUBE_VIP_REQUIRED_ENV:
        if name in names:
            env[names.index(name)] = {"name": name, "value": "true"}
        else:
            # after svc_enable, as setup-k8s-ph3.sh writes it
            at = names.index("svc_enable") + 1 if "svc_enable" in names else len(env)
            env.insert(at, {"name": name, "value": "true"})
            names.insert(at, name)
    if str(ha.get("interface") or "auto") == "auto" and interface \
            and "vip_interface" in names:
        env[names.index("vip_interface")] = {"name": "vip_interface",
                                             "value": interface}
    current = want_tag(existing)
    if not (is_version(current) and is_version(version)
            and parse_version(current) > parse_version(version)):
        ctr["image"] = "%s:%s" % (KUBE_VIP_IMAGE, version)
    for vol in (pod.get("spec") or {}).get("volumes") or []:
        if vol.get("name") == "kubeconfig" and "hostPath" in vol:
            vol["hostPath"]["path"] = kubeconfig
    return pod


# =========================================================================
# Node settings (ClusterConfig spec.nodes, k4all#60)
# =========================================================================
# The k4all-operator writes the kubelet fields it owns into
# kube-system/kubelet-config and the whole node-level state (hash,
# hugepages, iommu) into its NODE_SETTINGS_ANNOTATION; it drains the node
# when the change needs it and writes node-settings-target. The agent
# pulls the kubelet config, resets the CPU manager state when its policy or
# reserved CPUs change, sets the kernel arguments k4all owns, restarts
# kubelet or reboots, and answers node-settings-applied once kubelet is
# Ready. node-settings-message says why it waits ("waiting: ...") or
# refuses (anything else: the operator shows the rollout Blocked).

# Page sizes of spec.nodes.hugepages and their kernel names, in the order
# their kernel arguments are written.
HUGEPAGE_SIZES = (("1Gi", "1G"), ("2Mi", "2M"))
HUGEPAGE_KEYS = ("hugepagesz", "hugepages", "default_hugepagesz")
IOMMU_VENDOR_KARGS = {"GenuineIntel": "intel_iommu=on",
                      "AuthenticAMD": "amd_iommu=on"}
IOMMU_KEYS = ("intel_iommu", "amd_iommu", "iommu")
NODE_SETTINGS_KARG_KEYS = HUGEPAGE_KEYS + IOMMU_KEYS
# How long one pass waits for kubelet to be Ready after a restart; the next
# pass looks again, without restarting it again.
NODE_SETTINGS_READY_SECONDS = 180
NODE_SETTINGS_CONFIG_BACKUP = STATE_DIR + "/node-settings-kubelet-config.yaml"
WAITING = "waiting: "


def karg_key(arg):
    return arg.split("=", 1)[0]


def desired_kargs(settings, vendor):
    """(kargs, None): the kernel arguments k4all wants for the node settings
    of the kubelet-config annotation, in order; (None, why) when it cannot
    tell them. ``vendor`` is /proc/cpuinfo's vendor_id."""
    pages = settings.get("hugepages") or {}
    known = [size for size, _ in HUGEPAGE_SIZES]
    unknown = sorted(set(pages) - set(known))
    if unknown:
        return None, ("hugepages: page size %s is not one of %s"
                      % (", ".join(unknown), ", ".join(known)))
    out = []
    for size, kernel in HUGEPAGE_SIZES:
        try:
            count = int(pages.get(size) or 0)
        except (TypeError, ValueError):
            return None, ("hugepages %s: %r is not a number of pages"
                          % (size, pages.get(size)))
        if count > 0:
            out += ["hugepagesz=" + kernel, "hugepages=%d" % count]
    if settings.get("iommu"):
        arg = IOMMU_VENDOR_KARGS.get(vendor)
        if not arg:
            return None, ("iommu: unknown CPU vendor %r (k4all knows %s): set "
                          "the IOMMU kernel arguments by hand and leave "
                          "spec.nodes.iommu unset"
                          % (vendor, " and ".join(sorted(IOMMU_VENDOR_KARGS))))
        out += [arg, "iommu=pt"]
    return out, None


def _split_owned(args, owned):
    """args, in order, split into the ones the multiset ``owned`` covers and
    the others."""
    left = collections.Counter(owned)
    ours, others = [], []
    for arg in args:
        if left[arg] > 0:
            left[arg] -= 1
            ours.append(arg)
        else:
            others.append(arg)
    return ours, others


def karg_plan(current, recorded, desired):
    """How to bring ``current``, the kernel arguments of the next boot
    (`rpm-ostree kargs`), to ``desired``, touching only the ones k4all
    added (``recorded``). A dict:

    - delete, append, append_if_missing: the arguments of one
      `rpm-ostree kargs` call (--delete, --append, --append-if-missing);
    - final: ``current`` after that call; record: what k4all has added then;
    - problem: why nothing may change (arguments set by hand in the way).

    rpm-ostree applies --delete first and --append next, then
    --append-if-missing and last --delete-if-present (against the arguments
    before the call). Hugepages are pairs whose order matters, and both
    sizes may carry the same "hugepages=N": k4all's are deleted with --delete
    (only ones ``current`` has) and written again with --append. An IOMMU
    argument already set by hand is not added, nor recorded, so k4all never
    removes it."""
    ours, hand = _split_owned(current, recorded)
    plan = {"delete": [], "append": [], "append_if_missing": [], "record": [],
            "final": list(current), "problem": None}
    want_pages = [a for a in desired if karg_key(a) in HUGEPAGE_KEYS]
    want_iommu = [a for a in desired if karg_key(a) in IOMMU_KEYS]
    our_pages = [a for a in ours if karg_key(a) in HUGEPAGE_KEYS]
    hand_pages = [a for a in hand if karg_key(a) in HUGEPAGE_KEYS]
    if hand_pages and (want_pages or our_pages):
        plan["problem"] = (
            "hugepage kernel arguments set by hand (%s): k4all does not mix its "
            "own with them; remove them (`rpm-ostree kargs --delete=...`) or "
            "leave spec.nodes.hugepages unset" % " ".join(hand_pages))
        return plan
    for arg in want_iommu:
        clash = [h for h in hand if karg_key(h) == karg_key(arg) and h != arg]
        if clash:
            plan["problem"] = ("%s set by hand where k4all would add %s: remove "
                               "it or leave spec.nodes.iommu unset"
                               % (" ".join(clash), arg))
            return plan
    if our_pages != want_pages:
        plan["delete"] += our_pages
        plan["append"] += want_pages
    plan["record"] += want_pages
    for arg in ours:
        if karg_key(arg) not in HUGEPAGE_KEYS and arg not in want_iommu:
            plan["delete"].append(arg)
    for arg in want_iommu:
        if arg in ours:
            plan["record"].append(arg)
        elif arg not in hand:
            plan["append_if_missing"].append(arg)
            plan["record"].append(arg)
    final = list(current)
    for arg in plan["delete"]:
        final.remove(arg)
    final += plan["append"]
    final += [a for a in plan["append_if_missing"] if a not in final]
    plan["final"] = final
    return plan


def settings_kargs(kargs):
    """The arguments of ``kargs`` with a key node settings may set, in order:
    what /proc/cmdline must show for the next boot's to be booted."""
    return [a for a in kargs if karg_key(a) in NODE_SETTINGS_KARG_KEYS]


def kubelet_cpu_fields(config):
    """The CPU manager settings of a KubeletConfiguration (a dict), with the
    kubelet's defaults: a change of either needs its state files gone."""
    config = config if isinstance(config, dict) else {}
    return {"cpuManagerPolicy": str(config.get("cpuManagerPolicy") or "none"),
            "reservedSystemCPUs": str(config.get("reservedSystemCPUs") or "")}


def read_kubelet_cpu_fields(host):
    if not host.exists(KUBELET_CONFIG):
        return kubelet_cpu_fields({})
    return kubelet_cpu_fields(load_yaml_text(host, host.read(KUBELET_CONFIG)))


def cpu_state_policy(host):
    """policyName of the kubelet's CPU manager checkpoint, None without one."""
    path = KUBELET_STATE_FILES[0]
    try:
        return str(json.loads(host.read(path)).get("policyName") or "none") \
            if host.exists(path) else None
    except (OSError, ValueError, AttributeError):
        return None


def remove_kubelet_state(host):
    """Remove the CPU and memory manager checkpoints; the ones removed."""
    removed = []
    for path in KUBELET_STATE_FILES:
        if host.exists(path):
            os.remove(host.path(path))
            removed.append(path)
    return removed


def load_node_settings(host):
    """/etc/k4all/node-settings.json: kargs (what k4all added), applied,
    kubeletCPU (the CPU manager fields kubelet runs with), inflight."""
    if not host.exists(NODE_SETTINGS_FILE):
        return {"kargs": []}
    try:
        record = json.loads(host.read(NODE_SETTINGS_FILE))
    except ValueError as exc:
        raise UpgradeError("%s is not JSON (%s): fix it; it lists the kernel "
                           "arguments k4all added" % (NODE_SETTINGS_FILE, exc))
    if not isinstance(record, dict):
        raise UpgradeError("%s is not a JSON object" % NODE_SETTINGS_FILE)
    record.setdefault("kargs", [])
    return record


def save_node_settings(host, record):
    host.write(NODE_SETTINGS_FILE, json.dumps(record, indent=2, sort_keys=True) + "\n")


def configmap_settings(cm):
    """(settings, None) from kubelet-config's NODE_SETTINGS_ANNOTATION, or
    (None, why)."""
    raw = ((cm.get("metadata") or {}).get("annotations") or {}).get(
        NODE_SETTINGS_ANNOTATION)
    if not raw:
        return None, ("kube-system/kubelet-config has no %s annotation: is the "
                      "k4all-operator v0.6.0 or later running?"
                      % NODE_SETTINGS_ANNOTATION)
    try:
        settings = json.loads(raw)
    except ValueError as exc:
        return None, ("kube-system/kubelet-config: %s is not JSON (%s)"
                      % (NODE_SETTINGS_ANNOTATION, exc))
    if not isinstance(settings, dict) or not settings.get("hash"):
        return None, ("kube-system/kubelet-config: %s has no hash"
                      % NODE_SETTINGS_ANNOTATION)
    return settings, None


def cpu_vendor(host):
    if not host.exists(PROC_CPUINFO):
        return ""
    for line in host.read(PROC_CPUINFO).splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "vendor_id":
            return value.strip()
    return ""


# --- the x86-64 level of the CPU (#121) --------------------------------------
X86_64_LEVELS = ("v1", "v2", "v3", "v4")
# The x86-64 psABI levels in the flag names of /proc/cpuinfo, each level on
# top of the one before. OSXSAVE is not a cpuinfo flag: xsave next to avx
# stands for it.
X86_64_LEVEL_FLAGS = (
    ("v2", ("cx16", "lahf_lm", "popcnt", "pni", "ssse3", "sse4_1", "sse4_2")),
    ("v3", ("avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "abm", "movbe",
            "xsave")),
    ("v4", ("avx512f", "avx512bw", "avx512cd", "avx512dq", "avx512vl")),
)
# `ld.so --help` (glibc 2.33 on), under "Subdirectories of glibc-hwcaps
# directories, in priority order:", one line per level glibc knows, with
# "(supported, searched)" after those this CPU has. The manual does not
# document the format (elf/dl-usage.c prints it): only "supported" counts.
LD_SO_LEVEL_NAME = re.compile(r"^\s*x86-64-v[234]\b", re.M)
LD_SO_LEVEL_LINE = re.compile(r"^\s*x86-64-(v[234])[ \t]*(?:\(([^)\n]*)\))?", re.M)


def x86_64_level_from_ld_so(text):
    """The highest x86-64 level glibc's loader reports supported: "v1"
    when it lists the levels and supports none; None when it lists none
    (a glibc before 2.33, or no output)."""
    text = text or ""
    if not LD_SO_LEVEL_NAME.search(text):
        return None
    best = "v1"
    for level, notes in LD_SO_LEVEL_LINE.findall(text):
        if "supported" in re.split(r"[\s,;]+", notes) and level > best:
            best = level
    return best


def x86_64_level_from_cpuinfo(text):
    """The x86-64 level the flags of /proc/cpuinfo add up to, None
    without a flags line."""
    flags = None
    for line in (text or "").splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "flags":
            flags = set(value.split())
            break
    if flags is None:
        return None
    level = "v1"
    for name, needed in X86_64_LEVEL_FLAGS:
        if not flags.issuperset(needed):
            break
        level = name
    return level


def node_x86_64_level(host):
    """The value of this node's x86-64-level annotation: "v1" … "v4"; ""
    when an x86_64 node cannot tell (the annotation is removed: the
    operator takes the node as unknown); None on any other architecture,
    where it is never written. Found once per boot: glibc's loader first,
    else the flags of /proc/cpuinfo."""
    if host.arch() != "amd64":
        return None
    if host.exists(X86_64_LEVEL_CACHE):
        cached = host.read(X86_64_LEVEL_CACHE).strip()
        if cached in X86_64_LEVELS:
            return cached
    got = host.run([LD_SO_X86_64, "--help"], check=False, timeout=30)
    level = x86_64_level_from_ld_so(got.stdout)
    if level is None and host.exists(PROC_CPUINFO):
        level = x86_64_level_from_cpuinfo(host.read(PROC_CPUINFO))
    if level is None:
        return ""
    try:
        host.write(X86_64_LEVEL_CACHE, level + "\n")
    except OSError as exc:
        host.log("cannot keep the x86-64 level in %s: %s"
                 % (X86_64_LEVEL_CACHE, exc))
    return level


def boot_id(host):
    return host.read(BOOT_ID_FILE).strip() if host.exists(BOOT_ID_FILE) else ""


def file_digest(host, path):
    if not host.exists(path):
        return ""
    return hashlib.sha256(host.read(path).encode()).hexdigest()


def kubelet_state_guard(host):
    """Before a hop's reboot, with kubelet and every pod stopped.

    The kubeadm of a hop that changes Kubernetes writes config.yaml from
    kube-system/kubelet-config: on a node the node-settings rollout has not
    reached yet (paused, or older than the release that brings it) that is
    a new CPU manager policy or set of reserved CPUs without the reset of
    its checkpoint, and kubelet refuses to start after the reboot. Remove
    the checkpoints when config.yaml's CPU manager fields differ from the
    ones kubelet ran with (the record, or the checkpoint's policy). Never
    fails the hop: a problem is logged. True when it removed them."""
    try:
        fields = read_kubelet_cpu_fields(host)
        record = load_node_settings(host)
        seen = record.get("kubeletCPU")
        policy = cpu_state_policy(host)
        stale = (seen is not None and seen != fields) or (
            policy is not None
            and policy.lower() != fields["cpuManagerPolicy"].lower())
        if not stale:
            return False
        removed = remove_kubelet_state(host)
        record["kubeletCPU"] = fields
        save_node_settings(host, record)
        host.log("before the reboot: kubelet's CPU manager settings changed "
                 "(%s): removed %s" % (fields, ", ".join(removed) or "nothing"))
        return True
    except (UpgradeError, OSError, ValueError) as exc:
        host.log("before the reboot: cannot check kubelet's CPU manager "
                 "state: %s" % exc)
        return False


def _read_kubelet_configmap(host, kc):
    """(kube-system/kubelet-config, None), or (None, why)."""
    got = kubectl(host, kc, ["-n", "kube-system", "get", "configmap",
                             "kubelet-config", "-o", "json", KUBECTL_TIMEOUT],
                  check=False)
    if got.returncode != 0:
        return None, (got.stderr or got.stdout or "").strip()[-300:] or \
            "kubectl rc=%d" % got.returncode
    try:
        return json.loads(got.stdout), None
    except ValueError as exc:
        return None, "unreadable ConfigMap: %s" % exc


def _other_staged(host):
    """The image of a staged deployment that is not the booted image (a hop's,
    or one staged by hand), None when there is none: the reboot for kernel
    arguments would boot it. BootcBusy when bootc does not answer soon: the
    agent says so and tries at its next pass."""
    status = bootc_status(host, BOOTC_STATUS_QUICK)
    staged = _deployment(status, "staged")
    if not staged:
        return None
    booted = _deployment(status, "booted")
    ref, digest = deployment_image(staged)
    if booted and deployment_image(booted)[1] == digest and digest:
        return None
    return ref or "unknown"


def _rpm_ostree_kargs(host):
    got = host.run(["rpm-ostree", "kargs"], check=False, timeout=120)
    if got.returncode != 0:
        raise UpgradeError("rpm-ostree kargs: %s" % (
            (got.stderr or got.stdout or "").strip()[-300:]
            or "rc=%d" % got.returncode))
    return got.stdout.split()


def _wait_kubelet_ready(host, upgrader):
    """(True, "") once kubelet is active and this Node Ready, else (False,
    why) after NODE_SETTINGS_READY_SECONDS."""
    deadline = host.now() + datetime.timedelta(seconds=NODE_SETTINGS_READY_SECONDS)
    while True:
        active = host.run(["systemctl", "is-active", "kubelet"], check=False)
        state = active.stdout.strip()
        if state == "active":
            node, why = upgrader.read_node()
            if node is not None and node_ready(node):
                return True, ""
            why = why or "Node %s is not Ready" % upgrader._node_name()
        else:
            why = "kubelet is %s" % (state or "inactive")
        if host.now() >= deadline:
            return False, why
        host.sleep(READY_POLL_SECONDS)


def _restore_kubelet_config(host):
    if host.exists(NODE_SETTINGS_CONFIG_BACKUP):
        host.copy(NODE_SETTINGS_CONFIG_BACKUP, KUBELET_CONFIG)


def _pull_kubelet_config(host, kc, target):
    """`kubeadm upgrade node phase kubelet-config` (kubelet.conf on a worker,
    admin.conf on a control plane: kubeadm chooses). None when config.yaml
    now has the kubelet settings of ``target``, else why not (config.yaml
    is put back)."""
    if host.exists(KUBELET_CONFIG):
        host.copy(KUBELET_CONFIG, NODE_SETTINGS_CONFIG_BACKUP)
    argv = ["kubeadm", "upgrade", "node", "phase", "kubelet-config"]
    got = host.run(argv, check=False, timeout=600)
    if got.returncode != 0:
        _restore_kubelet_config(host)
        return ("%s failed (rc %d): %s" % (" ".join(argv), got.returncode,
                                          short_message(got.stderr or got.stdout)[-300:]))
    # The operator never rewrites kubelet-config while a node has a target
    # it has not applied; checked anyway, as kubeadm read it on its own.
    cm, why = _read_kubelet_configmap(host, kc)
    settings = configmap_settings(cm)[0] if cm else None
    if not settings or settings["hash"] != target:
        _restore_kubelet_config(host)
        return (WAITING + "kube-system/kubelet-config changed during the pull "
                "(%s): kubelet keeps its config" % (
                    "it now carries %s" % settings["hash"] if settings
                    else why or "no node settings"))
    return None


def node_settings_pass(host, upgrader, node, state):
    """The node-settings side of one agent pass, after the upgrade part."""
    annotations = ((node or {}).get("metadata") or {}).get("annotations") or {}
    target = str(annotations.get(ANNOTATION_NS_TARGET) or "").strip()
    applied = str(annotations.get(ANNOTATION_NS_APPLIED) or "").strip()
    if not target or target == applied:
        if target and ANNOTATION_NS_MESSAGE in annotations:
            upgrader.patch_annotations({ANNOTATION_NS_MESSAGE: None})
        return
    try:
        message = _apply_node_settings(host, upgrader, node, state, target)
    except (UpgradeError, OSError, ValueError) as exc:
        message = "node settings %s: %s" % (target, exc)
    if message is None:
        return
    message = short_message(message)
    if annotations.get(ANNOTATION_NS_MESSAGE) != message:
        host.log("node settings %s: %s" % (target, message))
        upgrader.patch_annotations({ANNOTATION_NS_MESSAGE: message})


def _hop_running(annotations, state):
    """What hop runs on this node, None when none does. A plan parked
    between hops (waiting for its window) does not count."""
    if annotations.get(ANNOTATION_IN_PROGRESS):
        return annotations[ANNOTATION_IN_PROGRESS]
    if _active(state) and not _parked(state):
        hop = state.get("hop") or {}
        return "%s -> %s, %s" % (hop.get("from"), hop.get("to"),
                                 "HOLD" if state.get("hold") else state.get("phase"))
    return None


def _apply_node_settings(host, upgrader, node, state, target):
    """Bring this node to the node settings ``target``. None once applied
    (or rebooting for them, the message already on the Node), else the
    message for node-settings-message."""
    annotations = (node.get("metadata") or {}).get("annotations") or {}
    hop = _hop_running(annotations, state)
    if hop:
        return WAITING + "an upgrade hop runs on this node (%s)" % hop
    kc = upgrader._kubeconfig()
    cm, why = _read_kubelet_configmap(host, kc)
    if cm is None:
        return WAITING + "cannot read kube-system/kubelet-config: %s" % why
    settings, problem = configmap_settings(cm)
    if problem:
        return problem
    if settings["hash"] != target:
        return (WAITING + "kube-system/kubelet-config carries the node settings "
                "%s, not %s" % (settings["hash"], target))
    desired, problem = desired_kargs(settings, cpu_vendor(host))
    if problem:
        return problem

    record = load_node_settings(host)
    boot = boot_id(host)
    inflight = record.get("inflight") or {}
    if inflight.get("target") != target:
        inflight = {"target": target, "cpu": read_kubelet_cpu_fields(host),
                    "config": file_digest(host, KUBELET_CONFIG), "boot": boot}
    plan = karg_plan(_rpm_ostree_kargs(host), record["kargs"], desired)
    if plan["problem"]:
        return plan["problem"]
    cmdline = host.read(PROC_CMDLINE).split() if host.exists(PROC_CMDLINE) else []
    booted = settings_kargs(cmdline) == settings_kargs(plan["final"])
    if not booted and inflight.get("rebootBoot") and inflight["rebootBoot"] != boot:
        if inflight.get("failedBoot") in (None, boot):
            inflight["failedBoot"] = boot
            record["inflight"] = inflight
            save_node_settings(host, record)
            return ("the node rebooted for the kernel arguments of %s but booted "
                    "without them (it runs %s, the next boot gets %s): see "
                    "`rpm-ostree status`; the agent tries again after the next "
                    "boot" % (target, " ".join(settings_kargs(cmdline)) or "none",
                              " ".join(settings_kargs(plan["final"])) or "none"))
        # rebooted again since (by hand): one more try
        inflight.pop("rebootBoot")
        inflight.pop("failedBoot")
    karg_change = bool(plan["delete"] or plan["append"] or plan["append_if_missing"])
    cpu_want = kubelet_cpu_fields(load_yaml_text(
        host, (cm.get("data") or {}).get("kubelet") or "{}"))
    cpu_change = cpu_want != inflight["cpu"] and not inflight.get("cpuReset")
    cordoned = bool((node.get("spec") or {}).get("unschedulable"))
    if (cpu_change or karg_change or not booted) and not cordoned:
        what = "the CPU manager settings" if cpu_change else "the kernel arguments"
        return ("%s change, which needs the node drained, and Node %s is not "
                "cordoned: the k4all-operator drains it first"
                % (what, upgrader._node_name()))
    if karg_change or not booted:
        try:
            staged = _other_staged(host)
        except BootcBusy as exc:
            return WAITING + str(exc)
        if staged:
            return ("another deployment is staged (%s): the reboot for the kernel "
                    "arguments would boot it; finish or remove it first" % staged)
    record["inflight"] = inflight
    save_node_settings(host, record)

    if not inflight.get("pulled"):
        problem = _pull_kubelet_config(host, kc, target)
        if problem:
            return problem
        inflight["pulled"] = True
        save_node_settings(host, record)
    # Kernel arguments before the CPU state reset: a failure here leaves
    # kubelet running.
    if karg_change:
        before = list(record["kargs"])
        # In /etc before the call: the new deployment takes /etc as it is
        # when it is made or finalized.
        record["kargs"] = plan["record"]
        save_node_settings(host, record)
        argv = (["rpm-ostree", "kargs"] + ["--delete=" + a for a in plan["delete"]]
                + ["--append=" + a for a in plan["append"]]
                + ["--append-if-missing=" + a for a in plan["append_if_missing"]])
        got = host.run(argv, check=False, timeout=600)
        if got.returncode != 0:
            # The node as it was: kubelet must not meet the new config.yaml
            # with the old CPU state if it restarts before the next pass.
            record["kargs"] = before
            _restore_kubelet_config(host)
            inflight["pulled"] = False
            save_node_settings(host, record)
            return "%s failed (rc %d): %s" % (" ".join(argv), got.returncode,
                                              short_message(got.stderr or got.stdout)[-300:])
    if read_kubelet_cpu_fields(host) != inflight["cpu"] and not inflight.get("cpuReset"):
        if not cordoned:
            _restore_kubelet_config(host)
            inflight["pulled"] = False
            save_node_settings(host, record)
            return ("kubeadm wrote other CPU manager settings than "
                    "kube-system/kubelet-config's, and Node %s is not cordoned"
                    % upgrader._node_name())
        # kubelet keeps the checkpoint in memory and writes it back: stop it
        # first; the node is drained
        host.run(["systemctl", "stop", "kubelet"], check=False, timeout=120)
        removed = remove_kubelet_state(host)
        host.log("node settings %s: the CPU manager settings change: removed %s"
                 % (target, ", ".join(removed) or "no state file"))
        inflight.update({"cpuReset": True, "restart": True})
        save_node_settings(host, record)
    if file_digest(host, KUBELET_CONFIG) != inflight["config"]:
        inflight["restart"] = True

    if not booted:
        inflight["rebootBoot"] = boot
        save_node_settings(host, record)
        upgrader.patch_annotations({ANNOTATION_NS_MESSAGE:
                                    WAITING + "rebooting for the kernel arguments"})
        host.log("node settings %s: rebooting for the kernel arguments %s"
                 % (target, " ".join(settings_kargs(plan["final"])) or "(none)"))
        upgrader.stop_pods()
        host.run(["systemctl", "reboot"], check=False, timeout=120)
        return None
    if inflight.get("restart") and not inflight.get("restarted"):
        if boot == inflight["boot"]:
            # restart starts it too when the CPU state reset stopped it
            host.run(["systemctl", "restart", "kubelet"], check=False, timeout=120)
            host.sleep(READY_POLL_SECONDS)
        inflight["restarted"] = True
        save_node_settings(host, record)
    ok, why = _wait_kubelet_ready(host, upgrader)
    if not ok:
        return WAITING + "kubelet is not Ready after applying %s: %s" % (target, why)
    if not upgrader.patch_annotations({ANNOTATION_NS_APPLIED: target,
                                       ANNOTATION_NS_MESSAGE: None}):
        return WAITING + "cannot write %s on the Node" % ANNOTATION_NS_APPLIED
    record.pop("inflight", None)
    record["applied"] = target
    record["kubeletCPU"] = read_kubelet_cpu_fields(host)
    save_node_settings(host, record)
    host.log("node settings %s applied" % target)
    return None


# =========================================================================
# Phases
# =========================================================================
class Upgrader:
    def __init__(self, host, cfg, graph_loader=None):
        self.host = host
        self.cfg = cfg
        self.graph_loader = graph_loader or (lambda: load_best_graph(host, cfg))
        self._name = None

    # --- helpers ---------------------------------------------------------
    def _role(self):
        return node_role(self.host)

    def _kubeconfig(self):
        return kubeconfig_for(self.host, self._role())

    def _node_name(self):
        if self._name is None:
            self._name = kubelet_node_name(self.host)
        return self._name

    def _list_nodes(self):
        """(Nodes, forbidden): the cluster's Nodes, or None when they cannot
        be listed; forbidden is True when the kubeconfig may not list them (a
        kubelet.conf may only read its own Node: Node authorizer)."""
        kc = self._kubeconfig()
        if not kc:
            return None, False
        got = kubectl(self.host, kc, ["get", "nodes", "-o", "json"], check=False)
        if got.returncode != 0:
            return None, "forbidden" in (got.stderr or "").lower()
        try:
            return json.loads(got.stdout).get("items", []), False
        except ValueError:
            return None, False

    def _cluster_nodes(self):
        """The cluster's Nodes, or None when this node cannot list them."""
        return self._list_nodes()[0]

    def _single_node(self):
        """True only on a bootstrap node that lists the Nodes and finds
        itself alone. A control plane or a worker always has a bootstrap
        node next to it, and a node that cannot list the Nodes cannot tell."""
        if self._role() != "bootstrap":
            return False
        nodes = self._cluster_nodes()
        return nodes is not None and len(nodes) <= 1

    def _needs_outside_drain(self):
        """A node that is surely not alone but cannot drain itself: a worker
        or a control plane without the admin kubeconfig (kubelet.conf may not
        evict pods). A bootstrap node without it cannot tell whether it is
        alone: it is not drained, as before, with a warning."""
        if self._kubeconfig() in (None, ADMIN_KUBECONFIG):
            return False
        if self._role() in ("worker", "control"):
            return True
        self.host.log("WARNING: bootstrap node without %s: it cannot list the "
                      "Nodes nor evict pods, and is not drained" % ADMIN_KUBECONFIG)
        return False

    def _cordon_problem(self, then):
        """None when this Node is cordoned, else why the hop must wait, with
        the drain to run from a control plane and ``then``, what to do
        next. The cordon stays whoever's put it."""
        name = self._node_name()
        node, why = self.read_node()
        if node is not None and (node.get("spec") or {}).get("unschedulable"):
            return None
        state = ("cannot read Node %s (%s)" % (name, why)) if node is None \
            else "Node %s is not cordoned" % name
        return ("this node needs a drain before the reboot, and its kubelet.conf "
                "may not evict pods; %s. From a control plane run `kubectl label "
                "node %s %s=true` (the k4all-operator then avoids the node) and "
                "`kubectl drain %s --ignore-daemonsets --delete-emptydir-data`, "
                "then %s. The node stays cordoned after the hop: `kubectl "
                "uncordon %s` and `kubectl label node %s %s-` once it is back. "
                "From v2.4.0 a ClusterUpgrade drains and uncordons the nodes "
                "instead." % (state, name, LABEL_DRAINING, name, then, name,
                              name, LABEL_DRAINING))

    def _label_draining(self, kc, on):
        """Set (on) or remove the draining label of this Node, with the
        cordon and the uncordon. Best effort: it only steers where the
        k4all-operator's pod is scheduled."""
        arg = LABEL_DRAINING + ("=true" if on else "-")
        got = kubectl(self.host, kc, ["label", "node", self._node_name(), arg,
                                      "--overwrite", KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            self.host.log("cannot %s the label %s on Node %s: %s"
                          % ("set" if on else "remove", LABEL_DRAINING,
                             self._node_name(),
                             (got.stderr or got.stdout or "").strip()[-300:]))

    def _drain_blockers(self, kc):
        """drain_blockers() of this node; [] when the budgets or the pods
        cannot be read (logged): the drain still has its timeout."""
        name = self._node_name()
        try:
            got = kubectl(self.host, kc, ["get", "poddisruptionbudgets", "-A",
                                          "-o", "json", KUBECTL_TIMEOUT],
                          check=False)
            if got.returncode != 0:
                raise ValueError((got.stderr or got.stdout or "").strip()[-300:])
            pdbs = [p for p in json.loads(got.stdout).get("items") or []
                    if budget_never_allows(p)]
            if not pdbs:
                return []
            got = kubectl(self.host, kc, ["get", "pods", "-A", "--field-selector",
                                          "spec.nodeName=" + name, "-o", "json",
                                          KUBECTL_TIMEOUT], check=False)
            if got.returncode != 0:
                raise ValueError((got.stderr or got.stdout or "").strip()[-300:])
            pods = json.loads(got.stdout).get("items") or []
            replicas = []
            if any(cnpg_primary(p) for p in pods):
                got = kubectl(self.host, kc, ["get", "pods", "-A", "-l",
                                              CNPG_ROLE_LABEL + "=replica",
                                              "-o", "json", KUBECTL_TIMEOUT],
                              check=False)
                if got.returncode != 0:
                    raise ValueError((got.stderr or got.stdout or "").strip()[-300:])
                replicas = json.loads(got.stdout).get("items") or []
            return drain_blockers(pdbs, pods, replicas)
        except ValueError as exc:
            self.host.log("WARNING: cannot check the PodDisruptionBudgets of the "
                          "pods on %s (%s): the drain may wait for one until "
                          "its timeout" % (name, exc))
            return []

    def annotate(self, value):
        """Set (value) or remove (None) the pause annotation on this Node."""
        kc = self._kubeconfig()
        if not kc:
            return
        arg = ("%s=%s" % (ANNOTATION_IN_PROGRESS, value)) if value \
            else ANNOTATION_IN_PROGRESS + "-"
        kubectl(self.host, kc, ["annotate", "node", self._node_name(), arg,
                                "--overwrite"], check=False)

    # --- ClusterUpgrade protocol -----------------------------------------
    def read_node(self):
        """(Node, None) for this node, or (None, why) when it cannot be read,
        e.g. while the apiserver is down."""
        kc = self._kubeconfig()
        if not kc:
            return None, "no kubeconfig on this node"
        got = kubectl(self.host, kc, ["get", "node", self._node_name(), "-o",
                                      "json", KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            return None, ((got.stderr or got.stdout or "").strip()[-300:]
                          or "kubectl rc=%d" % got.returncode)
        try:
            return json.loads(got.stdout), None
        except ValueError as exc:
            return None, "unreadable Node: %s" % exc

    def patch_annotations(self, changes, resource_version=None):
        """Merge-patch annotations of this Node (None removes one). Best
        effort: returns False when the apiserver refuses or is down."""
        if not changes:
            return True
        kc = self._kubeconfig()
        if not kc:
            return False
        meta = {"annotations": changes}
        if resource_version:
            meta["resourceVersion"] = resource_version
        got = kubectl(self.host, kc, ["patch", "node", self._node_name(),
                                      "--type", "merge", "-p",
                                      json.dumps({"metadata": meta},
                                                 sort_keys=True),
                                      KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            self.host.log("cannot annotate Node %s: %s"
                          % (self._node_name(),
                             (got.stderr or got.stdout or "").strip()[-300:]))
            return False
        return True

    def report(self, state, node=None, release=None, problem=None):
        """Publish the hop's phase (and release, node type, done) on the
        Node: read it, then patch what differs. Never fails the hop: the
        agent catches up later."""
        if node is None:
            node, why = self.read_node()
            if node is None:
                if self._kubeconfig():
                    self.host.log("cannot read Node %s: %s"
                                  % (self._node_name(), why))
                return False
        try:
            role = self._role()
        except UpgradeError:
            role = None
        observed = (node.get("metadata") or {}).get("annotations") or {}
        want = node_report(state, role, release, problem,
                           observed.get(ANNOTATION_TARGET))
        return self.patch_annotations(annotation_changes(observed, want))

    def _save(self, state):
        save_state(self.host, state)
        self.report(state)

    def drop_abandoned_target(self, state, node=None):
        """Remove upgrade-target while it still names the abandoned hop, then
        record that it is gone: a target written after that is the
        operator's retry, a new request."""
        abandoned = state.get("abandoned") or {}
        if not abandoned or abandoned.get("targetRemoved"):
            return True
        if node is None:
            node, why = self.read_node()
            if node is None:
                self.host.log("cannot remove %s now (%s); the agent retries"
                              % (ANNOTATION_TARGET, why))
                return False
        meta = node.get("metadata") or {}
        value = (meta.get("annotations") or {}).get(ANNOTATION_TARGET)
        if value is not None and same_target(value, abandoned.get("target")):
            # resourceVersion: never remove a target rewritten meanwhile
            if not self.patch_annotations({ANNOTATION_TARGET: None},
                                          meta.get("resourceVersion")):
                return False
        abandoned["targetRemoved"] = True
        save_state(self.host, state)
        return True

    def _backup_dir(self, hop):
        return "%s/backup/%s-%s" % (STATE_DIR, hop["from"], hop["to"])

    # --- PREFLIGHT -------------------------------------------------------
    def preflight(self, state):
        host, hop = self.host, state["hop"]
        try:
            status = bootc_status(host, BOOTC_STATUS_QUICK)
        except BootcBusy as exc:
            # another bootc command runs (a download by hand): nothing of
            # the hop has started, so wait for it
            raise NotYet(str(exc))
        staged = _deployment(status, "staged")
        if staged and not _same_image(staged, hop["image"]):
            ref, _ = deployment_image(staged)
            raise UpgradeError("another deployment is already staged (%s); "
                               "remove it before upgrading" % (ref or "unknown"))
        booted = current_version(host, status)
        if parse_version(booted) != parse_version(hop["from"]):
            raise UpgradeError("node runs %s, the hop starts from %s"
                               % (booted, hop["from"]))
        if host.free_gib("/sysroot") < float(self.cfg["minFreeSysrootGiB"]):
            raise UpgradeError("less than %s GiB free on /sysroot"
                               % self.cfg["minFreeSysrootGiB"])
        if host.free_gib("/var") < float(self.cfg["minFreeVarGiB"]):
            raise UpgradeError("less than %s GiB free on /var"
                               % self.cfg["minFreeVarGiB"])
        self._check_thin_pools()
        role = self._role()
        kc = self._kubeconfig()
        if not kc:
            host.log("no kubeconfig on this node: skipping cluster checks")
            return
        nodes = []
        if role in ("bootstrap", "control"):
            nodes = self._wait_cluster_ready(kc)
        # The order of the nodes and the drain from outside are "not yet",
        # not a HOLD: they pass once another node has moved or someone has
        # drained this one.
        target = hop["kubernetes"]
        running = kubelet_version(host)
        if k8s_key(target) != k8s_key(running):
            if role == "worker":
                api = server_version(host, kc)
                if k8s_key(api) < k8s_key(target):
                    raise NotYet("the apiserver is at %s; upgrade the control "
                                 "plane to %s first" % (api, target))
            elif role == "control":
                cluster = cluster_kubernetes_version(host, kc)
                if k8s_key(cluster) < k8s_key(target):
                    raise NotYet("the cluster is at %s; run the upgrade on the "
                                 "bootstrap node first" % cluster)
        if role == "control":
            behind = bootstrap_behind(nodes, self._node_name(), hop)
            if behind:
                raise NotYet(behind)
            if find_bootstrap_node(nodes, self._node_name()) is None:
                host.log("no bootstrap Node found: cannot check that it "
                         "already runs %s" % hop["to"])
        # Every hop reboots. A hop the k4all-operator asked for comes after its
        # cordon and drain; any other hop on a node that cannot drain itself
        # waits until someone drained it from a control plane.
        if not operator_driven(state) and self._needs_outside_drain():
            problem = self._cordon_problem("the hop can start")
            if problem:
                bare = bare_pods(self._node_pods(
                    kc, "the pods that declare no controller") or [])
                if bare:
                    problem = bare_pods_note(self._node_name(), bare) + " " + problem
                raise NotYet(problem)
        # A drain this node runs itself would never end on a pod whose
        # budget allows no disruption: stop before anything is downloaded,
        # and name it. Changing that budget is the admin's call. A hop the
        # operator asked for was checked before its cordon.
        if not operator_driven(state) and kc == ADMIN_KUBECONFIG \
                and not self._single_node():
            blockers = self._drain_blockers(kc)
            # So would a drain on a pod that declares no controller: kubectl
            # refuses the whole drain, after STAGE and PRE_REBOOT and with
            # the node cordoned (k4all#99). Deleting it is the admin's call.
            bare = bare_pods(self._node_pods(
                kc, "the pods that declare no controller") or [])
            if blockers:
                message = drain_blocked_message(self._node_name(), blockers)
                if bare:
                    message += ("; the drain would also refuse the pods that "
                                "declare no controller: %s" % _some(bare))
                raise UpgradeError(message)
            if bare:
                raise UpgradeError(bare_pods_message(self._node_name(), bare))
        # A single node is not drained: right before its reboot every pod
        # gets at most podStopMaxSeconds to stop. Name the ones that ask for
        # more, a VM above all, before anything changes.
        if kc == ADMIN_KUBECONFIG and self._single_node():
            self._warn_long_grace(kc, hop)

    def _check_thin_pools(self):
        """df sees the filesystem only. On a thin LV its pool can be almost
        full while df shows room, the hop downloads an image, and a full
        pool takes its filesystems down: HOLD when the pool under /sysroot
        or /var is fuller than maxThinPoolPercent, data or metadata (#131).
        A node without thin LVs, or whose LVs cannot be read, keeps df's
        check alone."""
        host = self.host
        mounts = collections.OrderedDict()
        for mount in ("/sysroot", "/var"):
            got = host.run(["findmnt", "-n", "-o", "MAJ:MIN", "--target", mount],
                           check=False, timeout=30)
            lines = (got.stdout or "").split()
            if got.returncode == 0 and lines:
                mounts.setdefault(lines[0], []).append(mount)
        if not mounts:
            return
        got = host.run(["lvs", "--reportformat", "json", "-o", LVS_FIELDS],
                       check=False, timeout=60)
        try:
            if got.returncode != 0:
                raise ValueError((got.stderr or got.stdout or "").strip()[-300:]
                                 or "rc %d" % got.returncode)
            report = json.loads(got.stdout)
        except ValueError as exc:
            host.log("cannot check the thin pools under %s (%s)"
                     % (" and ".join(m for ms in mounts.values() for m in ms),
                        exc))
            return
        pools = collections.OrderedDict()
        for majmin, under in mounts.items():
            found = thin_pool_of(report, majmin)
            if found:
                pools.setdefault(found, []).extend(under)
        most = self.cfg["maxThinPoolPercent"]
        for (name, data, meta), under in pools.items():
            if any(p is not None and p > most for p in (data, meta)):
                raise UpgradeError(
                    "the thin pool %s under %s is too full for the hop: data "
                    "%s, metadata %s, above maxThinPoolPercent %g (%s). A full "
                    "pool takes its filesystems down: free space in it "
                    "(`fstrim --all`) or extend it (`lvextend`), then resume"
                    % (name, " and ".join(under), _pct(data), _pct(meta), most,
                       CONFIG_FILE))

    def _node_pods(self, kc, what):
        """The pods on this node, or None when they cannot be read (logged:
        cannot check ``what``)."""
        got = kubectl(self.host, kc, ["get", "pods", "-A", "--field-selector",
                                      "spec.nodeName=" + self._node_name(),
                                      "-o", "json", KUBECTL_TIMEOUT], check=False)
        try:
            if got.returncode != 0:
                raise ValueError((got.stderr or got.stdout or "").strip()[-300:])
            return json.loads(got.stdout).get("items") or []
        except ValueError as exc:
            self.host.log("cannot check %s on %s (%s)"
                          % (what, self._node_name(), exc))
            return None

    def _warn_long_grace(self, kc, hop):
        most = pod_stop_max_seconds(self.cfg)
        pods = self._node_pods(kc, "the grace periods of the pods")
        long_ones = long_grace_pods(pods or [], most)
        if long_ones:
            warning = long_grace_warning(most, long_ones)
            self.host.log("WARNING: %s" % warning)
            hop["preflightWarning"] = warning
        else:
            hop.pop("preflightWarning", None)

    def _cluster_not_ready(self, kc, check_nodes=True):
        """(problem, nodes): what keeps the control plane from being ready
        (None when nothing does), and the nodes read."""
        ready = kubectl(self.host, kc, ["get", "--raw", "/readyz"], check=False)
        problem = readyz_problem(ready)
        if problem:
            return "the apiserver is not ready: %s" % problem, []
        if not check_nodes:
            return None, []
        nodes, forbidden = self._list_nodes()
        if nodes is None and forbidden:
            # Not "not ready": this kubeconfig may not list the Nodes.
            if not getattr(self, "_told_nodes_forbidden", False):
                self.host.log("%s may not list the Nodes: their Ready checks "
                              "are skipped" % kc)
                self._told_nodes_forbidden = True
            return None, []
        if nodes is None:
            return "cannot list the nodes", []
        not_ready = [n["metadata"]["name"] for n in nodes if not node_ready(n)]
        if not_ready:
            return "nodes not Ready: %s" % ", ".join(not_ready), nodes
        return None, nodes

    def _wait_cluster_ready(self, kc, nodes=True):
        """Wait until /readyz is ok and, with ``nodes``, every node is Ready;
        return the nodes.

        Right after a boot the apiserver answers before /readyz is ok:
        poststarthook/apiservice-discovery-controller fails while the
        aggregated APIs (metrics-server, calico-apiserver) come up, and the
        node itself takes a moment to turn Ready. Only a problem that lasts
        apiserverReadyTimeoutMinutes stops the hop."""
        host = self.host
        minutes = int(self.cfg["apiserverReadyTimeoutMinutes"])
        deadline = host.now() + datetime.timedelta(minutes=minutes)
        last = None
        check_nodes = nodes
        while True:
            problem, nodes = self._cluster_not_ready(kc, check_nodes)
            if problem is None:
                return nodes
            if host.now() >= deadline:
                raise UpgradeError("%s (still after %d minutes)"
                                   % (problem, minutes))
            if problem != last:
                host.log("%s; waiting up to %d minutes" % (problem, minutes))
                last = problem
            host.sleep(READY_POLL_SECONDS)

    # --- BACKUP ----------------------------------------------------------
    def backup(self, state):
        host, hop = self.host, state["hop"]
        dest = self._backup_dir(hop)
        for path in BACKUP_FILES:
            if host.exists(path):
                host.copy(path, dest + "/files" + path)
        if self._role() in ("bootstrap", "control") \
                and host.exists("/etc/kubernetes/manifests/etcd.yaml"):
            host.run(["/usr/local/bin/k4all-backup.sh", host.path(dest)],
                     timeout=1800)

    # --- STAGE -----------------------------------------------------------
    def stage(self, state):
        host, hop = self.host, state["hop"]
        staged = _deployment(bootc_status(host), "staged")
        if not staged:
            host.log("downloading %s" % hop["image"])
            host.run(["bootc", "switch", "--download-only", hop["image"]],
                     timeout=3600)
            staged = _deployment(bootc_status(host), "staged")
            if not staged or not _same_image(staged, hop["image"]):
                raise UpgradeError("bootc did not stage %s" % hop["image"])
        hop["startedAt"] = hop.get("startedAt") or host.now().isoformat(
            timespec="seconds")
        self._pause_for_hop(state)

    def _pause_for_hop(self, state):
        """The pause annotation, and an older operator scaled to zero when
        Kubernetes changes. In STAGE, and again in PRE_REBOOT and DRAIN: a
        HOLD before the reboot undid both, and the hop may go on from there."""
        hop = state["hop"]
        self.annotate("%s->%s" % (hop["from"], hop["to"]))
        # The operator that asked for the hop knows the pause gate.
        if k8s_key(hop["kubernetes"]) != k8s_key(kubelet_version(self.host)) \
                and not operator_driven(state):
            self.pause_operator(hop)

    # --- operator pause --------------------------------------------------
    def pause_operator(self, hop):
        """Operators older than the pause gate ignore the annotation; while
        kubeadm restarts the control plane, stop them by scaling to zero.
        Skipped in managed mode, where the operator drives the upgrade."""
        if self.cfg["mode"] == "managed" or "operatorReplicas" in hop:
            return
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            return
        got = kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "get",
                                      "deployment", OPERATOR_DEPLOYMENT, "-o",
                                      "json"], check=False)
        if got.returncode != 0:
            return
        replicas = int((json.loads(got.stdout).get("spec") or {})
                       .get("replicas", 1) or 0)
        if replicas == 0:
            return
        hop["operatorReplicas"] = replicas
        kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "scale", "deployment",
                                OPERATOR_DEPLOYMENT, "--replicas=0"])
        self.host.log("k4all-operator paused for the hop")

    def resume_operator(self, hop):
        """Scale an operator paused for the hop back. The saved replicas are
        dropped only once the scale went through: with the apiserver down
        (a HOLD right after kubeadm restarted the control plane) they stay
        in the hop, so a later pass can retry and pause_operator does not
        take the 0 replicas for the operator's own. True when nothing is
        left to resume."""
        replicas = (hop or {}).get("operatorReplicas")
        if not replicas:
            return True
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            hop.pop("operatorReplicas", None)
            return True
        done = kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "scale",
                                       "deployment", OPERATOR_DEPLOYMENT,
                                       "--replicas=%d" % replicas], check=False)
        if done.returncode != 0:
            self.host.log("k4all-operator not resumed yet (%s); it stays at 0 "
                          "replicas until the next pass"
                          % (short_message(done.stderr) or "scale failed"))
            return False
        hop.pop("operatorReplicas", None)
        self.host.log("k4all-operator resumed")
        return True

    def resume_operator_or_fail(self, hop):
        """At SYNC and COMMIT the hop must not go on, or forget the saved
        replicas, with the operator still at 0: wait for the apiserver and
        try again, then stop with a HOLD."""
        if self.resume_operator(hop):
            return
        kc = self._kubeconfig()
        self._wait_cluster_ready(kc, nodes=False)
        if not self.resume_operator(hop):
            raise UpgradeError("cannot scale the k4all-operator back to %s "
                               "replicas" % hop.get("operatorReplicas"))

    def hold(self, state, reason, code=None):
        """HOLD keeps the node paused, except when nothing was rebooted yet:
        then the cluster is unchanged and the operator may run again, so its
        replicas come back and the pause annotation goes. If the hop goes on
        from there, PRE_REBOOT and DRAIN pause it again."""
        if state.get("phase") in HOLD_RESUMES_OPERATOR and state.get("hop"):
            self.resume_operator(state["hop"])
            self.annotate(None)
        put_on_hold(self.host, state, reason, code)
        self.report(state)

    # --- PRE_REBOOT ------------------------------------------------------
    def pre_reboot(self, state):
        host, hop = self.host, state["hop"]
        self._pause_for_hop(state)
        target = hop["kubernetes"]
        current = kubelet_version(host)
        if k8s_key(target) == k8s_key(current):
            host.log("Kubernetes stays at %s" % current)
            return
        role = self._role()
        self._run_hooks(current, target, role)
        kubeadm = self.kubeadm_from_staged(target)
        if role == "bootstrap":
            cluster = cluster_kubernetes_version(host, ADMIN_KUBECONFIG)
            if cluster and k8s_minor(cluster) == k8s_minor(target) \
                    and k8s_key(cluster) >= k8s_key(target):
                host.log("control plane already at %s" % cluster)
                return
            self._preload_images(target, kubeadm)
            host.log("kubeadm upgrade apply v%s" % target)
            self._kubeadm_twice([kubeadm, "upgrade", "apply", "v" + target,
                                 "--yes"], ADMIN_KUBECONFIG)
            api = server_version(host, ADMIN_KUBECONFIG)
            if k8s_key(api) != k8s_key(target):
                raise UpgradeError("apiserver reports %s after kubeadm upgrade "
                                   "apply v%s" % (api, target))
        else:
            if role == "control":
                self._preload_images(target, kubeadm)
            host.log("kubeadm upgrade node (%s)" % role)
            self._kubeadm_twice([kubeadm, "upgrade", "node"],
                                self._kubeconfig() if role == "control" else None)

    def _kubeadm_twice(self, argv, kc):
        """kubeadm restarts etcd and the apiserver, and gives up when the
        kubelet takes longer than its own timeouts to bring them back (seen
        on VM 953: etcd back after 150 s, "context deadline exceeded").
        kubeadm upgrade can run again: wait for the apiserver, then try one
        more time before the HOLD."""
        host = self.host
        try:
            self._kubeadm_logged(argv)
            return
        except UpgradeError as exc:
            host.log("%s failed (%s); waiting for the apiserver to try once more"
                     % (" ".join(argv[1:3]), exc))
        if kc:
            self._wait_cluster_ready(kc, nodes=False)
        else:
            host.sleep(30)
        self._kubeadm_logged(argv)

    def _kubeadm_logged(self, argv):
        """Run kubeadm and keep its whole output (stdout tells which phase
        it was in) under the state directory; a failure is an UpgradeError
        that names the log."""
        host = self.host
        # Named by the start, which the journal's "kubeadm upgrade ..." line
        # shows; a run takes minutes.
        log = "%s/logs/kubeadm-%s.log" % (
            STATE_DIR, host.now().strftime("%Y%m%dT%H%M%S"))
        proc = host.run(argv, check=False, timeout=3600)
        try:
            host.write(log, "$ %s\nrc=%d\n--- stdout\n%s\n--- stderr\n%s\n"
                       % (" ".join(argv), proc.returncode, proc.stdout or "",
                          proc.stderr or ""))
        except OSError as exc:
            host.log("cannot save the kubeadm output: %s" % exc)
        if proc.returncode != 0:
            raise UpgradeError("%s failed (rc %d, output in %s): %s"
                               % (" ".join(argv[1:3]), proc.returncode, log,
                                  short_message(proc.stderr)[-300:]))

    # --- DRAIN -----------------------------------------------------------
    def drain(self, state):
        host, hop = self.host, state["hop"]
        self._pause_for_hop(state)
        if operator_driven(state):
            # The operator cordoned and drained the node (upgrade-cordoned)
            # and uncordons it once the hop is past the reboot (SYNC or COMMIT):
            # leave both to it.
            host.log("the k4all-operator drained this node: no drain")
            return
        kc = self._kubeconfig()
        if not kc:
            host.log("no kubeconfig: this node is in no cluster, no drain")
            return
        if self._single_node():
            host.log("single-node cluster: no drain")
            return
        if kc != ADMIN_KUBECONFIG:
            if not self._needs_outside_drain():
                return
            # Cordoned and drained from a control plane (checked again: the
            # node may have been uncordoned since the preflight). The hop is
            # staged by now: this one is a HOLD.
            problem = self._cordon_problem(
                "here `k4all-upgrade clear-hold && k4all-upgrade resume`")
            if problem:
                raise UpgradeError(problem)
            host.log("Node %s was drained from outside: no drain here"
                     % self._node_name())
            hop["cordonedOutside"] = True
            return
        minutes = int(self.cfg["drainTimeoutMinutes"])
        # Labelled with the cordon: the k4all-operator's pod, if this drain
        # evicts it, does not come back on this node to die with its reboot.
        self._label_draining(kc, True)
        kubectl(host, kc, ["drain", self._node_name(), "--ignore-daemonsets",
                           "--delete-emptydir-data", "--timeout=%dm" % minutes])
        hop["drained"] = True

    # --- REBOOT ----------------------------------------------------------
    def reboot(self, state):
        host = self.host
        state["phase"] = "REBOOT"
        self._save(state)
        host.log("rebooting into %s" % state["hop"]["to"])
        self.stop_pods()
        kubelet_state_guard(host)
        try:
            host.run(["bootc", "upgrade", "--from-downloaded", "--apply"])
        except UpgradeError:
            # Nothing rebooted: retrying the hop must start again from DRAIN.
            host.run(["systemctl", "start", "kubelet"], check=False, timeout=120)
            state["phase"] = "DRAIN"
            raise

    def stop_pods(self):
        """Stop kubelet, then every pod, each within its own grace period.

        Without this the shutdown waits for each container's own grace
        period: ingress-nginx (300 s and a preStop hook that waits for nginx)
        held control-plane reboots for 4 minutes in the lab, the API down all
        along. The DaemonSets that a drain leaves behind run here too, and
        on a single node every pod, its VMs included. With kubelet stopped
        nothing restarts the pods, and no preStop hook runs. Each pod gets
        its terminationGracePeriodSeconds, at least POD_STOP_SECONDS and at
        most podStopMaxSeconds: up to v2.6.6 every pod got 30 s, and a VM's
        guest lost QEMU halfway through its shutdown (k4all#98).

        The pods on the pod network stop first, in parallel, then the ones
        on the host network (the CNI agent, the static pods), in parallel.
        CRI-O tears a pod's network down before it stops its containers;
        with the CNI agent stopping at the same time that teardown failed
        for 27 of about 40 pods on VM 980, and their containers were left to
        the reboot. The reboot waits at most twice podStopMaxSeconds."""
        host = self.host
        most = pod_stop_max_seconds(self.cfg)
        host.log("stopping kubelet and the pods (each within its grace "
                 "period: at least %d s, at most %d s)" % (POD_STOP_SECONDS, most))
        # Best effort: the reboot is decided. Whatever fails here is logged,
        # and the reboot goes on.
        self._best_effort(["systemctl", "stop", "kubelet"], 120)
        plan = self._pod_stop_plan(most)
        if not plan:
            return
        longer = ["%s %d s%s" % (name, seconds, "" if grace is None or
                                 grace <= seconds else
                                 " (of the %d s it asks)" % grace)
                  for seconds, _, name, grace in plan if seconds > POD_STOP_SECONDS]
        if longer:
            host.log("before the reboot: pods with more than %d s to stop: %s"
                     % (POD_STOP_SECONDS, ", ".join(longer)))
        networks = self._pod_networks([pod for _, pod, _, _ in plan])
        first = [p for p in plan if networks.get(p[1]) != "NODE"]
        then = [p for p in plan if networks.get(p[1]) == "NODE"]
        if first and then:
            host.log("before the reboot: stopping the pods on the pod network "
                     "(%d), then the ones on the host network (%d)"
                     % (len(first), len(then)))
        for group in (first, then):
            if not group:
                continue
            got = self._best_effort(
                ["sh", "-c", STOP_PODS_SCRIPT], group[0][0] + 60,
                "".join("%d %s\n" % (seconds, pod) for seconds, pod, _, _ in group))
            if got is not None:
                self._report_pod_stops(group, got.stdout)

    def _pod_networks(self, pods):
        """{pod id: NODE or POD}, the network namespace of each pod sandbox
        (`crictl inspectp`); {} when they cannot be read (logged): then every
        pod stops at once."""
        if not pods:
            return {}
        try:
            got = self.host.run(CRICTL.split() + ["inspectp", "-o", "json"] + pods,
                                check=False, timeout=60)
            if got.returncode != 0:
                raise ValueError((got.stderr or "").strip()[-200:]
                                 or "rc=%d" % got.returncode)
            found = json.loads(got.stdout or "[]")
            if isinstance(found, dict):
                found = [found]
            networks = {}
            for item in found:
                status = item.get("status") or {}
                network = (((status.get("linux") or {}).get("namespaces") or {})
                           .get("options") or {}).get("network")
                if status.get("id") and network:
                    networks[status["id"]] = network
            return networks
        except Exception as exc:  # pylint: disable=broad-except
            self.host.log("before the reboot: cannot tell which pods are on the "
                          "host network (%s): every pod stops at once" % exc)
            return {}

    def _best_effort(self, argv, timeout, input_text=None):
        """Run a command before the reboot; log how it failed, if it did.
        Returns its result, None when it could not run."""
        host = self.host
        try:
            got = host.run(argv, check=False, timeout=timeout,
                           input_text=input_text)
        except Exception as exc:  # pylint: disable=broad-except
            host.log("before the reboot: %s: %s" % (argv[0], exc))
            return None
        if argv[0] == "sh" and got.returncode == XARGS_SOME_FAILED:
            # Some pods did not stop cleanly, mostly their network: the
            # CNI cannot reach the apiserver any more, or the netns is
            # still busy ("failed to remove netns path ... device or
            # resource busy", VM 953). The reboot ends them anyway.
            host.log("before the reboot: some pods did not stop cleanly; "
                     "the reboot ends them (last crictl message: %s)"
                     % (got.stderr or "").strip()[-160:])
        elif got.returncode != 0:
            host.log("before the reboot: %s exited %d: %s"
                     % (" ".join(argv[:2]), got.returncode,
                        (got.stderr or "").strip()[-200:]))
        return got

    def _pod_stop_plan(self, most):
        """pod_stop_plan() of the ready pods; [] when they cannot be listed
        (the reboot ends them)."""
        host, crictl = self.host, CRICTL.split()

        def listing(args, key):
            """(the list, None), or (None, why it could not be read)."""
            try:
                got = host.run(crictl + args, check=False, timeout=60)
            except Exception as exc:  # pylint: disable=broad-except
                return None, "%s: %s" % (type(exc).__name__, exc)
            if got.returncode != 0:
                return None, ((got.stderr or "").strip()[-200:]
                              or "rc=%d" % got.returncode)
            try:
                return json.loads(got.stdout or "{}").get(key) or [], None
            except (ValueError, AttributeError) as exc:
                return None, "unreadable: %s" % exc
        sandboxes, why = listing(["pods", "-o", "json", "--state", "ready"],
                                 "items")
        if sandboxes is None:
            host.log("before the reboot: cannot list the pods (%s): the reboot "
                     "ends them" % why)
            return []
        containers, why = listing(["ps", "-o", "json"], "containers")
        if containers is None:
            host.log("before the reboot: cannot read the grace periods of the "
                     "pods (%s): each pod gets up to %d s" % (why, most))
        return pod_stop_plan(sandboxes, containers, most)

    def _report_pod_stops(self, plan, stdout):
        """Log how the pods stopped: the ones CRI-O killed at their deadline,
        how long the ones with more than POD_STOP_SECONDS took, and the stops
        that failed (the reboot ends those pods)."""
        took = {}
        for line in (stdout or "").splitlines():
            parts = line.split()
            if len(parts) == 4 and all(p.isdigit() for p in parts[1:]):
                took[parts[0]] = tuple(int(p) for p in parts[1:])
        failed, again = [], []
        for seconds, pod, name, grace in plan:
            if pod not in took:
                continue
            rc, spent, tries = took[pod]
            if rc == 0 and tries > 1:
                again.append(name)
            if rc != 0:
                failed.append(name)
                if seconds > POD_STOP_SECONDS:
                    self.host.log("before the reboot: %s: its stop failed within "
                                  "its %d s; the reboot ends it" % (name, seconds))
            elif spent >= seconds:
                asks = " (it asks %d s)" % grace \
                    if grace is not None and grace > seconds else ""
                self.host.log("before the reboot: %s did not stop within %d s%s: "
                              "CRI-O killed it" % (name, seconds, asks))
            elif seconds > POD_STOP_SECONDS:
                self.host.log("before the reboot: %s stopped in %d s (of %d s)"
                              % (name, spent, seconds))
        if again:
            self.host.log("before the reboot: %d pods stopped at a second or "
                          "third try, their network teardown having failed "
                          "first: %s" % (len(again), ", ".join(sorted(again))))
        if failed:
            self.host.log("before the reboot: the stop of %d pods failed (CRI-O "
                          "tears the network down first, and the CNI may be "
                          "stopping too; the reboot ends them): %s"
                          % (len(failed), ", ".join(sorted(failed))))

    # --- POST_BOOT -------------------------------------------------------
    def post_boot(self, state):
        """Runs after the reboot. Returns normally when the node is healthy on
        the new release; raises RollbackNeeded when it booted the new image
        but is unhealthy; raises UpgradeError for anything else."""
        host, hop = self.host, state["hop"]
        booted = current_version(host)
        if parse_version(booted) == parse_version(hop["from"]):
            raise UpgradeError("the node rebooted but is still on %s"
                               % hop["from"])
        if parse_version(booted) != parse_version(hop["to"]):
            raise UpgradeError("node booted %s instead of %s"
                               % (booted, hop["to"]))
        # kube-vip first: the health checks below go through admin.conf,
        # that is through the VIP. A manifest left without settings would
        # keep them failing until the rollback.
        self._kube_vip_in_hop(hop, wait=False)
        deadline = host.now() + datetime.timedelta(
            minutes=int(self.cfg["postBootTimeoutMinutes"]))
        while True:
            # Before the health check: on a node with the OVS bridge the
            # Cilium of an older release cannot start (the node is NotReady)
            # until cilium-config names ovs-bridge.
            self._cilium_devices_in_hop(hop)
            ok, reason = self._node_healthy(hop)
            if ok:
                break
            if host.now() >= deadline:
                raise RollbackNeeded("node not healthy after the reboot: %s"
                                     % reason)
            host.sleep(15)
        # Again, now that the ClusterConfig answers: a control plane that
        # joined has ha.type none in its own /etc/k4all-config.yaml.
        self._kube_vip_in_hop(hop, wait=True)

    def _kube_vip_in_hop(self, hop, wait):
        """reconcile_kube_vip during a hop: a problem is logged and shown in
        upgrade-message, never a HOLD or a rollback."""
        try:
            changed, warning = self.reconcile_kube_vip()
        except (UpgradeError, OSError, ValueError) as exc:
            changed, warning = False, "kube-vip: %s" % exc
        if warning:
            self.host.log("WARNING: %s" % warning)
            hop["kubeVipWarning"] = warning
        else:
            hop.pop("kubeVipWarning", None)
        if changed and wait:
            # kubelet restarts kube-vip and the VIP may move: the next steps
            # need the API again. /readyz is enough here.
            self._wait_cluster_ready(self._kubeconfig(), nodes=False)

    # --- kube-vip --------------------------------------------------------
    def kube_vip_ha(self):
        """The HA settings (spec.cluster.ha): from the ClusterConfig when
        there is one and the API answers, else from /etc/k4all-config.yaml,
        which needs no API (a broken VIP, a node before kubeadm init)."""
        kc = self._kubeconfig()
        if kc:
            got = kubectl(self.host, kc, ["get", "clusterconfigs", "-o", "json",
                                          KUBECTL_TIMEOUT], check=False)
            if got.returncode == 0:
                try:
                    items = json.loads(got.stdout).get("items") or []
                except ValueError:
                    items = []
                if items:
                    return ((items[0].get("spec") or {}).get("cluster")
                            or {}).get("ha") or {}, "the ClusterConfig"
        if self.host.exists(K4ALL_CONFIG_FILE):
            try:
                cfg = load_yaml_file(self.host, K4ALL_CONFIG_FILE) or {}
            except Exception:  # pylint: disable=broad-except
                cfg = {}
            return (((cfg.get("spec") or {}).get("cluster") or {}).get("ha")
                    or {}), K4ALL_CONFIG_FILE
        return {}, "no configuration"

    def kube_vip_manifest(self, before_init=False, version=None):
        """What kube-vip's static pod for this node should be: a KubeVipPlan.

        action is "write" (``want`` differs from the file), "same", "skip"
        (nothing to do: not a control plane, HA not kube-vip) or "warn"
        (something to fix first, said in ``detail``: a kube-vip.yaml that
        cannot be read, no valid kube-vip version, no kubeconfig to mount;
        the file is left as it is). ``before_init``: setup-k8s-ph3.sh on the
        bootstrap node before kubeadm init, when super-admin.conf is about to
        exist. ``version``: the kube-vip release to write instead of the one
        the release manifest pins (setup-k8s-ph3.sh, for a manifest with
        "latest": v2.2.4 and v2.3.0). The host owns kube-vip on every control
        plane (the ReleaseManifest has it Unmanaged)."""
        host = self.host
        role = self._role()
        if role not in ("bootstrap", "control"):
            return KubeVipPlan("skip", None, None, "not a control plane")
        ha, source = self.kube_vip_ha()
        if ha.get("type") != "kubevip" or not ha.get("apiControlEndpoint"):
            return KubeVipPlan("skip", None, None,
                               "HA is not kube-vip (%s)" % source)
        existing = None
        if host.exists(KUBE_VIP_MANIFEST):
            try:
                existing = load_yaml_file(host, KUBE_VIP_MANIFEST)
            except Exception as exc:  # pylint: disable=broad-except
                return KubeVipPlan("warn", None, None, (
                    "%s cannot be read, so it is left as it is (%s); fix or "
                    "remove it, then run `k4all-upgrade kube-vip-manifest "
                    "--write`" % (KUBE_VIP_MANIFEST, short_message(exc))))
            if existing is not None and not isinstance(existing, dict):
                return KubeVipPlan("warn", None, None, "%s is not a Pod, so it "
                                   "is left as it is" % KUBE_VIP_MANIFEST)
        if version:
            where = "--version"
        else:
            version, where = self._kube_vip_version()
        if not version:
            return KubeVipPlan("warn", None, existing, (
                "no valid kube-vip version in %s, so %s is left as it is"
                % (where, KUBE_VIP_MANIFEST)))
        kubeconfig = self._kube_vip_kubeconfig(role, before_init)
        if not kubeconfig:
            return KubeVipPlan("warn", None, existing, (
                "%s has no %s to mount, so %s is left as it is"
                % ("the bootstrap node" if role == "bootstrap" else
                   "this control plane",
                   "super-admin.conf nor admin.conf" if role == "bootstrap"
                   else "admin.conf", KUBE_VIP_MANIFEST)))
        want = desired_kube_vip(existing, ha, self._vip_interface(ha), version,
                                kubeconfig)
        if existing is not None and \
                json.dumps(existing, sort_keys=True) == json.dumps(want, sort_keys=True):
            return KubeVipPlan("same", want, existing, "%s is up to date"
                               % KUBE_VIP_MANIFEST)
        return KubeVipPlan("write", want, existing, None)

    def _kube_vip_kubeconfig(self, role, before_init):
        """The kubeconfig kube-vip mounts, one that exists: super-admin.conf
        on the bootstrap node (kubeadm init's, needed while the first control
        plane comes up), else admin.conf; admin.conf on the others (kubeadm
        join writes no super-admin.conf). Before kubeadm init, on the
        bootstrap node, super-admin.conf is the one init is about to write."""
        host = self.host
        if role == "bootstrap":
            if host.exists(SUPER_ADMIN_KUBECONFIG):
                return SUPER_ADMIN_KUBECONFIG
            if host.exists(ADMIN_KUBECONFIG):
                return ADMIN_KUBECONFIG
            return SUPER_ADMIN_KUBECONFIG if before_init else None
        return ADMIN_KUBECONFIG if host.exists(ADMIN_KUBECONFIG) else None

    def reconcile_kube_vip(self, before_init=False):
        """Write kube-vip's static pod when it differs, under a lock of its
        own (two writers never mix; the hop lock is too long to wait for).
        Returns (restarted, warning): restarted when a manifest that was
        there changed (kubelet restarts that kube-vip, and the VIP may
        move); warning when the plan says something must be fixed first."""
        host = self.host
        with Lock(host, LOCK_WAIT, name="kube-vip.lock"):
            plan = self.kube_vip_manifest(before_init)
            if plan.action == "warn":
                return False, plan.detail
            if plan.action != "write":
                return False, None
            self.write_kube_vip(plan)
        return plan.existing is not None, None

    def write_kube_vip(self, plan):
        host = self.host
        self._load_image(KUBE_VIP_IMAGE + ":" + want_tag(plan.want))
        if host.exists(KUBE_VIP_MANIFEST):
            host.copy(KUBE_VIP_MANIFEST, STATE_DIR + "/backup/kube-vip.yaml." +
                      host.now().strftime("%Y%m%d%H%M%S"))
        # kubelet takes every file of the manifest directory for a static
        # pod: the temporary file is next to it, on the same filesystem.
        host.write(KUBE_VIP_MANIFEST, dump_yaml_docs(host, [plan.want]),
                   mode=0o600,
                   tmp_dir=os.path.dirname(os.path.dirname(KUBE_VIP_MANIFEST)))
        host.log("kube-vip: %s %s (%s, interface %s)"
                 % ("updated" if is_k4all_kube_vip(plan.existing) else "wrote",
                    KUBE_VIP_MANIFEST, want_tag(plan.want), kube_vip_env_value(
                        plan.want, "vip_interface")))

    def _vip_interface(self, ha):
        """The interface of the VIP on this node: the configured one when
        this node has it, else the device of the default route (auto, and
        an OVS bridge that took the address over)."""
        host = self.host
        name = str(ha.get("interface") or "").strip()
        if name and name != "auto" and host.exists("/sys/class/net/" + name):
            return name
        out = host.run(["ip", "-o", "route", "show", "default"], check=False).stdout
        match = re.search(r"\bdev\s+(\S+)", out or "")
        if match:
            return match.group(1)
        return name if name and name != "auto" else ""

    def _kube_vip_version(self):
        """(version, where): the kube-vip version the node's release manifest
        pins, as setup-k8s-ph3.sh read it: /etc/k4all-release.yaml first,
        then the image's. ("", where) when neither has a valid one."""
        for path in (K4ALL_RELEASE_FILE, IMAGE_RELEASE_MANIFEST):
            if not self.host.exists(path):
                continue
            try:
                manifest = load_yaml_file(self.host, path) or {}
            except Exception:  # pylint: disable=broad-except
                continue
            comp = ((manifest.get("spec") or {}).get("components") or {}).get(
                KUBE_VIP_COMPONENT) or {}
            version = str(comp.get("version") or "")
            if is_version(version):
                return version, path
        return "", "%s or %s" % (K4ALL_RELEASE_FILE, IMAGE_RELEASE_MANIFEST)

    def _load_image(self, ref):
        """Load one image shipped in IMAGE_CACHE_DIR, when it is there."""
        name = re.sub(r"[/:@]", "_", ref) + ".tar"
        path = IMAGE_CACHE_DIR + "/" + name
        if self.host.exists(path):
            self.host.run(["podman", "load", "-i", self.host.path(path)],
                          check=False, timeout=900)

    def _node_healthy(self, hop):
        host = self.host
        active = host.run(["systemctl", "is-active", "kubelet"], check=False)
        if active.stdout.strip() != "active":
            return False, "kubelet is %s" % (active.stdout.strip() or "inactive")
        version = kubelet_version(host)
        if k8s_key(version) != k8s_key(hop["kubernetes"]):
            return False, "kubelet is %s, expected %s" % (version,
                                                          hop["kubernetes"])
        kc = self._kubeconfig()
        if not kc:
            return True, ""
        node = kubectl(host, kc, ["get", "node", self._node_name(), "-o",
                                  "json"], check=False)
        if node.returncode != 0:
            return False, "cannot read the node: %s" % node.stderr.strip()
        if not node_ready(json.loads(node.stdout)):
            return False, "node is not Ready"
        if self._role() in ("bootstrap", "control"):
            ready = kubectl(host, kc, ["get", "--raw", "/readyz"], check=False)
            problem = readyz_problem(ready)
            if problem:
                return False, "apiserver not ready: %s" % problem
        return True, ""

    # --- Cilium during a hop ---------------------------------------------
    def _cilium_config(self, kc):
        """cilium-config's data; {} when the cluster has none (no Cilium);
        None when it cannot be read (the API not up yet, no rights)."""
        if kc != ADMIN_KUBECONFIG:
            return None
        got = kubectl(self.host, kc, ["-n", CILIUM_NAMESPACE, "get", "configmap",
                                      CILIUM_CONFIGMAP, "-o", "json",
                                      KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            return {} if "NotFound" in (got.stderr or "") else None
        try:
            return json.loads(got.stdout).get("data") or {}
        except ValueError:
            return None

    def _cilium_managed(self, kc):
        """True when the cluster's ReleaseManifest has Cilium Managed. A
        Cilium left Unmanaged (a cluster restored from 1.x) is the admin's."""
        got = kubectl(self.host, kc, ["get", "releasemanifest", "k4all", "-o",
                                      "json", KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            return False
        try:
            spec = json.loads(got.stdout).get("spec") or {}
        except ValueError:
            return False
        cilium = (spec.get("components") or {}).get("cilium")
        return bool(cilium) and cilium.get("management", "Managed") == "Managed"

    def _restart_local_pods(self, kc, selector):
        """Delete this node's pods of a DaemonSet: they start again at once,
        with the configuration they read at start."""
        return kubectl(self.host, kc, ["-n", CILIUM_NAMESPACE, "delete", "pod",
                                       "-l", selector, "--field-selector",
                                       "spec.nodeName=" + self._node_name(),
                                       "--wait=false", KUBECTL_TIMEOUT],
                       check=False).returncode == 0

    def _cilium_devices_in_hop(self, hop):
        """Cilium 1.20 skips the OVS bridge in its device detection: on a node
        whose IP is on ovs-bridge the agent of an older release stops at
        every start ("unable to determine direct routing device"), and the
        node stays NotReady after the hop's reboot, before the sync brings
        the k4all-operator (v0.5.3) that names it. Write the same keys the
        operator renders (devices ovs-bridge first, force-device-detection)
        and restart this node's agent. Control planes only (cilium-config is
        cluster-wide: the bootstrap's hop, the first, writes it), Cilium
        Managed only. Best effort, retried while the node is not healthy."""
        if hop.get("ciliumDevices"):
            return
        host = self.host
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG or not host.exists(OVS_BRIDGE_SYSFS):
            hop["ciliumDevices"] = "skip"
            return
        data = self._cilium_config(kc)
        if data is None:
            return  # the API is not up yet: next round
        devices = (data.get("devices") or "").split()
        if not data or "ovs-bridge" in devices:
            hop["ciliumDevices"] = "skip"
            return
        if not self._cilium_managed(kc):
            host.log("cilium: Unmanaged, cilium-config left as it is (Cilium "
                     "1.20 needs devices ovs-bridge on a node with the OVS "
                     "bridge)")
            hop["ciliumDevices"] = "skip"
            return
        patch = {"data": {"devices": " ".join(["ovs-bridge"] + devices),
                          "force-device-detection": "true"}}
        got = kubectl(host, kc, ["-n", CILIUM_NAMESPACE, "patch", "configmap",
                                 CILIUM_CONFIGMAP, "--type", "merge", "-p",
                                 json.dumps(patch), KUBECTL_TIMEOUT],
                      check=False)
        if got.returncode != 0:
            host.log("cilium: cilium-config not patched: %s"
                     % (got.stderr or "").strip()[-200:])
            return
        self._restart_local_pods(kc, CILIUM_AGENT_SELECTOR)
        host.log("cilium: devices %s, force-device-detection on; restarted "
                 "the agent of this node" % patch["data"]["devices"])
        hop["ciliumDevices"] = "patched"

    def _release_manifest(self, kc):
        """The cluster's ReleaseManifest, None when it cannot be read."""
        got = kubectl(self.host, kc, ["get", "releasemanifest",
                                      RELEASE_MANIFEST_NAME, "-o", "json",
                                      KUBECTL_TIMEOUT], check=False)
        if got.returncode != 0:
            return None
        try:
            return json.loads(got.stdout)
        except ValueError:
            return None

    def _cilium_after_sync(self, before, before_rm=None):
        """The sync may change cilium-config (k4all-operator v0.5.3:
        socketLB.hostNamespaceOnly with KubeVirt, cni.exclusive off with
        Multus); the operator does not restart the agents. This node already
        runs the new release (its --node-ip pinned, its devices right), so its
        agent restarts here, then Multus, whose CNI config an older agent may
        have renamed. Other nodes read it when they reboot into the release.

        The operator is paused during the hop and re-applies Cilium only once
        the sync is done, after the components already look settled: when the
        sync brought another k4all-operator, wait (5 minutes at most) until it
        re-applied Cilium (its appliedHash moved) or cilium-config changed.
        Best effort: a problem is logged, never a HOLD."""
        host = self.host
        kc = self._kubeconfig()
        if before is None or not before or not self._cilium_managed(kc):
            return

        def comp(rm, name):
            return (((rm or {}).get("spec") or {}).get("components") or {}).get(name) or {}

        def applied(rm):
            return ((((rm or {}).get("status") or {}).get("components") or {})
                    .get("cilium") or {}).get("appliedHash")

        after = self._cilium_config(kc)
        rm = self._release_manifest(kc)
        new_operator = (before_rm is not None and rm is not None and
                        comp(before_rm, "k4all-operator").get("version")
                        != comp(rm, "k4all-operator").get("version"))
        if new_operator and after == before:
            deadline = host.now() + datetime.timedelta(minutes=5)
            while after == before and applied(rm) == applied(before_rm):
                if host.now() >= deadline:
                    break
                host.sleep(10)
                after = self._cilium_config(kc)
                rm = self._release_manifest(kc)
        if not after or after == before:
            return
        if not self._restart_local_pods(kc, CILIUM_AGENT_SELECTOR):
            host.log("cilium: the agent of this node was not restarted")
            return
        host.log("cilium: cilium-config changed in the sync, restarted the "
                 "agent of this node")
        deadline = host.now() + datetime.timedelta(minutes=5)
        while True:
            ok, reason = self._node_healthy_now()
            if ok:
                break
            if host.now() >= deadline:
                host.log("WARNING: cilium: node not Ready after the agent "
                         "restart: %s" % reason)
                return
            host.sleep(10)
        if self._restart_local_pods(kc, MULTUS_SELECTOR):
            host.log("multus: restarted on this node")

    def _node_healthy_now(self):
        """(ok, reason): this Node is Ready."""
        kc = self._kubeconfig()
        node = kubectl(self.host, kc, ["get", "node", self._node_name(), "-o",
                                       "json"], check=False)
        if node.returncode != 0:
            return False, "cannot read the node: %s" % node.stderr.strip()
        if not node_ready(json.loads(node.stdout)):
            return False, "node is not Ready"
        return True, ""

    # --- SYNC ------------------------------------------------------------
    def sync(self, state):
        host, hop = self.host, state["hop"]
        kc = self._kubeconfig()
        if hop.get("drained") and kc:
            kubectl(host, kc, ["uncordon", self._node_name()])
            self._label_draining(kc, False)
            hop["drained"] = False
        self.resume_operator_or_fail(hop)
        if hop.get("syncManifest") and self._role() == "bootstrap":
            before = self._cilium_config(kc)
            before_rm = self._release_manifest(kc)
            refused = self.sync_manifest(state) or []
            self._cilium_after_sync(before, before_rm)
            # Shown in upgrade-message during the hop, kept in the history
            # and by `status` after it: the hop must not hide them. A sync
            # that runs again (after a HOLD) does not repeat them.
            warnings = list(hop.get("syncWarnings") or [])
            warnings += [w for w in refused if w not in warnings]
            if warnings:
                hop["syncWarnings"] = warnings

    # --- COMMIT ----------------------------------------------------------
    def commit(self, state):
        host, hop = self.host, state["hop"]
        self.resume_operator_or_fail(hop)
        self.annotate(None)
        state["history"].append({"from": hop["from"], "to": hop["to"],
                                 "result": "ok",
                                 "at": host.now().isoformat(timespec="seconds")})
        # Only what is still true after the hop: the preflight's advice
        # ("Stop them before the hop") is over once the hop is (#119).
        warning = history_warning(hop)
        if warning:
            state["history"][-1]["warning"] = warning
            host.log("WARNING: %s" % warning)
        state["current"] = hop["to"]
        state["hop"] = None
        state["phase"] = "IDLE"
        host.log("now on %s" % state["current"])
        if hop.get("cordonedOutside"):
            # Whoever drained the node uncordons it, maybe after more hops.
            host.log("Node %s is still cordoned: once it is back, run "
                     "`kubectl uncordon %s` and `kubectl label node %s %s-` "
                     "from a control plane"
                     % (self._node_name(), self._node_name(), self._node_name(),
                        LABEL_DRAINING))

    # --- rollback --------------------------------------------------------
    def rollback(self, state, reason):
        """First failure after a reboot: go back to the previous image once.
        The control plane stays on the new version, which is a supported skew
        for the older kubelet.

        Raises UpgradeError, with the state telling what really happened,
        when bootc cannot roll back (nothing changed: phase stays REBOOT) or
        the reboot fails (the rollback waits for the next boot: phase
        ROLLBACK_REBOOT). The driver turns either into a HOLD."""
        host, hop = self.host, state["hop"]
        host.log("rolling back to the previous image: %s" % reason)
        try:
            host.run(["bootc", "rollback"])
        except UpgradeError as exc:
            raise UpgradeError("the node is not healthy on %s (%s), and bootc "
                               "could not roll back: %s" % (hop["to"], reason, exc))
        # Record the rollback right away: a second `bootc rollback` would
        # flip the boot order back to the broken image, so nothing between
        # this call and the save may fail first.
        state["rollbacks"] = state.get("rollbacks", 0) + 1
        state["phase"] = "ROLLBACK_REBOOT"
        state["rollbackReason"] = reason
        self._save(state)
        backup = self._backup_dir(hop) + "/files"
        for path in ("/var/lib/kubelet/config.yaml",
                     "/var/lib/kubelet/kubeadm-flags.env"):
            try:
                if host.exists(backup + path):
                    host.copy(backup + path, path)
            except OSError as exc:
                # The reboot still goes: the old image is set for the next
                # boot. The kubelet may need this file put back by hand.
                host.log("rollback: could not restore %s from %s: %s"
                         % (path, backup, exc))
        self.stop_pods()
        try:
            host.run(["systemctl", "reboot"])
        except UpgradeError as exc:
            host.run(["systemctl", "start", "kubelet"], check=False, timeout=120)
            raise UpgradeError("%s is set for the next boot (the node was not "
                               "healthy: %s), but the reboot failed: %s; reboot "
                               "the node, then `k4all-upgrade clear-hold && "
                               "k4all-upgrade resume`"
                               % (hop["from"], reason, exc))

    # --- Kubernetes helpers ----------------------------------------------
    def kubeadm_from_staged(self, version):
        """The kubeadm binary of the staged image, so kubeadm always matches
        the image the node is about to boot. Falls back to dl.k8s.io with a
        checksum check."""
        host = self.host
        dest = "%s/bin/kubeadm-%s" % (STATE_DIR, version)
        if host.exists(dest) and self._kubeadm_is(dest, version):
            return host.path(dest)
        try:
            staged = _deployment(bootc_status(host), "staged") or {}
        except BootcBusy as exc:
            host.log("%s; kubeadm comes from dl.k8s.io" % exc)
            staged = {}
        checksum = (staged.get("ostree") or {}).get("checksum")
        if checksum:
            data = host.run_bytes(["ostree", "--repo=" + host.path(OSTREE_REPO),
                                   "cat", checksum, "/usr/bin/kubeadm"],
                                  timeout=300)
            if data:
                self._write_binary(dest, data)
                if self._kubeadm_is(dest, version):
                    return host.path(dest)
        host.log("kubeadm not readable from the staged image; downloading "
                 "v%s from dl.k8s.io" % version)
        base = "https://dl.k8s.io/release/v%s/bin/linux/%s/kubeadm" % (
            version, host.arch())
        # Whatever goes wrong with the download (URLError, socket.timeout,
        # http.client.IncompleteRead or BadStatusLine, a checksum file that
        # is not one) is an UpgradeError: the hop goes to HOLD with the
        # operator resumed, never out of the driver half way. The except is
        # this wide on purpose, and only around the two downloads.
        try:
            data = host.fetch(base, timeout=300)
            expected = host.fetch(base + ".sha256").decode().split()[0]
        except Exception as exc:  # pylint: disable=broad-except
            raise UpgradeError("cannot download kubeadm v%s: %s: %s"
                               % (version, type(exc).__name__, exc))
        if hashlib.sha256(data).hexdigest() != expected:
            raise UpgradeError("kubeadm v%s checksum mismatch" % version)
        self._write_binary(dest, data)
        if not self._kubeadm_is(dest, version):
            raise UpgradeError("downloaded kubeadm is not v%s" % version)
        return host.path(dest)

    def _write_binary(self, dest, data):
        full = self.host.path(dest)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "wb") as fh:
            fh.write(data)
        os.chmod(full, 0o755)

    def _kubeadm_is(self, path, version):
        out = self.host.run([self.host.path(path), "version", "-o", "short"],
                            check=False)
        return out.returncode == 0 and out.stdout.strip() == "v" + version

    def _preload_images(self, version, kubeadm):
        """Load the control-plane images shipped in the staged image, or pull
        them, so `kubeadm upgrade` does not wait on the network."""
        host = self.host
        try:
            staged = _deployment(bootc_status(host), "staged") or {}
        except BootcBusy as exc:
            host.log("%s; kubeadm pulls the control-plane images" % exc)
            staged = {}
        ostree = staged.get("ostree") or {}
        cache = "/sysroot/ostree/deploy/%s/deploy/%s.%s%s" % (
            ostree.get("stateroot", "default"), ostree.get("checksum", ""),
            ostree.get("deploySerial", 0), IMAGE_CACHE_DIR)
        loaded = self._load_images(cache) if ostree.get("checksum") else 0
        if not loaded:
            host.run([kubeadm, "config", "images", "pull",
                      "--kubernetes-version", "v" + version], check=False,
                     timeout=1800)

    def _load_images(self, directory):
        """`podman load` every image archive in directory (CRI-O shares the
        storage); return how many were loaded."""
        host = self.host
        if not host.exists(directory):
            return 0
        loaded = 0
        for name in sorted(os.listdir(host.path(directory))):
            if name.endswith(".tar"):
                host.run(["podman", "load", "-i",
                          host.path(directory + "/" + name)], check=False,
                         timeout=900)
                loaded += 1
        return loaded

    def _run_hooks(self, current, target, role):
        for minor, hooks in sorted(HOOKS_BEFORE_MINOR.items()):
            if k8s_minor(current) < minor <= k8s_minor(target):
                for hook in hooks:
                    hook(self, role)

    # --- manifest sync ---------------------------------------------------
    def sync_manifest(self, state=None):
        """Apply this image's ReleaseManifest to the cluster in two steps.

        1. Only the k4all-operator component, when it changes, so that the
           new operator (and its CRDs) is running before it sees the rest:
           an older operator would ignore upgradePath and jump components
           straight to their targets.
        2. Everything else, then wait until the components settle.

        Before step 2 the tool always waits for the operator the manifest
        pins, also when step 1 changed nothing: a SYNC resumed after a HOLD
        in step 1, or `k4all-upgrade sync-manifest`, finds the operator
        already changed in the cluster but maybe not running yet.
        ``state``: the hop's, where the components the operator reports
        Failed are kept while the sync waits (`status` shows them); None
        for `k4all-upgrade sync-manifest`. Returns the uninstalls the
        operator refuses (``_wait_components``).
        """
        host = self.host
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            raise UpgradeError("the ReleaseManifest sync needs the admin "
                               "kubeconfig (bootstrap node)")
        new = load_yaml_file(host, IMAGE_RELEASE_MANIFEST)
        # --ignore-not-found: no ReleaseManifest is rc 0 with nothing printed.
        # Any other answer is an error, not "there is none": a sync from the
        # new manifest alone would drop custom, Unmanaged and cluster-only
        # components.
        got = kubectl(host, kc, ["get", "releasemanifest", RELEASE_MANIFEST_NAME,
                                 "-o", "json", "--ignore-not-found"], check=False)
        if got.returncode != 0:
            raise UpgradeError("cannot read the ReleaseManifest: %s"
                               % (got.stderr or got.stdout or "").strip()[-300:])
        try:
            cluster = json.loads(got.stdout) if got.stdout.strip() else {}
        except ValueError as exc:
            raise UpgradeError("cannot read the ReleaseManifest: %s" % exc)
        # Before the operator may reconcile (pause annotation still on).
        self._hand_over_kube_vip(kc, cluster)
        merged = merge_release_manifest(cluster, new)
        # Component images ship in this image: a component the sync replaces
        # (ingress-nginx -> Traefik) then starts without waiting on a pull.
        self._load_images(IMAGE_CACHE_DIR)
        # The operator only reconciles once the pause annotation is gone.
        self.annotate(None)
        operator_step = operator_only_manifest(cluster, merged)
        operator = ((merged.get("spec") or {}).get("components") or {}).get(
            OPERATOR_COMPONENT) or {}
        want = operator.get("version")
        if operator.get("management") == "Unmanaged":
            # Whoever runs the operator by hand: its status never says
            # Installed, and waiting for it would end in a HOLD.
            host.log("ReleaseManifest sync 1/2: k4all-operator is Unmanaged, "
                     "not waited for")
            want = None
        if operator_step is not None:
            host.log("ReleaseManifest sync 1/2: k4all-operator %s" % want)
            self._set_operator(kc, cluster, operator_step)
        elif want:
            host.log("ReleaseManifest sync 1/2: k4all-operator %s already in "
                     "the manifest" % want)
        if want:
            self._wait_operator(kc, want)
        host.log("ReleaseManifest sync 2/2: components")
        self._apply(kc, merged)
        return self._wait_components(kc, state)

    def _hand_over_kube_vip(self, kc, cluster):
        """kube-vip's static-pod manifest belongs to the host: set the
        component Unmanaged in the cluster, as the bridge does on the
        bootstrap node. Operators up to v0.4.x write that manifest with the
        image alone whenever they apply kube-vip, and the API VIP goes away;
        step 1 starts the new operator on the cluster's manifest. Absent,
        Unmanaged or Removed entries stay as they are."""
        comp = (((cluster or {}).get("spec") or {}).get("components") or {}).get(
            KUBE_VIP_COMPONENT)
        if not isinstance(comp, dict) or \
                comp.get("management") in ("Unmanaged", "Removed"):
            return
        kubectl(self.host, kc, ["patch", "releasemanifest", RELEASE_MANIFEST_NAME,
                                "--type", "merge", "-p", json.dumps(
                                    {"spec": {"components": {KUBE_VIP_COMPONENT: {
                                        "management": "Unmanaged"}}}})])
        comp["management"] = "Unmanaged"
        self.host.log("kube-vip: management Unmanaged in the ReleaseManifest "
                      "(the host owns its manifest)")

    def _set_operator(self, kc, cluster, step):
        """Step 1: replace the k4all-operator component, and nothing else.

        Not with a server-side apply. An apply removes the fields its field
        manager applied before and leaves out now, and kubectl first moves
        the fields of a client-side `kubectl apply` (how deploy-operator.sh
        creates the ReleaseManifest) to that manager. Either way an apply of
        the operator alone removed every other component, with its custom
        map and Unmanaged choice: step 2 put them back from the copy read
        before step 1, unless the hop stopped in between. A JSON patch is an
        update: it changes that one component. Without a ReleaseManifest in
        the cluster there is nothing to lose and the apply creates it."""
        if not cluster:
            self._apply(kc, step)
            return
        spec = step["spec"]["components"][OPERATOR_COMPONENT]
        kubectl(self.host, kc, ["patch", "releasemanifest", RELEASE_MANIFEST_NAME,
                                "--type", "json", "-p", json.dumps(
                                    [{"op": "add", "value": spec,
                                      "path": "/spec/components/" +
                                              OPERATOR_COMPONENT}])])

    def _apply(self, kc, doc):
        kubectl(self.host, kc, ["apply", "--server-side", "--force-conflicts",
                                "--field-manager=" + FIELD_MANAGER, "-f", "-"],
                input_text=json.dumps(doc))

    def _deadline(self):
        return self.host.now() + datetime.timedelta(
            minutes=int(self.cfg["componentsTimeoutMinutes"]))

    def _wait_operator(self, kc, want):
        host, deadline = self.host, self._deadline()
        while True:
            cr = kubectl_json(host, kc, ["get", "releasemanifest",
                                         RELEASE_MANIFEST_NAME])
            st = ((cr.get("status") or {}).get("components") or {}).get(
                OPERATOR_COMPONENT) or {}
            # A Failed state may be retried by the operator (every ~5 min):
            # only the deadline turns it into a HOLD.
            if st.get("state") == "Installed" and (
                    _plain(want) in FLOATING_VERSIONS
                    or _plain(st.get("installedVersion")) == _plain(want)):
                rollout = kubectl(host, kc, ["-n", OPERATOR_NAMESPACE, "rollout",
                                             "status", "deployment/" +
                                             OPERATOR_DEPLOYMENT,
                                             "--timeout=60s"], check=False)
                # appliedHash is written only by the new operator, after its
                # first reconcile has adopted the installed components; the
                # second step must not arrive before that.
                if rollout.returncode == 0 and st.get("appliedHash") \
                        and self._operator_image_is(kc, want):
                    return
            if host.now() >= deadline:
                detail = (": %s" % st.get("message")) if st.get("message") else ""
                raise UpgradeError("k4all-operator %s not running after %s "
                                   "minutes (state %s)%s"
                                   % (want, self.cfg["componentsTimeoutMinutes"],
                                      st.get("state", "unknown"), detail))
            host.sleep(30)

    def _operator_image_is(self, kc, want):
        """True when the operator's Deployment runs the tag ``want`` (or
        when that cannot be told: a floating version, an image by digest)."""
        if _plain(want) in FLOATING_VERSIONS:
            return True
        got = kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "get",
                                      "deployment", OPERATOR_DEPLOYMENT, "-o",
                                      "json"], check=False)
        if got.returncode != 0:
            return False
        try:
            containers = (((json.loads(got.stdout).get("spec") or {}).get(
                "template") or {}).get("spec") or {}).get("containers") or []
        except ValueError:
            return False
        for ctr in containers:
            image = str(ctr.get("image", ""))
            if "k4all-operator" not in image:
                continue
            last = image.split("@")[0].rsplit("/", 1)[-1]
            if ":" not in last:
                return True
            return _plain(last.rsplit(":", 1)[1]) == _plain(want)
        return True

    def _wait_components(self, kc, state=None):
        """Wait until the components settle; the uninstalls the operator
        refuses, as "<component>: uninstall refused: <reason>".

        A component the operator reports Failed is retried by it, so the
        wait goes on until the deadline; each one is logged the first time
        it turns Failed, with the operator's message, and kept in the
        hop's "failedComponents" while it stays Failed (#131)."""
        host, deadline = self.host, self._deadline()
        logged = set()
        while True:
            cr = kubectl_json(host, kc, ["get", "releasemanifest",
                                         RELEASE_MANIFEST_NAME])
            settled, failed, waiting = components_settled(cr)
            messages = failed_component_messages(cr, failed)
            for name in failed:
                if name not in logged:
                    logged.add(name)
                    host.log("WARNING: ReleaseManifest sync: %s is Failed: %s "
                             "(the operator retries it; the sync waits until "
                             "%s)" % (name, messages[name] or "no message",
                                      deadline.isoformat(timespec="minutes")))
            self._keep_failed_components(state, messages)
            if settled:
                host.log("components reconciled")
                refused = ["%s: %s%s" % (name, UNINSTALL_REFUSED, reason)
                           for name, reason in uninstall_refusals(cr)]
                for line in refused:
                    host.log("WARNING: %s" % line)
                return refused
            # Failed components are retried by the operator; give up only at
            # the deadline.
            if host.now() >= deadline and failed:
                raise UpgradeError("components failed after the sync: %s"
                                   % ", ".join(failed))
            if host.now() >= deadline:
                raise UpgradeError("components still reconciling after %s "
                                   "minutes: %s"
                                   % (self.cfg["componentsTimeoutMinutes"],
                                      ", ".join(waiting)))
            host.sleep(30)

    def _keep_failed_components(self, state, messages):
        """Keep in the hop what is Failed now, for `status` (another
        process): saved when it changes."""
        hop = (state or {}).get("hop")
        if hop is None:
            return
        if (hop.get("failedComponents") or {}) == messages:
            return
        if messages:
            hop["failedComponents"] = messages
        else:
            hop.pop("failedComponents", None)
        save_state(self.host, state)

    # --- driver ----------------------------------------------------------
    STEPS = {
        "PREFLIGHT": ("preflight", "BACKUP"),
        "BACKUP": ("backup", "STAGE"),
        "STAGE": ("stage", "PRE_REBOOT"),
        "PRE_REBOOT": ("pre_reboot", "DRAIN"),
        "REBOOT": ("post_boot", "SYNC"),
        "SYNC": ("sync", "COMMIT"),
    }

    def drive(self, state, checked=False):
        """Run phases until the plan is done, the node reboots, or a HOLD.
        ``checked``: the plan was just made on the current upgrade graph."""
        host = self.host
        while True:
            if state.get("hold"):
                return state
            phase = state["phase"]
            if phase == "DONE":
                return state
            if phase == "IDLE":
                if not state["pending"]:
                    state["phase"] = "DONE"
                    self._save(state)
                    host.log("upgrade finished: %s" % state["current"])
                    return state
                if state["mode"] == "auto" and not self._auto_may_continue(state):
                    self._save(state)
                    return state
                if not checked:
                    checked = True
                    if self.check_plan(state):
                        continue
                start_next_hop(state)
                self._save(state)
                host.log("hop %s -> %s (%s)" % (state["hop"]["from"],
                                                 state["hop"]["to"],
                                                 state["hop"]["kind"]))
                continue
            if phase == "PREFLIGHT" and not checked:
                # a hop that waited (NotYet) or was on hold has not started
                checked = True
                if self.check_plan(state):
                    continue
            try:
                if phase == "ROLLBACK_REBOOT":
                    self.hold(state, "rolled back to %s after a failed reboot: "
                              "%s" % (state["hop"]["from"],
                                      state.get("rollbackReason", "")),
                              REASON_ROLLBACK_REBOOTED)
                    return state
                if phase == "COMMIT":
                    self.commit(state)
                elif phase == "DRAIN":
                    self.drain(state)
                    self.reboot(state)
                    return state
                elif phase in self.STEPS:
                    method, nxt = self.STEPS[phase]
                    getattr(self, method)(state)
                    state.pop("waiting", None)
                    state["phase"] = nxt
                else:
                    raise UpgradeError("unknown phase %s" % phase)
            except NotYet as exc:
                state["waiting"] = str(exc)
                self._save(state)
                # run: cmd_run (no plan left) or cmd_resume says what next
                host.log("not yet: %s%s" % (exc, how_it_goes_on(state)
                                             if state.get("mode") != "run" else ""))
                return state
            except RollbackNeeded as exc:
                if state.get("rollbacks", 0) == 0:
                    try:
                        self.rollback(state, str(exc))
                    except UpgradeError as err:
                        self.hold(state, str(err))
                    return state
                self.hold(state, str(exc))
                return state
            except UpgradeError as exc:
                self.hold(state, str(exc))
                return state
            self._save(state)

    def _auto_may_continue(self, state):
        nxt = state["pending"][0]["version"]
        if self.cfg["mode"] == "managed":
            self.host.log("mode is managed: the hops left by the timer wait "
                          "for the k4all-operator or `k4all-upgrade run`")
            return False
        if self.cfg["autoAllow"] != "minor" and \
                hop_kind(state["current"], nxt) != "patch":
            self.host.log("next hop %s -> %s is a minor: waiting for "
                          "`k4all-upgrade run`" % (state["current"], nxt))
            return False
        if not in_window(self.host.now(), self.cfg["window"]):
            self.host.log("outside the maintenance window")
            return False
        return True

    def check_plan(self, state):
        """Before a hop starts. A plan of the timer or of `run` may be days
        old (with autoAllow minor a hop waits for the next window): its next
        hop is checked on the graph the node would plan with now, and the
        plan is made again when that hop is no longer legal (a release
        blocked since, a patch that now ends the stream, a minFrom raised).
        A plan of `run` keeps its target and goes to HOLD when no path
        leads there any more; a plan of the timer is dropped when nothing
        is left that it may run. The k4all-operator plans again at every
        reconcile and the agent checks each hop: its plans are left alone.
        True when the plan changed."""
        if operator_driven(state):
            return False
        releases = self.graph_loader()
        why = stale_hop(releases, state)
        if why is None:
            return False
        host, current, nxt = self.host, state["current"], next_release(state)
        try:
            path = replan(releases, state, self.cfg["autoAllow"])
        except NoPathError as exc:
            if state["mode"] != "auto":
                self.hold(state, "%s, and no path leads to %s any more (%s): "
                          "abandon the plan with `k4all-upgrade clear-hold "
                          "--abandon`" % (why, state.get("target"), exc))
                return True
            path, why = [], "%s; no path left: %s" % (why, exc)
        else:
            if not path:
                why += ("; no hop is left that the timer may run (autoAllow "
                        "%s)" % self.cfg["autoAllow"])
        new = [r.version for r in path]
        state["history"].append({
            "from": current, "to": nxt,
            "result": "replanned" if path else "dropped", "reason": why,
            "plan": new, "at": host.now().isoformat(timespec="seconds")})
        state.update({"hop": None, "pending": [r.to_dict() for r in path],
                      "phase": "IDLE" if path else "DONE"})
        state.pop("waiting", None)
        if path:
            state["target"] = new[-1]
            host.log("plan changed: %s; new plan: %s"
                     % (why, " -> ".join([current] + new)))
        else:
            host.log("plan dropped: %s" % why)
        self._save(state)
        return True


def _same_image(deployment, ref):
    """True when a bootc deployment entry is the image ``ref`` names.

    The ref bootc keeps is compared first. Its imageDigest comes second: it
    is the digest of the manifest bootc pulled for this architecture, not of
    the multi-arch index that a release ref names (bootc 1.17, VM 953: every
    hop by index digest stopped in HOLD at STAGE)."""
    image, digest = deployment_image(deployment)
    if image == ref:
        return True
    if "@" in ref:
        return bool(digest) and ref.endswith("@" + digest)
    return False


BACKUP_FILES = ("/var/lib/kubelet/config.yaml",
                "/var/lib/kubelet/kubeadm-flags.env", KUBEADM_CONFIG_FILE,
                "/etc/k4all-config.yaml", "/etc/k4all-release.yaml",
                CONFIG_FILE)


# =========================================================================
# Hooks before entering a Kubernetes minor
# =========================================================================
V1BETA3 = "kubeadm.k8s.io/v1beta3"
V1BETA4 = "kubeadm.k8s.io/v1beta4"


def _args_to_list(args):
    if isinstance(args, dict):
        return [{"name": k, "value": str(v)} for k, v in sorted(args.items())]
    return args


def kubeadm_doc_to_v1beta4(doc):
    """Structural v1beta3 -> v1beta4 conversion of one kubeadm document.

    Unlike `kubeadm config migrate`, it adds no defaults (no new bootstrap
    token, advertise address, CRI socket, node name or version): the file
    keeps exactly what the node had, in the new shape.
    """
    if not isinstance(doc, dict) or doc.get("apiVersion") != V1BETA3:
        return doc, False
    doc["apiVersion"] = V1BETA4
    for section in ("apiServer", "controllerManager", "scheduler"):
        if isinstance(doc.get(section), dict) and "extraArgs" in doc[section]:
            doc[section]["extraArgs"] = _args_to_list(doc[section]["extraArgs"])
    local = (doc.get("etcd") or {}).get("local")
    if isinstance(local, dict) and "extraArgs" in local:
        local["extraArgs"] = _args_to_list(local["extraArgs"])
    reg = doc.get("nodeRegistration")
    if isinstance(reg, dict) and "kubeletExtraArgs" in reg:
        reg["kubeletExtraArgs"] = _args_to_list(reg["kubeletExtraArgs"])
    api = doc.get("apiServer")
    if isinstance(api, dict) and "timeoutForControlPlane" in api:
        value = api.pop("timeoutForControlPlane")
        if doc.get("kind") == "InitConfiguration":
            doc.setdefault("timeouts", {})["controlPlaneComponentHealthCheck"] = value
    discovery = doc.get("discovery")
    if isinstance(discovery, dict) and "timeout" in discovery:
        doc.setdefault("timeouts", {})["discovery"] = discovery.pop("timeout")
    return doc, True


def dump_yaml_docs(host, docs):
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return yaml.safe_dump_all(docs, sort_keys=False)
    except ImportError:
        parts = [host.run(["yq", "-P", "-o=yaml", "eval", "."],
                          input_text=json.dumps(d)).stdout for d in docs]
        return "---\n".join(parts)


def load_yaml_docs(host, text):
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return [d for d in yaml.safe_load_all(text) if d is not None]
    except ImportError:
        out = host.run(["yq", "-o=json", "-I=0", "eval", "."],
                       input_text=text).stdout
        return [json.loads(line) for line in out.splitlines() if line.strip()]


def rewrite_kubeadm_config_file(host, needles, transform, backup_suffix,
                                message):
    """Rewrite /etc/k8s-config.yaml, the kubeadm config the node was
    installed with (enable-cluster.sh and control-plane-utils still feed it
    to kubeadm). The file is read once, and parsed only when it contains
    one of ``needles``. ``transform(doc)`` changes one document in place
    and says whether it did. When one did, the file as it was stays next to
    it with ``backup_suffix`` and ``message`` is logged. A file that cannot
    be parsed is an UpgradeError (a HOLD). Returns True when written."""
    if not host.exists(KUBEADM_CONFIG_FILE):
        return False
    text = host.read(KUBEADM_CONFIG_FILE)
    if not any(needle in text for needle in needles):
        return False
    try:
        docs = load_yaml_docs(host, text)
    except Exception as exc:  # pylint: disable=broad-except
        raise UpgradeError("cannot parse %s: %s" % (KUBEADM_CONFIG_FILE, exc))
    changed = False
    for doc in docs:
        changed = bool(transform(doc)) or changed
    if not changed:
        return False
    host.copy(KUBEADM_CONFIG_FILE, KUBEADM_CONFIG_FILE + backup_suffix)
    host.write(KUBEADM_CONFIG_FILE, dump_yaml_docs(host, docs))
    host.log(message)
    return True


def hook_migrate_kubeadm_config_file(upgrader, role):
    """kubeadm 1.37 removes v1beta3: convert /etc/k8s-config.yaml. Runs
    with the kubeadm still installed (1.36), before the 1.37 apply."""
    rewrite_kubeadm_config_file(
        upgrader.host, (V1BETA3,), lambda doc: kubeadm_doc_to_v1beta4(doc)[1],
        ".v1beta3.bak", "converted %s to kubeadm v1beta4" % KUBEADM_CONFIG_FILE)


def drop_flexvolume(cluster_config):
    """Remove flex-volume-plugin-dir from a ClusterConfiguration dict.
    Returns True when something changed."""
    cm = (cluster_config or {}).get("controllerManager") or {}
    args = cm.get("extraArgs")
    changed = False
    if isinstance(args, list):
        kept = [a for a in args if a.get("name") != "flex-volume-plugin-dir"]
        changed = len(kept) != len(args)
        cm["extraArgs"] = kept
    elif isinstance(args, dict) and "flex-volume-plugin-dir" in args:
        del args["flex-volume-plugin-dir"]
        changed = True
    volumes = cm.get("extraVolumes")
    if isinstance(volumes, list):
        kept = [v for v in volumes
                if "kubelet-plugins/volume/exec" not in str(v.get("hostPath", ""))]
        changed = changed or len(kept) != len(volumes)
        cm["extraVolumes"] = kept
    return changed


def drop_flexvolume_from_file(host):
    """drop_flexvolume for /etc/k8s-config.yaml. The API version stays; the
    1.37 hop converts the file."""
    rewrite_kubeadm_config_file(
        host, ("flex-volume-plugin-dir", "kubelet-plugins/volume/exec"),
        lambda doc: isinstance(doc, dict)
        and doc.get("kind") == "ClusterConfiguration" and drop_flexvolume(doc),
        ".flexvolume.bak",
        "removed flex-volume-plugin-dir from %s" % KUBEADM_CONFIG_FILE)


def hook_drop_flexvolume(upgrader, role):
    """kubeadm 1.36 no longer mounts the flex-volume directory into the
    controller-manager: drop the flag from the cluster configuration before
    `kubeadm upgrade apply` regenerates the static pod, and from the node's
    own kubeadm config file."""
    host = upgrader.host
    drop_flexvolume_from_file(host)
    if role != "bootstrap":
        return
    cm = kubectl_json(host, ADMIN_KUBECONFIG,
                      ["-n", "kube-system", "get", "configmap", "kubeadm-config"])
    cfg = load_yaml_text(host, cm["data"]["ClusterConfiguration"])
    if not drop_flexvolume(cfg):
        return
    cm["data"]["ClusterConfiguration"] = json.dumps(cfg, indent=2)
    for field in ("resourceVersion", "uid", "creationTimestamp", "managedFields"):
        cm.get("metadata", {}).pop(field, None)
    kubectl(host, ADMIN_KUBECONFIG, ["replace", "-f", "-"],
            input_text=json.dumps(cm))
    host.log("removed flex-volume-plugin-dir from kubeadm-config")


HOOKS_BEFORE_MINOR = {
    # kubeadm 1.36 no longer mounts the flex-volume dir into the
    # controller-manager (kubernetes#136423)
    (1, 36): [hook_drop_flexvolume],
    # kubeadm 1.37 removes the v1beta3 config API (kubernetes#136016)
    (1, 37): [hook_migrate_kubeadm_config_file],
}


# =========================================================================
# Graph loading
# =========================================================================
def load_best_graph(host, cfg):
    """The published graph (with digests) when reachable, else the copy
    shipped in the image."""
    try:
        data = json.loads(host.fetch(cfg["graphUrl"]).decode())
        releases = load_graph(data)
        if releases:
            return releases
    except Exception as exc:  # pylint: disable=broad-except
        host.log("cannot fetch %s (%s); using the graph in the image"
                 % (cfg["graphUrl"], exc))
    if not host.exists(LOCAL_GRAPH_FILE):
        raise UpgradeError("no upgrade graph available")
    return load_graph(json.loads(host.read(LOCAL_GRAPH_FILE)))


def load_config(host):
    path = CONFIG_FILE if host.exists(CONFIG_FILE) else CONFIG_DEFAULT_FILE
    user = load_yaml_file(host, path) if host.exists(path) else {}
    return merge_config(user or {})


# =========================================================================
# CLI
# =========================================================================
# A HOLD in these phases comes before the reboot: the cluster is unchanged,
# so the operator paused for the hop runs again (see Upgrader.hold).
HOLD_RESUMES_OPERATOR = ("PREFLIGHT", "BACKUP", "STAGE", "PRE_REBOOT", "DRAIN")


class LockBusy(UpgradeError):
    """Another k4all-upgrade holds the lock."""


class Lock:
    """One k4all-upgrade at a time. ``wait`` seconds are spent retrying, so
    a short agent pass does not make `resume` or `run` fail."""

    def __init__(self, host, wait=0, name="lock"):
        self.host = host
        self.path = host.path(STATE_DIR + "/" + name)
        self.wait = wait
        self.fh = None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fh = open(self.path, "w", encoding="utf-8")
        deadline = self.host.now() + datetime.timedelta(seconds=self.wait)
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError as exc:
                if self.host.now() >= deadline:
                    self.fh.close()
                    raise LockBusy("another k4all-upgrade is running") from exc
            self.host.sleep(5)

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def uncommitted_release_line(state, booted):
    """The status line for a node that boots another release than the one
    it committed, after its plan is over; None when they are the same.

    Older: a rollback by hand. Newer: a hop that did not commit, which the
    node keeps when the hop is abandoned after its reboot (#112)."""
    committed = (state or {}).get("current")
    if not (committed and is_version(booted) and is_version(committed)):
        return None
    booted_key, committed_key = parse_version(booted), parse_version(committed)
    if booted_key < committed_key:
        return ("Rollback:  the last hop committed %s, the node runs %s (a "
                "rollback by hand?); plan and run start from %s"
                % (committed, booted, booted))
    if booted_key == committed_key:
        return None
    last = (state.get("history") or [{}])[-1]
    to = str(last.get("to") or "")
    if last.get("result") == "abandoned" and is_version(to) \
            and parse_version(to) == booted_key:
        why = "was abandoned after its reboot"
    else:
        why = "did not commit"
    return ("Committed: %s; the node runs %s, a newer release whose hop %s "
            "(not a rollback); plan and run start from %s"
            % (committed, booted, why, booted))


def cmd_status(host, cfg, args):
    state = load_state(host)
    try:
        version = current_version(host, timeout=BOOTC_STATUS_QUICK)
    except UpgradeError as exc:
        version = "unknown (%s)" % exc
    info = {"version": version, "mode": cfg["mode"], "autoAllow": cfg["autoAllow"],
            "window": cfg["window"], "state": state}
    if args.json:
        print(json.dumps(info, indent=2))
        return 0
    print("Release:   %s" % version)
    print("Policy:    mode=%s autoAllow=%s window=%s %s +%smin"
          % (cfg["mode"], cfg["autoAllow"], ",".join(cfg["window"]["days"]),
             cfg["window"]["start"], cfg["window"]["durationMinutes"]))
    if not state:
        print("Upgrade:   none")
        return 0
    if not _active(state):
        # A plan that is over stays in state.json: say so, and say when the
        # node no longer runs what it committed: an older release is a
        # `bootc rollback` by hand, a newer one a hop that was not committed
        # (abandoned after its reboot, #112).
        print("Upgrade:   none in progress (the last plan, to %s, is over)"
              % state.get("target"))
        pending = state.get("syncPending")
        if pending:
            print("Sync:      %s" % sync_pending_message(pending))
        else:
            line = uncommitted_release_line(state, version)
            if line:
                print(line)
        if state.get("abandoned"):
            print("Abandoned: %s" % abandoned_message(state["abandoned"]))
        last = (state.get("history") or [{}])[-1]
        if last.get("warning"):
            print("Warning:   %s (hop to %s)" % (last["warning"], last.get("to")))
        return 0
    print("Upgrade:   target %s, phase %s%s"
          % (state.get("target"), state.get("phase"),
             " (asked by the k4all-operator)" if operator_driven(state) else ""))
    if state.get("hop"):
        print("Hop:       %s -> %s (%s)" % (state["hop"]["from"], state["hop"]["to"],
                                           state["hop"]["kind"]))
    if state.get("pending"):
        print("Then:      %s" % " -> ".join(r["version"] for r in state["pending"]))
    warnings = hop_warnings(state.get("hop"))
    if warnings:
        print("Warning:   %s" % "; ".join(warnings))
    failed = (state.get("hop") or {}).get("failedComponents") or {}
    for name in sorted(failed):
        print("Failed:    %s: %s" % (name, failed[name] or "no message"))
    if state.get("hold"):
        print("HOLD:      %s" % state["hold"]["reason"])
    elif state.get("waiting"):
        print("Waiting:   %s%s" % (state["waiting"], how_it_goes_on(state)))
    if state.get("abandoned"):
        print("Abandoned: %s" % abandoned_message(state["abandoned"]))
    return 0


def _plan(host, cfg, args, upgrader):
    current = normalize_version(args.from_version) if args.from_version \
        else current_version(host)
    releases = upgrader.graph_loader()
    errors = validate_graph(releases)
    if errors:
        raise UpgradeError("the upgrade graph is invalid: %s" % "; ".join(errors))
    return current, plan_path(releases, current, args.to)


def cmd_plan(host, cfg, args, upgrader):
    current, path = _plan(host, cfg, args, upgrader)
    if not path:
        print("%s is already the latest reachable release" % current)
        return 0
    cur = current
    for rel in path:
        print("%s -> %s  [%s] Kubernetes %s, CRI-O %s, Fedora %d"
              % (cur, rel.version, hop_kind(cur, rel.version), rel.kubernetes,
                 rel.crio, rel.fedora))
        cur = rel.version
    pending = (load_state(host) or {}).get("syncPending")
    if pending:
        print("Not yet:   %s" % sync_pending_message(pending))
    return 0


def cmd_run(host, cfg, args, upgrader):
    state = load_state(host)
    if _active(state):
        raise UpgradeError("an upgrade is already in progress (phase %s); use "
                           "`k4all-upgrade resume` or `clear-hold`" % state["phase"])
    refuse_while_sync_pending(state)
    current, path = _plan(host, cfg, args, upgrader)
    if not path:
        host.log("%s is already the latest reachable release" % current)
        return 0
    host.log("plan: %s -> %s" % (current, " -> ".join(r.version for r in path)))
    if not args.yes:
        if not sys.stdin.isatty():
            raise UpgradeError("refusing to reboot without --yes")
        answer = input("The node will reboot %d time(s). Continue? [y/N] "
                       % len(path))
        if answer.strip().lower() not in ("y", "yes"):
            return 1
    previous = state
    state = new_state(args.to, "run", path, current, cfg["image"], previous)
    save_state(host, state)
    upgrader.drive(state, checked=True)
    if state.get("waiting") and state.get("phase") == "PREFLIGHT":
        # Nothing has started: leave no plan behind, the previous state
        # stays as it was.
        if previous is None:
            os.remove(host.path(state_path()))
        else:
            save_state(host, previous)
        upgrader.report(previous)
        host.log("the hop cannot start yet; nothing changed: start it again "
                 "with `k4all-upgrade run` once it can")
        return 3
    return 1 if state.get("hold") else 0


def cmd_auto(host, cfg, args, upgrader):
    if cfg["mode"] != "auto":
        return 0
    state = load_state(host)
    if _active(state):
        # A plan started by the timer continues between hops; anything else
        # (a manual run, a phase after a reboot) belongs to `resume`.
        if not state.get("hold") and state.get("mode") == "auto" \
                and state["phase"] in ("IDLE", "PREFLIGHT"):
            # a hop that waited (NotYet) starts only inside the window
            if state["phase"] == "PREFLIGHT" and not in_window(
                    host.now(), cfg["window"]):
                return 0
            upgrader.drive(state)
        return 0
    if not in_window(host.now(), cfg["window"]):
        return 0
    if (state or {}).get("syncPending"):
        host.log("auto: no new plan: %s"
                 % sync_pending_message(state["syncPending"]))
        return 0
    current, path = _plan(host, cfg, args, upgrader)
    path = auto_allowed(path, current, cfg["autoAllow"])
    if not path:
        return 0
    state = new_state(None, "auto", path, current, cfg["image"], state)
    save_state(host, state)
    upgrader.drive(state, checked=True)
    return 0


def cmd_resume(host, cfg, args, upgrader):
    """Continue a hop past its reboot; at boot (--boot) nothing else.

    A hop that has not started (IDLE, or PREFLIGHT while it waits) is not
    resume's at boot: a reboot for another reason must not start it outside
    the window, or after the k4all-operator gave it up. Run by hand, resume
    gives such a hop one try now, under the rules of whoever owns the plan:
    the timer's (mode auto, the window) or the operator's (upgrade-target
    still asks for it; else the plan is closed as stale)."""
    state = load_state(host)
    if not _active(state):
        return 0
    if state.get("hold"):
        host.log("on hold: %s" % state["hold"]["reason"])
        return 0
    if _parked(state):
        if args.boot:
            if state.get("waiting"):
                host.log("a hop waits: %s%s" % (state["waiting"],
                                               how_it_goes_on(state)))
            return 0
        if not _may_retry_parked(host, cfg, upgrader, state):
            return 0
    upgrader.drive(state)
    if state.get("waiting") and state.get("mode") == "run":
        host.log("the hop still waits%s" % how_it_goes_on(state))
    return 1 if state.get("hold") else 0


def _may_retry_parked(host, cfg, upgrader, state):
    """Whether `resume` may give a parked plan its one try now."""
    if state.get("mode") == "auto":
        if cfg["mode"] != "auto" or not in_window(host.now(), cfg["window"]):
            host.log("the hop waits for the window (mode %s): the timer starts "
                     "it" % cfg["mode"])
            return False
        return True
    if operator_driven(state):
        node, why = upgrader.read_node()
        if node is None:
            host.log("cannot read Node %s: %s" % (upgrader._node_name(), why))
            return False
        target = ((node.get("metadata") or {}).get("annotations") or {}).get(
            ANNOTATION_TARGET)
        hop_to = (state.get("hop") or {}).get("to") or state.get("target")
        if target is None or not same_target(target, hop_to):
            _close_stale_plan(host, state, "target removed")
            upgrader.report(state, node)
            host.log("the k4all-operator no longer asks for %s: plan closed"
                     % hop_to)
            return False
    return True


def cmd_clear_hold(host, cfg, args, upgrader):
    state = load_state(host)
    if not state:
        return 0
    if args.sync_done:
        pending = state.pop("syncPending", None)
        if pending:
            host.log("the sync of %s is marked done by hand: the next plan "
                     "starts from it" % pending["release"])
            save_state(host, state)
            upgrader.report(state)
        if not args.abandon:
            return 0
    if args.abandon:
        by_operator = operator_driven(state) and _active(state)
        target = (state.get("hop") or {}).get("to") or state.get("target")
        state["history"].append({"from": state.get("current"),
                                 "to": (state.get("hop") or {}).get("to"),
                                 "result": "abandoned",
                                 "at": host.now().isoformat(timespec="seconds")})
        try:
            booted = current_version(host)
        except UpgradeError:
            booted = None
        try:
            role = upgrader._role()
        except UpgradeError:
            role = None             # the sync would not have run either
        pending = sync_left_behind(state, booted, role)
        if pending:
            state["syncPending"] = {
                "release": pending,
                "at": host.now().isoformat(timespec="seconds")}
            host.log("WARNING: %s" % sync_pending_message(state["syncPending"]))
        if by_operator:
            # The operator retries by writing upgrade-target again; until
            # then the agent must not pick the abandoned target up.
            state["abandoned"] = {
                "from": state.get("current"), "target": target,
                "reason": (state.get("hold") or {}).get("reason"),
                "at": host.now().isoformat(timespec="seconds"),
                "targetRemoved": False}
        hop = state.get("hop") or {}
        replicas = hop.get("operatorReplicas")
        if not upgrader.resume_operator(hop):
            # Abandoning drops the hop and the replicas saved in it: say how
            # to bring the operator back by hand.
            print("k4all-upgrade: the k4all-operator is still at 0 replicas; "
                  "once the apiserver answers, run: kubectl -n %s scale "
                  "deployment %s --replicas=%s"
                  % (OPERATOR_NAMESPACE, OPERATOR_DEPLOYMENT, replicas),
                  file=sys.stderr)
        state.update({"hop": None, "pending": [], "phase": "DONE", "hold": None})
        upgrader.annotate(None)
        save_state(host, state)
        if by_operator:
            upgrader.drop_abandoned_target(state)
    else:
        state["hold"] = None
        save_state(host, state)
    upgrader.report(state)
    return 0


def _release_now(host, state):
    """The release to publish: the committed one while a plan is open,
    otherwise the one the node boots."""
    if _active(state):
        return state.get("current")
    try:
        return current_version(host, timeout=BOOTC_STATUS_QUICK)
    except UpgradeError:
        return (state or {}).get("current")


def _agent_may_start(state):
    """A hop is never interrupted, and resume owns every phase after a
    reboot: the agent may only (re)plan between hops."""
    if not _active(state):
        return True
    return not state.get("hold") and state.get("phase") in ("IDLE", "PREFLIGHT")


def _parked(state):
    """An open plan whose next hop has not started: IDLE between hops, or
    PREFLIGHT, where a hop waits (NotYet). Nothing on the node has changed
    for that hop yet."""
    return _active(state) and not state.get("hold") \
        and state.get("phase") in ("IDLE", "PREFLIGHT")


def how_it_goes_on(state):
    """What starts a hop that waits, as said next to its reason."""
    mode = (state or {}).get("mode")
    if mode == "auto":
        return ("; the timer tries again inside the window, or now: "
                "`k4all-upgrade resume`")
    if mode == "operator":
        return ("; the agent tries again every minute while upgrade-target "
                "asks for it")
    return "; try again with `k4all-upgrade resume`"


def _close_stale_plan(host, state, why):
    """An operator plan that never left PREFLIGHT, superseded by a new
    upgrade-target: forget it, so that resume does not run it at boot."""
    if _active(state) and operator_driven(state):
        state["history"].append({"from": state.get("current"),
                                 "to": state.get("target"), "result": why,
                                 "at": host.now().isoformat(timespec="seconds")})
        state.update({"hop": None, "pending": [], "phase": "DONE"})
        save_state(host, state)


def cmd_agent(host, cfg, args, upgrader):
    """One pass of k4all-upgrade-agent.timer.

    Publishes release, node type, the hop phase and, on x86_64, the CPU's
    x86-64 level on this Node, and runs the hop named by upgrade-target
    when it is one legal hop from the running release, in any mode and
    outside the window. Without a target it never starts anything.
    """
    role = node_role(host)
    if not upgrader._kubeconfig():
        return 0
    node, why = upgrader.read_node()
    if node is None:
        # The apiserver is down or restarting: try again next minute.
        host.log("agent: cannot read Node %s: %s" % (upgrader._node_name(), why))
        return 0
    observed = (node.get("metadata") or {}).get("annotations") or {}
    state = load_state(host)
    if state and state.get("hold") and state.get("hop") \
            and state["hop"].get("operatorReplicas") \
            and state.get("phase") in HOLD_RESUMES_OPERATOR:
        # The HOLD could not scale the operator back (apiserver down right
        # after kubeadm): retry now that the Node answers.
        if upgrader.resume_operator(state["hop"]):
            save_state(host, state)
    raw = observed.get(ANNOTATION_TARGET)
    abandoned = (state or {}).get("abandoned")
    if abandoned and not abandoned.get("targetRemoved") and raw is not None:
        if same_target(raw, abandoned.get("target")):
            upgrader.drop_abandoned_target(state, node)
            raw = None
        else:
            abandoned["targetRemoved"] = True       # a newer request
            save_state(host, state)
    problem = done = None
    if (raw is None or not str(raw).strip()) and operator_driven(state) \
            and _parked(state):
        # The operator gave the hop up (ClusterUpgrade cancelled) while it
        # waited: forget it, so that nothing starts it later.
        _close_stale_plan(host, state, "target removed")
    if raw is not None and str(raw).strip() and _agent_may_start(state):
        try:
            target = parse_target(raw)
            # Not even upgrade-done for the release the node boots: the
            # operator would take its hop as finished.
            refuse_while_sync_pending(state)
            current = current_version(host, timeout=BOOTC_STATUS_QUICK)
            if parse_version(target) == parse_version(current):
                done = target
            else:
                rel = check_single_hop(upgrader.graph_loader(), current, target)
                return _agent_start_hop(host, cfg, upgrader, state, current, rel)
        except (ValueError, UpgradeError, NoPathError) as exc:
            problem = str(exc)
            if not problem.startswith("upgrade-target"):
                problem = "upgrade-target %s: %s" % (str(raw).strip(), problem)
        _close_stale_plan(host, state, "superseded")
        if state and (done or problem) and state.get("abandoned"):
            state.pop("abandoned")
            save_state(host, state)
    want = node_report(state, role, _release_now(host, state), problem=problem,
                       target=raw, x86_64_level=node_x86_64_level(host))
    changes = annotation_changes(observed, want)
    if changes:
        if problem and observed.get(ANNOTATION_MESSAGE) != want[ANNOTATION_MESSAGE]:
            host.log("agent: HOLD: %s" % problem)
        if done and observed.get(ANNOTATION_DONE) != done:
            host.log("agent: already on %s: upgrade-done" % done)
        upgrader.patch_annotations(changes)
    node_settings_pass(host, upgrader, node, state)
    return 0


def _agent_start_hop(host, cfg, upgrader, old, current, rel):
    state = new_state(rel.version, "operator", [rel], current, cfg["image"], old)
    host.log("agent: the k4all-operator asks for %s -> %s" % (current, rel.version))
    save_state(host, state)
    upgrader.drive(state)
    return 1 if state.get("hold") else 0


def cmd_kube_vip_manifest(host, cfg, args, upgrader):
    """Print kube-vip's static pod for this node, or write it (--write).
    setup-k8s-ph3.sh (bootstrap, --before-init), the control planes' join
    script and every hop use this one generator. Exits 2 when something
    must be fixed first (the file is left as it is)."""
    version = args.kube_vip_version
    if version is not None and not is_version(version):
        raise UpgradeError("--version %r is not a kube-vip release (vX.Y.Z)"
                           % version)
    if version is not None:
        version = normalize_version(version)
    if not args.write:
        plan = upgrader.kube_vip_manifest(args.before_init, version)
        if plan.action == "warn":
            raise UpgradeError(plan.detail)
        if plan.action == "skip":
            host.log("kube-vip: nothing to write: %s" % plan.detail)
            return 0
        sys.stdout.write(dump_yaml_docs(host, [plan.want]))
        return 0
    with Lock(host, LOCK_WAIT, name="kube-vip.lock"):
        plan = upgrader.kube_vip_manifest(args.before_init, version)
        if plan.action == "warn":
            raise UpgradeError(plan.detail)
        if plan.action == "write":
            upgrader.write_kube_vip(plan)
        else:
            host.log("kube-vip: %s" % ("nothing to write: " + plan.detail
                                       if plan.action == "skip" else plan.detail))
    return 0


def cmd_sync_manifest(host, cfg, args, upgrader):
    upgrader.sync_manifest()
    state = load_state(host)
    if state and state.pop("syncPending", None):
        save_state(host, state)
        host.log("the sync an abandoned hop left behind is done")
        upgrader.report(state)
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="k4all-upgrade",
        description="Upgrade this k4all node one safe release hop at a time.")
    parser.add_argument("--root", default="/", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("status", help="show release, policy and upgrade state")
    p.add_argument("--json", action="store_true")
    for name, text in (("plan", "show the hops to a release"),
                       ("run", "upgrade now, rebooting as needed")):
        p = sub.add_parser(name, help=text)
        p.add_argument("--to", default="latest",
                       help="target release (default: latest)")
        p.add_argument("--from", dest="from_version",
                       help="override the detected current release")
        if name == "run":
            p.add_argument("--yes", action="store_true",
                           help="do not ask for confirmation")
    p = sub.add_parser("auto", help="used by k4all-upgrade.timer")
    p.add_argument("--to", default="latest", help=argparse.SUPPRESS)
    p.add_argument("--from", dest="from_version", help=argparse.SUPPRESS)
    p = sub.add_parser("resume", help="continue an upgrade (used at boot); "
                       "a hop that waits gets one try now")
    p.add_argument("--boot", action="store_true", help=argparse.SUPPRESS)
    sub.add_parser("agent", help="follow the k4all-operator's upgrade-target "
                   "(used by k4all-upgrade-agent.timer)")
    p = sub.add_parser("clear-hold", help="clear a HOLD after fixing its cause")
    p.add_argument("--abandon", action="store_true",
                   help="forget the remaining hops")
    p.add_argument("--sync-done", action="store_true",
                   help="forget the manifest sync that a hop abandoned after "
                   "its reboot left undone (once it was done otherwise)")
    sub.add_parser("sync-manifest",
                   help="apply this image's ReleaseManifest to the cluster")
    p = sub.add_parser("kube-vip-manifest",
                       help="print kube-vip's static pod for this control "
                       "plane (HA kube-vip), or write it")
    p.add_argument("--write", action="store_true",
                   help="write %s when it differs" % KUBE_VIP_MANIFEST)
    p.add_argument("--before-init", action="store_true",
                   help="on the bootstrap node before kubeadm init "
                   "(setup-k8s-ph3.sh): mount super-admin.conf, which init "
                   "writes")
    p.add_argument("--version", dest="kube_vip_version", metavar="VERSION",
                   help="the kube-vip release to write, when the release "
                   "manifest pins none (\"latest\" up to v2.3.0)")
    return parser


def main(argv=None, host=None):
    args = build_parser().parse_args(argv)
    host = host or Host(args.root)
    try:
        cfg = load_config(host)
        upgrader = Upgrader(host, cfg)
        if args.command == "status":
            return cmd_status(host, cfg, args)
        if args.command == "kube-vip-manifest":
            # no lock: one file, written atomically; also used before the
            # node has joined a cluster
            return cmd_kube_vip_manifest(host, cfg, args, upgrader)
        handlers = {"plan": cmd_plan, "run": cmd_run, "auto": cmd_auto,
                    "resume": cmd_resume, "clear-hold": cmd_clear_hold,
                    "sync-manifest": cmd_sync_manifest, "agent": cmd_agent}
        if args.command == "plan":
            return handlers["plan"](host, cfg, args, upgrader)
        if args.command == "agent":
            # Every minute: when a hop or a resume is running, it is the one
            # publishing the phases. Skip this pass.
            try:
                with Lock(host):
                    return cmd_agent(host, cfg, args, upgrader)
            except LockBusy:
                host.log("agent: another k4all-upgrade is running; skipped")
                return 0
        wait = RESUME_LOCK_WAIT if args.command == "resume" else LOCK_WAIT
        try:
            with Lock(host, wait):
                return handlers[args.command](host, cfg, args, upgrader)
        except LockBusy:
            if args.command != "auto":
                raise
            # The timer fired during a run or a resume: that one goes on, and
            # this pass is not a failure (it would show in systemctl --failed).
            host.log("auto: another k4all-upgrade is running; skipped")
            return 0
    except (UpgradeError, NoPathError) as exc:
        host.log("error: %s" % exc)
        return 2


if __name__ == "__main__":
    sys.exit(main())
