#!/usr/bin/env python3
# K4All node upgrade tool
# SPDX-License-Identifier: GPL-3.0-or-later
"""Walk k4all release hops on a bootc node without ever skipping a
Kubernetes minor.

Each hop goes through the same phases:

    PREFLIGHT -> BACKUP -> STAGE -> PRE_REBOOT -> DRAIN -> REBOOT
    -> POST_BOOT -> COMMIT

The new image is staged with ``bootc switch --download-only``. When the hop
changes Kubernetes, the control plane is upgraded with the kubeadm taken from
the staged image *before* the reboot, so the kubelet is never newer than the
apiserver. The reboot then brings kubelet and CRI-O to the new version.

State lives in /var/lib/k4all/upgrade/state.json (/var survives switch and
rollback). ``k4all-upgrade resume`` runs at boot and continues the hop.
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.request

TOOL_VERSION = "1"
CAPABILITIES = ["stage-download-only", "kubeadm-from-staged", "sync-manifest",
                "node-annotation"]

STATE_DIR = "/var/lib/k4all/upgrade"
CONFIG_FILE = "/etc/k4all-upgrade.yaml"
CONFIG_DEFAULT_FILE = "/usr/local/share/k4all-upgrade.yaml.default"
LOCAL_GRAPH_FILE = "/usr/local/share/k4all-upgrade/releases.json"
VERSION_FILE = "/usr/local/share/k4all-upgrade/version"
IMAGE_RELEASE_MANIFEST = "/usr/local/share/k4all-release.yaml"
NODE_TYPE_FILE = "/etc/node-type"
ADMIN_KUBECONFIG = "/etc/kubernetes/admin.conf"
KUBELET_KUBECONFIG = "/etc/kubernetes/kubelet.conf"
KUBEADM_CONFIG_FILE = "/etc/k8s-config.yaml"
OSTREE_REPO = "/sysroot/ostree/repo"
IMAGE_CACHE_DIR = "/usr/local/share/k4all-images"

ANNOTATION_IN_PROGRESS = "k4all.magesgate.com/upgrade-in-progress"
RELEASE_MANIFEST_NAME = "k4all"
FIELD_MANAGER = "k4all-upgrade"
OPERATOR_COMPONENT = "k4all-operator"
OPERATOR_NAMESPACE = "k4all-operator-system"
OPERATOR_DEPLOYMENT = "k4all-operator-controller-manager"

DEFAULT_CONFIG = {
    # auto: the timer runs allowed hops inside the window
    # manual: only `k4all-upgrade run` starts hops
    # managed: the k4all-operator drives upgrades; the timer does nothing
    "mode": "auto",
    # patch: only patch hops run automatically; minor: every hop
    "autoAllow": "patch",
    "window": {"days": ["Sat"], "start": "02:30", "durationMinutes": 120},
    "graphUrl": ("https://github.com/gpillon/k4all/releases/latest/download/"
                 "upgrade-graph.json"),
    "image": "ghcr.io/gpillon/k4all-bootc",
    "postBootTimeoutMinutes": 20,
    "componentsTimeoutMinutes": 45,
    "drainTimeoutMinutes": 15,
    "minFreeSysrootGiB": 3,
    "minFreeVarGiB": 2,
}

PHASES = ["PREFLIGHT", "BACKUP", "STAGE", "PRE_REBOOT", "DRAIN", "REBOOT",
          "SYNC", "COMMIT"]
VALID_MODES = ("auto", "manual", "managed")
VALID_ALLOW = ("patch", "minor")
DAY_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]


class UpgradeError(Exception):
    """A step failed in a way that needs a human; the hop goes to HOLD."""


class NoPathError(Exception):
    """No safe sequence of releases reaches the requested target."""


class RollbackNeeded(UpgradeError):
    """The node booted the new image but is not healthy."""


# =========================================================================
# Versions
# =========================================================================
_VERSION_RE = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?$")


def parse_version(text):
    """Return a sortable key for a k4all release version (semver)."""
    match = _VERSION_RE.match(str(text).strip())
    if not match:
        raise ValueError("not a release version: %r" % (text,))
    major, minor, patch, pre = match.groups()
    if pre is None:
        pre_key = (1,)
    else:
        ids = []
        for part in pre.split("."):
            ids.append((0, int(part), "") if part.isdigit() else (1, 0, part))
        pre_key = (0, tuple(ids))
    return (int(major), int(minor), int(patch), pre_key)


def is_version(text):
    try:
        parse_version(text)
        return True
    except ValueError:
        return False


def normalize_version(text):
    text = str(text).strip()
    return text if text.startswith("v") else "v" + text


def stream_of(version):
    """The X.Y stream a release belongs to."""
    key = parse_version(version)
    return key[0], key[1]


def hop_kind(from_version, to_version):
    """A hop is 'patch' inside one X.Y stream, 'minor' otherwise."""
    return "patch" if stream_of(from_version) == stream_of(to_version) else "minor"


def k8s_minor(version):
    """(major, minor) of a Kubernetes version such as 'v1.35.7' or '1.35'."""
    match = re.match(r"^v?(\d+)\.(\d+)", str(version).strip())
    if not match:
        raise ValueError("not a Kubernetes version: %r" % (version,))
    return int(match.group(1)), int(match.group(2))


def k8s_key(version):
    match = re.match(r"^v?(\d+)\.(\d+)(?:\.(\d+))?", str(version).strip())
    if not match:
        raise ValueError("not a Kubernetes version: %r" % (version,))
    return tuple(int(x or 0) for x in match.groups())


# =========================================================================
# Release graph
# =========================================================================
class Release:
    """One entry of the upgrade graph."""

    FIELDS = ("version", "kind", "minFrom", "kubernetes", "crio", "fedora")

    def __init__(self, data):
        missing = [f for f in self.FIELDS if data.get(f) in (None, "")]
        if missing:
            raise ValueError("release %s is missing %s"
                             % (data.get("version", "?"), ", ".join(missing)))
        self.version = normalize_version(data["version"])
        self.kind = str(data["kind"])
        self.min_from = normalize_version(data["minFrom"])
        self.kubernetes = str(data["kubernetes"]).lstrip("v")
        self.crio = str(data["crio"])
        self.fedora = int(data["fedora"])
        self.sync_manifest = bool(data.get("syncManifest", False))
        self.blocked = bool(data.get("blocked", False))
        self.digest = data.get("digest") or ""
        self.notes = data.get("notes", "")
        self.key = parse_version(self.version)
        self.min_from_key = parse_version(self.min_from)

    def image_ref(self, image):
        if self.digest:
            return "%s@%s" % (image, self.digest)
        return "%s:%s" % (image, self.version)

    def to_dict(self):
        out = {"version": self.version, "kind": self.kind,
               "minFrom": self.min_from, "kubernetes": self.kubernetes,
               "crio": self.crio, "fedora": self.fedora,
               "syncManifest": self.sync_manifest, "blocked": self.blocked}
        if self.digest:
            out["digest"] = self.digest
        if self.notes:
            out["notes"] = self.notes
        return out

    def __repr__(self):
        return "Release(%s)" % self.version


def load_graph(data):
    """Parse a graph document ({"releases": [...]} or a bare list)."""
    entries = data.get("releases", []) if isinstance(data, dict) else data
    releases = sorted((Release(e) for e in entries), key=lambda r: r.key)
    return releases


def validate_graph(releases):
    """Return a list of violations of the k4all versioning rules."""
    errors = []
    seen = set()
    previous = None
    for rel in releases:
        if rel.version in seen:
            errors.append("%s appears twice" % rel.version)
        seen.add(rel.version)
        if rel.kind not in ("minor", "patch"):
            errors.append("%s: kind must be minor or patch" % rel.version)
        if rel.min_from_key >= rel.key:
            errors.append("%s: minFrom must be older than the release" % rel.version)
        if rel.kind == "minor" and rel.key[2] != 0:
            errors.append("%s: a minor release must be X.Y.0" % rel.version)
        if rel.kind == "patch" and rel.key[2] == 0 and previous is not None \
                and stream_of(previous.version) != stream_of(rel.version):
            errors.append("%s: X.Y.0 opening a new stream must be a minor"
                          % rel.version)
        if rel.kind == "patch" and previous is not None \
                and stream_of(previous.version) == stream_of(rel.version):
            stream_start = parse_version("v%d.%d.0" % stream_of(rel.version))
            if rel.min_from_key < stream_start:
                errors.append("%s: a patch must have minFrom >= %d.%d.0"
                              % ((rel.version,) + stream_of(rel.version)))
        try:
            if k8s_minor(rel.crio) > k8s_minor(rel.kubernetes):
                errors.append("%s: CRI-O %s is newer than Kubernetes %s"
                              % (rel.version, rel.crio, rel.kubernetes))
        except ValueError as exc:
            errors.append("%s: %s" % (rel.version, exc))
        if previous is not None:
            errors.extend(_validate_step(previous, rel))
        # A minor release may not be skipped: no other minor release lies
        # strictly between minFrom and the release.
        for other in releases:
            if other.kind == "minor" and rel.min_from_key < other.key < rel.key:
                errors.append("%s: minFrom %s skips minor release %s"
                              % (rel.version, rel.min_from, other.version))
        previous = rel
    return errors


def _validate_step(prev, rel):
    errors = []
    prev_k8s, rel_k8s = k8s_minor(prev.kubernetes), k8s_minor(rel.kubernetes)
    if rel_k8s[1] - prev_k8s[1] > 1 or rel_k8s[0] != prev_k8s[0]:
        errors.append("%s: Kubernetes jumps from %s to %s"
                      % (rel.version, prev.kubernetes, rel.kubernetes))
    if rel_k8s < prev_k8s:
        errors.append("%s: Kubernetes goes backwards" % rel.version)
    k8s_changed = rel_k8s != prev_k8s
    fedora_changed = rel.fedora != prev.fedora
    crio_changed = k8s_minor(rel.crio) != k8s_minor(prev.crio)
    if k8s_changed and fedora_changed:
        errors.append("%s: changes Kubernetes minor and Fedora together"
                      % rel.version)
    if rel.kind == "patch" and (k8s_changed or fedora_changed or crio_changed):
        errors.append("%s: a patch cannot change Kubernetes minor, Fedora or "
                      "CRI-O minor" % rel.version)
    if k8s_minor(prev.crio) == prev_k8s and k8s_minor(rel.crio) != rel_k8s:
        errors.append("%s: CRI-O %s no longer matches Kubernetes %s"
                      % (rel.version, rel.crio, rel.kubernetes))
    return errors


def plan_path(releases, current, target=None):
    """Return the releases to visit, in order, from ``current`` to ``target``.

    Rules: never skip a minor release (minFrom), finish the current X.Y
    stream before crossing into the next one, and never pick a blocked
    release.
    """
    usable = [r for r in releases if not r.blocked]
    if not usable:
        raise NoPathError("the upgrade graph has no usable release")
    cur_key = parse_version(current)
    if target in (None, "", "latest"):
        target_rel = max(usable, key=lambda r: r.key)
    else:
        target_key = parse_version(normalize_version(target))
        matches = [r for r in usable if r.key == target_key]
        if not matches:
            raise NoPathError("release %s is not in the upgrade graph or is "
                              "blocked" % normalize_version(target))
        target_rel = matches[0]
    if target_rel.key <= cur_key:
        return []
    minors = [r for r in releases if r.kind == "minor"]
    path = []
    cur_version = normalize_version(current)
    while cur_key < target_rel.key:
        options = [r for r in usable
                   if cur_key < r.key <= target_rel.key
                   and r.min_from_key <= cur_key
                   and not any(cur_key < m.key < r.key for m in minors)]
        if not options:
            raise NoPathError("no release can be reached from %s on the way "
                              "to %s" % (cur_version, target_rel.version))
        same_stream = [r for r in options
                       if stream_of(r.version) == stream_of(cur_version)]
        crossing = [r for r in options
                    if stream_of(r.version) != stream_of(cur_version)]
        newer_in_stream = [r for r in usable
                           if stream_of(r.version) == stream_of(cur_version)
                           and r.key > cur_key and r.min_from_key <= cur_key]
        if crossing and newer_in_stream and not same_stream:
            raise NoPathError("cannot leave %s before reaching the latest "
                              "patch of its stream" % cur_version)
        if same_stream and crossing:
            nxt = max(same_stream, key=lambda r: r.key)
        else:
            nxt = max(options, key=lambda r: r.key)
        path.append(nxt)
        cur_key, cur_version = nxt.key, nxt.version
    return path


def auto_allowed(path, current, allow):
    """Keep the leading hops that the automatic policy may run."""
    allowed = []
    cur = current
    for rel in path:
        if allow != "minor" and hop_kind(cur, rel.version) != "patch":
            break
        allowed.append(rel)
        cur = rel.version
    return allowed


# =========================================================================
# Policy
# =========================================================================
def merge_config(user):
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    for key, value in (user or {}).items():
        if key == "window" and isinstance(value, dict):
            cfg["window"].update(value)
        else:
            cfg[key] = value
    if cfg["mode"] not in VALID_MODES:
        raise UpgradeError("mode must be one of %s" % ", ".join(VALID_MODES))
    if cfg["autoAllow"] not in VALID_ALLOW:
        raise UpgradeError("autoAllow must be one of %s" % ", ".join(VALID_ALLOW))
    for day in cfg["window"]["days"]:
        if day not in DAY_NAMES:
            raise UpgradeError("unknown window day %r (use %s)"
                               % (day, ", ".join(DAY_NAMES)))
    _parse_hhmm(cfg["window"]["start"])
    return cfg


def _parse_hhmm(text):
    match = re.match(r"^(\d{1,2}):(\d{2})$", str(text))
    if not match or int(match.group(1)) > 23 or int(match.group(2)) > 59:
        raise UpgradeError("window start must be HH:MM, got %r" % (text,))
    return int(match.group(1)), int(match.group(2))


def in_window(now, window):
    """True when ``now`` (local, naive) falls inside a maintenance window.

    A window that starts late on one day may continue past midnight.
    """
    hour, minute = _parse_hhmm(window["start"])
    length = datetime.timedelta(minutes=int(window["durationMinutes"]))
    for days_back in (0, 1):
        day = (now - datetime.timedelta(days=days_back)).date()
        if DAY_NAMES[day.weekday()] not in window["days"]:
            continue
        start = datetime.datetime.combine(day, datetime.time(hour, minute))
        if start <= now < start + length:
            return True
    return False


def next_window_start(now, window, not_before=None):
    """First window start at or after ``max(now, not_before)``."""
    hour, minute = _parse_hhmm(window["start"])
    base = max(now, not_before) if not_before else now
    for offset in range(0, 15):
        day = (base + datetime.timedelta(days=offset)).date()
        if DAY_NAMES[day.weekday()] not in window["days"]:
            continue
        start = datetime.datetime.combine(day, datetime.time(hour, minute))
        if start >= base:
            return start
    return None


# =========================================================================
# ReleaseManifest sync
# =========================================================================
def merge_release_manifest(cluster_cr, new_manifest):
    """Build the ReleaseManifest to apply after a hop.

    The new release decides every component spec, except that the cluster
    keeps its ``custom`` map and any ``management: Unmanaged`` choice.
    Components that the new manifest no longer lists are left untouched;
    removal is always explicit (``management: Removed``).
    """
    merged = json.loads(json.dumps(new_manifest))
    merged.setdefault("metadata", {})["name"] = RELEASE_MANIFEST_NAME
    for field in ("resourceVersion", "uid", "creationTimestamp",
                  "managedFields", "generation", "annotations"):
        merged["metadata"].pop(field, None)
    merged.pop("status", None)
    cluster_components = ((cluster_cr or {}).get("spec") or {}).get(
        "components") or {}
    components = merged.setdefault("spec", {}).setdefault("components", {})
    for name, spec in components.items():
        old = cluster_components.get(name) or {}
        if old.get("custom"):
            spec["custom"] = old["custom"]
        if old.get("management") == "Unmanaged":
            spec["management"] = "Unmanaged"
    for name, old in cluster_components.items():
        if name not in components:
            components[name] = old
    return merged


def operator_only_manifest(cluster_cr, merged):
    """The first sync step: only the k4all-operator component, or None when
    the operator does not change."""
    new = ((merged.get("spec") or {}).get("components") or {}).get(
        OPERATOR_COMPONENT)
    if not new:
        return None
    old = (((cluster_cr or {}).get("spec") or {}).get("components") or {}).get(
        OPERATOR_COMPONENT) or {}
    keys = ("version", "source", "sources", "versionUrl")
    if all(old.get(k) == new.get(k) for k in keys):
        return None
    return {"apiVersion": merged.get("apiVersion"), "kind": merged.get("kind"),
            "metadata": {"name": RELEASE_MANIFEST_NAME},
            "spec": {"components": {OPERATOR_COMPONENT: new}}}


FLOATING_VERSIONS = ("", "latest", "master", "main")
BUSY_STATES = ("Pending", "Installing", "Upgrading", "Uninstalling")


def _plain(version):
    return str(version or "").strip().lstrip("v")


def components_settled(cr):
    """(settled, failed, waiting) for a ReleaseManifest after a sync.

    A component is settled when the operator reports it in a final state
    and, for a pinned version, has installed exactly that version.
    """
    spec = ((cr or {}).get("spec") or {}).get("components") or {}
    status = (cr or {}).get("status") or {}
    observed = status.get("components") or {}
    failed, waiting = [], []
    for name, comp in sorted(spec.items()):
        management = comp.get("management") or "Managed"
        if management == "Unmanaged":
            continue
        st = observed.get(name) or {}
        state = st.get("state")
        if state == "Failed":
            failed.append(name)
            continue
        if management == "Removed":
            if state not in ("Removed", None):
                waiting.append(name)
            continue
        if state in BUSY_STATES or state is None:
            waiting.append(name)
            continue
        want = _plain(comp.get("version"))
        if state == "Installed" and want not in FLOATING_VERSIONS \
                and _plain(st.get("installedVersion")) != want:
            waiting.append(name)
    for cond in status.get("conditions") or []:
        if cond.get("type") == "Ready" and cond.get("status") != "True" \
                and cond.get("reason") == "UpgradeInProgress":
            waiting.append("(operator paused: %s)" % cond.get("message", ""))
    return (not failed and not waiting), failed, waiting


# =========================================================================
# Host access
# =========================================================================
# bootc commands that change deployments. They run as a transient systemd unit
# so that /usr/bin/bootc (install_exec_t) enters the install_t SELinux domain,
# as it does under bootc's own services. Started from this tool, which runs as
# unconfined_service_t, bootc stays in that domain, which lacks mac_admin: the
# kernel then refuses file labels the running policy does not know yet, and a
# new Fedora's policy brings new ones. Seen on F43 -> F45:
# "fsetxattr(security.selinux): Invalid argument".
# No --pipe: from a service, with this tool's stdout and stderr as pipes,
# systemd refuses them ("Failed to start transient service unit: Connection
# reset by peer"). bootc's output goes to the unit's journal instead, which
# Host.run reads back when the command fails.
BOOTC_VIA_SYSTEMD = ("switch", "upgrade", "rollback")


def via_systemd(argv, timeout=None):
    """Wrap deployment-changing bootc commands in systemd-run."""
    if len(argv) < 2 or argv[0] != "bootc" or argv[1] not in BOOTC_VIA_SYSTEMD:
        return argv
    wrapped = ["systemd-run", "--wait", "--collect", "--quiet",
               "--unit", "k4all-bootc-%s-%d" % (argv[1], os.getpid())]
    if timeout:
        # Stop the unit too if this tool gives up waiting for it.
        wrapped += ["--property", "RuntimeMaxSec=%d" % int(timeout)]
    return wrapped + ["--", "/usr/bin/bootc"] + list(argv[1:])


class Host:
    """Everything that touches the machine goes through this class, so the
    tests can replace it."""

    def __init__(self, root="/"):
        self.root = root

    # --- files -----------------------------------------------------------
    def path(self, p):
        if self.root in ("", "/"):
            return p
        return os.path.join(self.root, p.lstrip("/"))

    def exists(self, p):
        return os.path.exists(self.path(p))

    def read(self, p):
        with open(self.path(p), encoding="utf-8") as fh:
            return fh.read()

    def write(self, p, text, mode=0o644):
        full = self.path(p)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        tmp = full + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, full)

    def copy(self, src, dst):
        os.makedirs(os.path.dirname(self.path(dst)), exist_ok=True)
        shutil.copy2(self.path(src), self.path(dst))

    def free_gib(self, p):
        target = self.path(p)
        while not os.path.exists(target):
            target = os.path.dirname(target) or "/"
        return shutil.disk_usage(target).free / (1024 ** 3)

    # --- processes -------------------------------------------------------
    def run(self, argv, check=True, input_text=None, timeout=None):
        argv = via_systemd(argv, timeout)
        proc = subprocess.run(argv, input=input_text, capture_output=True,
                              text=True, timeout=timeout)
        if check and proc.returncode != 0:
            detail = (proc.stderr or proc.stdout).strip()
            if argv[0] == "systemd-run" and "--unit" in argv:
                # bootc wrote to its transient unit's journal
                unit = argv[argv.index("--unit") + 1]
                journal = subprocess.run(
                    ["journalctl", "-u", unit, "-o", "cat", "--no-pager",
                     "-n", "40"], capture_output=True, text=True, check=False)
                detail = (detail + "\n" + journal.stdout).strip()
            raise UpgradeError("%s failed (rc=%d): %s"
                               % (" ".join(argv), proc.returncode, detail[-800:]))
        return proc

    def run_bytes(self, argv, timeout=None):
        """Run a command and return its raw stdout, or b"" on failure."""
        proc = subprocess.run(argv, capture_output=True, timeout=timeout,
                              check=False)
        return proc.stdout if proc.returncode == 0 else b""

    def now(self):
        return datetime.datetime.now()

    def sleep(self, seconds):
        time.sleep(seconds)

    def hostname(self):
        # kubeadm registers the node under the lowercased os hostname
        return socket.gethostname().strip().lower()

    def arch(self):
        machine = platform.machine()
        return {"x86_64": "amd64", "aarch64": "arm64"}.get(machine, machine)

    def fetch(self, url, timeout=20):
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return resp.read()

    def log(self, message):
        print("[k4all-upgrade] %s" % message, flush=True)


def load_yaml_text(host, text):
    """Parse YAML with PyYAML when present, otherwise through yq."""
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return yaml.safe_load(text)
    except ImportError:
        out = host.run(["yq", "-o=json", "eval", "."], input_text=text).stdout
        return json.loads(out) if out.strip() else None


def load_yaml_file(host, path):
    return load_yaml_text(host, host.read(path))


# =========================================================================
# Facts about the node
# =========================================================================
def bootc_status(host):
    return json.loads(host.run(["bootc", "status", "--json"]).stdout)


def _deployment(status, which):
    return ((status or {}).get("status") or {}).get(which)


def deployment_image(entry):
    image = (entry or {}).get("image") or {}
    ref = (image.get("image") or {}).get("image", "")
    return ref, image.get("imageDigest", "")


def version_from_ref(ref):
    """'ghcr.io/x/k4all-bootc:v2.2.3-amd64' -> 'v2.2.3'."""
    if ":" not in ref.rsplit("/", 1)[-1]:
        return None
    tag = ref.rsplit(":", 1)[1]
    tag = re.sub(r"-(amd64|arm64|x86_64|aarch64)$", "", tag)
    return normalize_version(tag) if is_version(tag) else None


def current_version(host, status=None):
    """The k4all release the node is booted into."""
    if host.exists(VERSION_FILE):
        text = host.read(VERSION_FILE).strip()
        if is_version(text):
            return normalize_version(text)
    if host.exists(IMAGE_RELEASE_MANIFEST):
        try:
            manifest = load_yaml_file(host, IMAGE_RELEASE_MANIFEST) or {}
            tag = str(((manifest.get("spec") or {}).get("osImage") or {})
                      .get("imageTag", ""))
            tag = re.sub(r"-(amd64|arm64)$", "", tag)
            if is_version(tag):
                return normalize_version(tag)
        except (UpgradeError, ValueError, OSError):
            pass
    status = status if status is not None else bootc_status(host)
    ref, _ = deployment_image(_deployment(status, "booted"))
    version = version_from_ref(ref)
    if version:
        return version
    raise UpgradeError("cannot tell which k4all release this node runs; pass "
                       "--from vX.Y.Z")


def node_role(host):
    if not host.exists(NODE_TYPE_FILE):
        raise UpgradeError("%s is missing" % NODE_TYPE_FILE)
    role = host.read(NODE_TYPE_FILE).strip()
    if role not in ("bootstrap", "control", "worker"):
        raise UpgradeError("unknown node type %r in %s" % (role, NODE_TYPE_FILE))
    return role


def kubelet_version(host):
    out = host.run(["kubelet", "--version"]).stdout
    match = re.search(r"v(\d+\.\d+\.\d+)", out)
    if not match:
        raise UpgradeError("cannot parse kubelet version from %r" % out)
    return match.group(1)


def kubeconfig_for(host, role):
    if role in ("bootstrap", "control") and host.exists(ADMIN_KUBECONFIG):
        return ADMIN_KUBECONFIG
    if host.exists(KUBELET_KUBECONFIG):
        return KUBELET_KUBECONFIG
    return None


def kubectl(host, kubeconfig, args, check=True, input_text=None):
    return host.run(["kubectl", "--kubeconfig", host.path(kubeconfig)] + args,
                    check=check, input_text=input_text)


def kubectl_json(host, kubeconfig, args):
    return json.loads(kubectl(host, kubeconfig, args + ["-o", "json"]).stdout)


def server_version(host, kubeconfig):
    out = kubectl(host, kubeconfig, ["version", "-o", "json"]).stdout
    git = (json.loads(out).get("serverVersion") or {}).get("gitVersion", "")
    return git.lstrip("v")


def node_ready(node):
    for cond in (node.get("status") or {}).get("conditions") or []:
        if cond.get("type") == "Ready":
            return cond.get("status") == "True"
    return False


def cluster_kubernetes_version(host, kubeconfig):
    cm = kubectl_json(host, kubeconfig,
                      ["-n", "kube-system", "get", "configmap", "kubeadm-config"])
    cfg = load_yaml_text(host, cm.get("data", {}).get("ClusterConfiguration", ""))
    return str((cfg or {}).get("kubernetesVersion", "")).lstrip("v")


# =========================================================================
# State
# =========================================================================
def state_path():
    return STATE_DIR + "/state.json"


def load_state(host):
    if not host.exists(state_path()):
        return None
    return json.loads(host.read(state_path()))


def save_state(host, state):
    state["updatedAt"] = host.now().isoformat(timespec="seconds")
    host.write(state_path(), json.dumps(state, indent=2, sort_keys=True) + "\n")


def new_state(target, mode, path, current, image):
    return {
        "schema": 1,
        "agent": {"version": TOOL_VERSION, "capabilities": CAPABILITIES},
        "mode": mode,
        "target": path[-1].version if path else target,
        "current": current,
        "pending": [r.to_dict() for r in path],
        "image": image,
        "hop": None,
        "phase": "IDLE",
        "rollbacks": 0,
        "hold": None,
        "history": [],
    }


def start_next_hop(state):
    rel = state["pending"].pop(0)
    state["hop"] = {
        "from": state["current"],
        "to": rel["version"],
        "kind": hop_kind(state["current"], rel["version"]),
        "kubernetes": rel["kubernetes"],
        "syncManifest": bool(rel.get("syncManifest")),
        "image": Release(rel).image_ref(state["image"]),
        "drained": False,
        "startedAt": None,
    }
    state["phase"] = "PREFLIGHT"
    state["rollbacks"] = 0


def put_on_hold(host, state, reason):
    state["hold"] = {"reason": reason, "phase": state.get("phase"),
                     "at": host.now().isoformat(timespec="seconds")}
    save_state(host, state)
    host.log("HOLD: %s" % reason)
    host.log("Fix the cause, then run: k4all-upgrade clear-hold && "
             "k4all-upgrade resume")


# =========================================================================
# Phases
# =========================================================================
class Upgrader:
    def __init__(self, host, cfg, graph_loader=None):
        self.host = host
        self.cfg = cfg
        self.graph_loader = graph_loader or (lambda: load_best_graph(host, cfg))

    # --- helpers ---------------------------------------------------------
    def _role(self):
        return node_role(self.host)

    def _kubeconfig(self):
        return kubeconfig_for(self.host, self._role())

    def _node_name(self):
        return self.host.hostname()

    def _cluster_nodes(self):
        kc = self._kubeconfig()
        if not kc:
            return []
        got = kubectl(self.host, kc, ["get", "nodes", "-o", "json"], check=False)
        if got.returncode != 0:
            return []
        return json.loads(got.stdout).get("items", [])

    def annotate(self, value):
        """Set (value) or remove (None) the pause annotation on this Node."""
        kc = self._kubeconfig()
        if not kc:
            return
        arg = ("%s=%s" % (ANNOTATION_IN_PROGRESS, value)) if value \
            else ANNOTATION_IN_PROGRESS + "-"
        kubectl(self.host, kc, ["annotate", "node", self._node_name(), arg,
                                "--overwrite"], check=False)

    def _backup_dir(self, hop):
        return "%s/backup/%s-%s" % (STATE_DIR, hop["from"], hop["to"])

    # --- PREFLIGHT -------------------------------------------------------
    def preflight(self, state):
        host, hop = self.host, state["hop"]
        status = bootc_status(host)
        staged = _deployment(status, "staged")
        if staged and not _same_image(staged, hop["image"]):
            ref, _ = deployment_image(staged)
            raise UpgradeError("another deployment is already staged (%s); "
                               "remove it before upgrading" % (ref or "unknown"))
        booted = current_version(host, status)
        if parse_version(booted) != parse_version(hop["from"]):
            raise UpgradeError("node runs %s, the hop starts from %s"
                               % (booted, hop["from"]))
        if host.free_gib("/sysroot") < float(self.cfg["minFreeSysrootGiB"]):
            raise UpgradeError("less than %s GiB free on /sysroot"
                               % self.cfg["minFreeSysrootGiB"])
        if host.free_gib("/var") < float(self.cfg["minFreeVarGiB"]):
            raise UpgradeError("less than %s GiB free on /var"
                               % self.cfg["minFreeVarGiB"])
        role = self._role()
        kc = self._kubeconfig()
        if not kc:
            host.log("no kubeconfig on this node: skipping cluster checks")
            return
        nodes = self._cluster_nodes()
        if role in ("bootstrap", "control"):
            ready = kubectl(host, kc, ["get", "--raw", "/readyz"], check=False)
            if ready.returncode != 0 or ready.stdout.strip() != "ok":
                raise UpgradeError("the apiserver is not ready: %s"
                                   % (ready.stdout or ready.stderr).strip())
            not_ready = [n["metadata"]["name"] for n in nodes if not node_ready(n)]
            if not_ready:
                raise UpgradeError("nodes not Ready: %s" % ", ".join(not_ready))
        target = hop["kubernetes"]
        running = kubelet_version(host)
        if k8s_key(target) != k8s_key(running):
            if role == "worker":
                api = server_version(host, kc)
                if k8s_key(api) < k8s_key(target):
                    raise UpgradeError("the apiserver is at %s; upgrade the "
                                       "control plane to %s first" % (api, target))
            elif role == "control":
                cluster = cluster_kubernetes_version(host, kc)
                if k8s_key(cluster) < k8s_key(target):
                    raise UpgradeError("the cluster is at %s; run the upgrade on "
                                       "the bootstrap node first" % cluster)
        if len(nodes) > 1 and k8s_minor(target) != k8s_minor(running) \
                and kc != ADMIN_KUBECONFIG:
            raise UpgradeError("a kubelet minor upgrade needs a drain, and this "
                               "node has no admin kubeconfig: drain it from a "
                               "control plane or let the k4all-operator drive it")

    # --- BACKUP ----------------------------------------------------------
    def backup(self, state):
        host, hop = self.host, state["hop"]
        dest = self._backup_dir(hop)
        for path in BACKUP_FILES:
            if host.exists(path):
                host.copy(path, dest + "/files" + path)
        if self._role() in ("bootstrap", "control") \
                and host.exists("/etc/kubernetes/manifests/etcd.yaml"):
            host.run(["/usr/local/bin/k4all-backup.sh", host.path(dest)],
                     timeout=1800)

    # --- STAGE -----------------------------------------------------------
    def stage(self, state):
        host, hop = self.host, state["hop"]
        staged = _deployment(bootc_status(host), "staged")
        if not staged:
            host.log("downloading %s" % hop["image"])
            host.run(["bootc", "switch", "--download-only", hop["image"]],
                     timeout=3600)
            staged = _deployment(bootc_status(host), "staged")
            if not staged or not _same_image(staged, hop["image"]):
                raise UpgradeError("bootc did not stage %s" % hop["image"])
        hop["startedAt"] = hop.get("startedAt") or host.now().isoformat(
            timespec="seconds")
        self.annotate("%s->%s" % (hop["from"], hop["to"]))
        if k8s_key(hop["kubernetes"]) != k8s_key(kubelet_version(host)):
            self.pause_operator(hop)

    # --- operator pause --------------------------------------------------
    def pause_operator(self, hop):
        """Operators older than the pause gate ignore the annotation; while
        kubeadm restarts the control plane, stop them by scaling to zero.
        Skipped in managed mode, where the operator drives the upgrade."""
        if self.cfg["mode"] == "managed" or "operatorReplicas" in hop:
            return
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            return
        got = kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "get",
                                      "deployment", OPERATOR_DEPLOYMENT, "-o",
                                      "json"], check=False)
        if got.returncode != 0:
            return
        replicas = int((json.loads(got.stdout).get("spec") or {})
                       .get("replicas", 1) or 0)
        if replicas == 0:
            return
        hop["operatorReplicas"] = replicas
        kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "scale", "deployment",
                                OPERATOR_DEPLOYMENT, "--replicas=0"])
        self.host.log("k4all-operator paused for the hop")

    def resume_operator(self, hop):
        replicas = (hop or {}).pop("operatorReplicas", None)
        if not replicas:
            return
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            return
        kubectl(self.host, kc, ["-n", OPERATOR_NAMESPACE, "scale", "deployment",
                                OPERATOR_DEPLOYMENT, "--replicas=%d" % replicas],
                check=False)
        self.host.log("k4all-operator resumed")

    def hold(self, state, reason):
        """HOLD keeps the node paused, except when nothing was rebooted yet:
        then the cluster is unchanged and the operator may run again."""
        if state.get("phase") in ("PREFLIGHT", "BACKUP", "STAGE", "PRE_REBOOT",
                                  "DRAIN") and state.get("hop"):
            self.resume_operator(state["hop"])
        put_on_hold(self.host, state, reason)

    # --- PRE_REBOOT ------------------------------------------------------
    def pre_reboot(self, state):
        host, hop = self.host, state["hop"]
        target = hop["kubernetes"]
        current = kubelet_version(host)
        if k8s_key(target) == k8s_key(current):
            host.log("Kubernetes stays at %s" % current)
            return
        role = self._role()
        self._run_hooks(current, target, role)
        kubeadm = self.kubeadm_from_staged(target)
        if role == "bootstrap":
            cluster = cluster_kubernetes_version(host, ADMIN_KUBECONFIG)
            if cluster and k8s_minor(cluster) == k8s_minor(target) \
                    and k8s_key(cluster) >= k8s_key(target):
                host.log("control plane already at %s" % cluster)
                return
            self._preload_images(target, kubeadm)
            host.log("kubeadm upgrade apply v%s" % target)
            host.run([kubeadm, "upgrade", "apply", "v" + target, "--yes"],
                     timeout=3600)
            api = server_version(host, ADMIN_KUBECONFIG)
            if k8s_key(api) != k8s_key(target):
                raise UpgradeError("apiserver reports %s after kubeadm upgrade "
                                   "apply v%s" % (api, target))
        else:
            if role == "control":
                self._preload_images(target, kubeadm)
            host.log("kubeadm upgrade node (%s)" % role)
            host.run([kubeadm, "upgrade", "node"], timeout=3600)

    # --- DRAIN -----------------------------------------------------------
    def drain(self, state):
        host, hop = self.host, state["hop"]
        nodes = self._cluster_nodes()
        if len(nodes) <= 1:
            host.log("single-node cluster: no drain")
            return
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            host.log("no admin kubeconfig: drain skipped (this hop keeps the "
                     "Kubernetes minor)")
            return
        minutes = int(self.cfg["drainTimeoutMinutes"])
        kubectl(host, kc, ["drain", self._node_name(), "--ignore-daemonsets",
                           "--delete-emptydir-data", "--timeout=%dm" % minutes])
        hop["drained"] = True

    # --- REBOOT ----------------------------------------------------------
    def reboot(self, state):
        host = self.host
        state["phase"] = "REBOOT"
        save_state(host, state)
        host.log("rebooting into %s" % state["hop"]["to"])
        try:
            host.run(["bootc", "upgrade", "--from-downloaded", "--apply"])
        except UpgradeError:
            # Nothing rebooted: retrying the hop must start again from DRAIN.
            state["phase"] = "DRAIN"
            raise

    # --- POST_BOOT -------------------------------------------------------
    def post_boot(self, state):
        """Runs after the reboot. Returns normally when the node is healthy on
        the new release; raises RollbackNeeded when it booted the new image
        but is unhealthy; raises UpgradeError for anything else."""
        host, hop = self.host, state["hop"]
        booted = current_version(host)
        if parse_version(booted) == parse_version(hop["from"]):
            raise UpgradeError("the node rebooted but is still on %s"
                               % hop["from"])
        if parse_version(booted) != parse_version(hop["to"]):
            raise UpgradeError("node booted %s instead of %s"
                               % (booted, hop["to"]))
        deadline = host.now() + datetime.timedelta(
            minutes=int(self.cfg["postBootTimeoutMinutes"]))
        while True:
            ok, reason = self._node_healthy(hop)
            if ok:
                return
            if host.now() >= deadline:
                raise RollbackNeeded("node not healthy after the reboot: %s"
                                     % reason)
            host.sleep(15)

    def _node_healthy(self, hop):
        host = self.host
        active = host.run(["systemctl", "is-active", "kubelet"], check=False)
        if active.stdout.strip() != "active":
            return False, "kubelet is %s" % (active.stdout.strip() or "inactive")
        version = kubelet_version(host)
        if k8s_key(version) != k8s_key(hop["kubernetes"]):
            return False, "kubelet is %s, expected %s" % (version,
                                                          hop["kubernetes"])
        kc = self._kubeconfig()
        if not kc:
            return True, ""
        node = kubectl(host, kc, ["get", "node", self._node_name(), "-o",
                                  "json"], check=False)
        if node.returncode != 0:
            return False, "cannot read the node: %s" % node.stderr.strip()
        if not node_ready(json.loads(node.stdout)):
            return False, "node is not Ready"
        if self._role() in ("bootstrap", "control"):
            ready = kubectl(host, kc, ["get", "--raw", "/readyz"], check=False)
            if ready.stdout.strip() != "ok":
                return False, "apiserver not ready"
        return True, ""

    # --- SYNC ------------------------------------------------------------
    def sync(self, state):
        host, hop = self.host, state["hop"]
        kc = self._kubeconfig()
        if hop.get("drained") and kc:
            kubectl(host, kc, ["uncordon", self._node_name()])
            hop["drained"] = False
        self.resume_operator(hop)
        if hop.get("syncManifest") and self._role() == "bootstrap":
            self.sync_manifest()

    # --- COMMIT ----------------------------------------------------------
    def commit(self, state):
        host, hop = self.host, state["hop"]
        self.resume_operator(hop)
        self.annotate(None)
        state["history"].append({"from": hop["from"], "to": hop["to"],
                                 "result": "ok",
                                 "at": host.now().isoformat(timespec="seconds")})
        state["current"] = hop["to"]
        state["hop"] = None
        state["phase"] = "IDLE"
        host.log("now on %s" % state["current"])

    # --- rollback --------------------------------------------------------
    def rollback(self, state, reason):
        """First failure after a reboot: go back to the previous image once.
        The control plane stays on the new version, which is a supported skew
        for the older kubelet."""
        host, hop = self.host, state["hop"]
        backup = self._backup_dir(hop) + "/files"
        for path in ("/var/lib/kubelet/config.yaml",
                     "/var/lib/kubelet/kubeadm-flags.env"):
            if host.exists(backup + path):
                host.copy(backup + path, path)
        state["rollbacks"] = state.get("rollbacks", 0) + 1
        state["phase"] = "ROLLBACK_REBOOT"
        state["rollbackReason"] = reason
        save_state(host, state)
        host.log("rolling back to the previous image: %s" % reason)
        host.run(["bootc", "rollback"])
        host.run(["systemctl", "reboot"])

    # --- Kubernetes helpers ----------------------------------------------
    def kubeadm_from_staged(self, version):
        """The kubeadm binary of the staged image, so kubeadm always matches
        the image the node is about to boot. Falls back to dl.k8s.io with a
        checksum check."""
        host = self.host
        dest = "%s/bin/kubeadm-%s" % (STATE_DIR, version)
        if host.exists(dest) and self._kubeadm_is(dest, version):
            return host.path(dest)
        staged = _deployment(bootc_status(host), "staged") or {}
        checksum = (staged.get("ostree") or {}).get("checksum")
        if checksum:
            data = host.run_bytes(["ostree", "--repo=" + host.path(OSTREE_REPO),
                                   "cat", checksum, "/usr/bin/kubeadm"],
                                  timeout=300)
            if data:
                self._write_binary(dest, data)
                if self._kubeadm_is(dest, version):
                    return host.path(dest)
        host.log("kubeadm not readable from the staged image; downloading "
                 "v%s from dl.k8s.io" % version)
        base = "https://dl.k8s.io/release/v%s/bin/linux/%s/kubeadm" % (
            version, host.arch())
        data = host.fetch(base, timeout=300)
        expected = host.fetch(base + ".sha256").decode().split()[0]
        if hashlib.sha256(data).hexdigest() != expected:
            raise UpgradeError("kubeadm v%s checksum mismatch" % version)
        self._write_binary(dest, data)
        if not self._kubeadm_is(dest, version):
            raise UpgradeError("downloaded kubeadm is not v%s" % version)
        return host.path(dest)

    def _write_binary(self, dest, data):
        full = self.host.path(dest)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "wb") as fh:
            fh.write(data)
        os.chmod(full, 0o755)

    def _kubeadm_is(self, path, version):
        out = self.host.run([self.host.path(path), "version", "-o", "short"],
                            check=False)
        return out.returncode == 0 and out.stdout.strip() == "v" + version

    def _preload_images(self, version, kubeadm):
        """Load the control-plane images shipped in the staged image, or pull
        them, so `kubeadm upgrade` does not wait on the network."""
        host = self.host
        staged = _deployment(bootc_status(host), "staged") or {}
        ostree = staged.get("ostree") or {}
        cache = "/sysroot/ostree/deploy/%s/deploy/%s.%s%s" % (
            ostree.get("stateroot", "default"), ostree.get("checksum", ""),
            ostree.get("deploySerial", 0), IMAGE_CACHE_DIR)
        loaded = 0
        if ostree.get("checksum") and host.exists(cache):
            for name in sorted(os.listdir(host.path(cache))):
                if name.endswith(".tar"):
                    host.run(["podman", "load", "-i",
                              host.path(cache + "/" + name)], check=False,
                             timeout=900)
                    loaded += 1
        if not loaded:
            host.run([kubeadm, "config", "images", "pull",
                      "--kubernetes-version", "v" + version], check=False,
                     timeout=1800)

    def _run_hooks(self, current, target, role):
        for minor, hooks in sorted(HOOKS_BEFORE_MINOR.items()):
            if k8s_minor(current) < minor <= k8s_minor(target):
                for hook in hooks:
                    hook(self, role)

    # --- manifest sync ---------------------------------------------------
    def sync_manifest(self):
        """Apply this image's ReleaseManifest to the cluster in two steps.

        1. Only the k4all-operator component, when it changes, so that the
           new operator (and its CRDs) is running before it sees the rest:
           an older operator would ignore upgradePath and jump components
           straight to their targets.
        2. Everything else, then wait until the components settle.
        """
        host = self.host
        kc = self._kubeconfig()
        if kc != ADMIN_KUBECONFIG:
            raise UpgradeError("the ReleaseManifest sync needs the admin "
                               "kubeconfig (bootstrap node)")
        new = load_yaml_file(host, IMAGE_RELEASE_MANIFEST)
        got = kubectl(host, kc, ["get", "releasemanifest", RELEASE_MANIFEST_NAME,
                                 "-o", "json"], check=False)
        cluster = json.loads(got.stdout) if got.returncode == 0 else {}
        merged = merge_release_manifest(cluster, new)
        # The operator only reconciles once the pause annotation is gone.
        self.annotate(None)
        operator_step = operator_only_manifest(cluster, merged)
        if operator_step is not None:
            want = merged["spec"]["components"][OPERATOR_COMPONENT].get("version")
            host.log("ReleaseManifest sync 1/2: k4all-operator %s" % want)
            self._apply(kc, operator_step)
            self._wait_operator(kc, want)
        host.log("ReleaseManifest sync 2/2: components")
        self._apply(kc, merged)
        self._wait_components(kc)

    def _apply(self, kc, doc):
        kubectl(self.host, kc, ["apply", "--server-side", "--force-conflicts",
                                "--field-manager=" + FIELD_MANAGER, "-f", "-"],
                input_text=json.dumps(doc))

    def _deadline(self):
        return self.host.now() + datetime.timedelta(
            minutes=int(self.cfg["componentsTimeoutMinutes"]))

    def _wait_operator(self, kc, want):
        host, deadline = self.host, self._deadline()
        while True:
            cr = kubectl_json(host, kc, ["get", "releasemanifest",
                                         RELEASE_MANIFEST_NAME])
            st = ((cr.get("status") or {}).get("components") or {}).get(
                OPERATOR_COMPONENT) or {}
            # A Failed state may be retried by the operator (every ~5 min):
            # only the deadline turns it into a HOLD.
            if st.get("state") == "Installed" and (
                    _plain(want) in FLOATING_VERSIONS
                    or _plain(st.get("installedVersion")) == _plain(want)):
                rollout = kubectl(host, kc, ["-n", OPERATOR_NAMESPACE, "rollout",
                                             "status", "deployment/" +
                                             OPERATOR_DEPLOYMENT,
                                             "--timeout=60s"], check=False)
                # appliedHash is written only by the new operator, after its
                # first reconcile has adopted the installed components; the
                # second step must not arrive before that.
                if rollout.returncode == 0 and st.get("appliedHash"):
                    return
            if host.now() >= deadline:
                detail = (": %s" % st.get("message")) if st.get("message") else ""
                raise UpgradeError("k4all-operator %s not running after %s "
                                   "minutes (state %s)%s"
                                   % (want, self.cfg["componentsTimeoutMinutes"],
                                      st.get("state", "unknown"), detail))
            host.sleep(30)

    def _wait_components(self, kc):
        host, deadline = self.host, self._deadline()
        while True:
            cr = kubectl_json(host, kc, ["get", "releasemanifest",
                                         RELEASE_MANIFEST_NAME])
            settled, failed, waiting = components_settled(cr)
            if settled:
                host.log("components reconciled")
                return
            # Failed components are retried by the operator; give up only at
            # the deadline.
            if host.now() >= deadline and failed:
                raise UpgradeError("components failed after the sync: %s"
                                   % ", ".join(failed))
            if host.now() >= deadline:
                raise UpgradeError("components still reconciling after %s "
                                   "minutes: %s"
                                   % (self.cfg["componentsTimeoutMinutes"],
                                      ", ".join(waiting)))
            host.sleep(30)

    # --- driver ----------------------------------------------------------
    STEPS = {
        "PREFLIGHT": ("preflight", "BACKUP"),
        "BACKUP": ("backup", "STAGE"),
        "STAGE": ("stage", "PRE_REBOOT"),
        "PRE_REBOOT": ("pre_reboot", "DRAIN"),
        "REBOOT": ("post_boot", "SYNC"),
        "SYNC": ("sync", "COMMIT"),
    }

    def drive(self, state):
        """Run phases until the plan is done, the node reboots, or a HOLD."""
        host = self.host
        while True:
            if state.get("hold"):
                return state
            phase = state["phase"]
            if phase == "DONE":
                return state
            if phase == "IDLE":
                if not state["pending"]:
                    state["phase"] = "DONE"
                    save_state(host, state)
                    host.log("upgrade finished: %s" % state["current"])
                    return state
                if state["mode"] == "auto" and not self._auto_may_continue(state):
                    save_state(host, state)
                    return state
                start_next_hop(state)
                save_state(host, state)
                host.log("hop %s -> %s (%s)" % (state["hop"]["from"],
                                                 state["hop"]["to"],
                                                 state["hop"]["kind"]))
                continue
            try:
                if phase == "ROLLBACK_REBOOT":
                    self.hold(state, "rolled back to %s after a failed reboot: "
                              "%s" % (state["hop"]["from"],
                                      state.get("rollbackReason", "")))
                    return state
                if phase == "COMMIT":
                    self.commit(state)
                elif phase == "DRAIN":
                    self.drain(state)
                    self.reboot(state)
                    return state
                elif phase in self.STEPS:
                    method, nxt = self.STEPS[phase]
                    getattr(self, method)(state)
                    state["phase"] = nxt
                else:
                    raise UpgradeError("unknown phase %s" % phase)
            except RollbackNeeded as exc:
                if state.get("rollbacks", 0) == 0:
                    self.rollback(state, str(exc))
                    return state
                self.hold(state, str(exc))
                return state
            except UpgradeError as exc:
                self.hold(state, str(exc))
                return state
            save_state(host, state)

    def _auto_may_continue(self, state):
        nxt = state["pending"][0]["version"]
        if self.cfg["autoAllow"] != "minor" and \
                hop_kind(state["current"], nxt) != "patch":
            self.host.log("next hop %s -> %s is a minor: waiting for "
                          "`k4all-upgrade run`" % (state["current"], nxt))
            return False
        if not in_window(self.host.now(), self.cfg["window"]):
            self.host.log("outside the maintenance window")
            return False
        return True


def _same_image(deployment, ref):
    """True when a bootc deployment entry is the image ``ref`` names."""
    image, digest = deployment_image(deployment)
    if "@" in ref:
        return bool(digest) and ref.endswith("@" + digest)
    return image == ref


BACKUP_FILES = ("/var/lib/kubelet/config.yaml",
                "/var/lib/kubelet/kubeadm-flags.env", KUBEADM_CONFIG_FILE,
                "/etc/k4all-config.yaml", "/etc/k4all-release.yaml",
                CONFIG_FILE)


# =========================================================================
# Hooks before entering a Kubernetes minor
# =========================================================================
V1BETA3 = "kubeadm.k8s.io/v1beta3"
V1BETA4 = "kubeadm.k8s.io/v1beta4"


def _args_to_list(args):
    if isinstance(args, dict):
        return [{"name": k, "value": str(v)} for k, v in sorted(args.items())]
    return args


def kubeadm_doc_to_v1beta4(doc):
    """Structural v1beta3 -> v1beta4 conversion of one kubeadm document.

    Unlike `kubeadm config migrate`, it adds no defaults (no new bootstrap
    token, advertise address, CRI socket, node name or version): the file
    keeps exactly what the node had, in the new shape.
    """
    if not isinstance(doc, dict) or doc.get("apiVersion") != V1BETA3:
        return doc, False
    doc["apiVersion"] = V1BETA4
    for section in ("apiServer", "controllerManager", "scheduler"):
        if isinstance(doc.get(section), dict) and "extraArgs" in doc[section]:
            doc[section]["extraArgs"] = _args_to_list(doc[section]["extraArgs"])
    local = (doc.get("etcd") or {}).get("local")
    if isinstance(local, dict) and "extraArgs" in local:
        local["extraArgs"] = _args_to_list(local["extraArgs"])
    reg = doc.get("nodeRegistration")
    if isinstance(reg, dict) and "kubeletExtraArgs" in reg:
        reg["kubeletExtraArgs"] = _args_to_list(reg["kubeletExtraArgs"])
    api = doc.get("apiServer")
    if isinstance(api, dict) and "timeoutForControlPlane" in api:
        value = api.pop("timeoutForControlPlane")
        if doc.get("kind") == "InitConfiguration":
            doc.setdefault("timeouts", {})["controlPlaneComponentHealthCheck"] = value
    discovery = doc.get("discovery")
    if isinstance(discovery, dict) and "timeout" in discovery:
        doc.setdefault("timeouts", {})["discovery"] = discovery.pop("timeout")
    return doc, True


def dump_yaml_docs(host, docs):
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return yaml.safe_dump_all(docs, sort_keys=False)
    except ImportError:
        parts = [host.run(["yq", "-P", "-o=yaml", "eval", "."],
                          input_text=json.dumps(d)).stdout for d in docs]
        return "---\n".join(parts)


def load_yaml_docs(host, text):
    try:
        import yaml  # pylint: disable=import-outside-toplevel
        return [d for d in yaml.safe_load_all(text) if d is not None]
    except ImportError:
        out = host.run(["yq", "-o=json", "-I=0", "eval", "."],
                       input_text=text).stdout
        return [json.loads(line) for line in out.splitlines() if line.strip()]


def hook_migrate_kubeadm_config_file(upgrader, role):
    """kubeadm 1.37 removes v1beta3: convert /etc/k8s-config.yaml, which
    enable-cluster.sh and control-plane-utils still feed to kubeadm. Runs
    with the kubeadm still installed (1.36), before the 1.37 apply."""
    host = upgrader.host
    if not host.exists(KUBEADM_CONFIG_FILE):
        return
    text = host.read(KUBEADM_CONFIG_FILE)
    if V1BETA3 not in text:
        return
    docs, changed = [], False
    for doc in load_yaml_docs(host, text):
        doc, did = kubeadm_doc_to_v1beta4(doc)
        docs.append(doc)
        changed = changed or did
    if not changed:
        return
    host.copy(KUBEADM_CONFIG_FILE, KUBEADM_CONFIG_FILE + ".v1beta3.bak")
    host.write(KUBEADM_CONFIG_FILE, dump_yaml_docs(host, docs))
    host.log("converted %s to kubeadm v1beta4" % KUBEADM_CONFIG_FILE)


def drop_flexvolume(cluster_config):
    """Remove flex-volume-plugin-dir from a ClusterConfiguration dict.
    Returns True when something changed."""
    cm = (cluster_config or {}).get("controllerManager") or {}
    args = cm.get("extraArgs")
    changed = False
    if isinstance(args, list):
        kept = [a for a in args if a.get("name") != "flex-volume-plugin-dir"]
        changed = len(kept) != len(args)
        cm["extraArgs"] = kept
    elif isinstance(args, dict) and "flex-volume-plugin-dir" in args:
        del args["flex-volume-plugin-dir"]
        changed = True
    volumes = cm.get("extraVolumes")
    if isinstance(volumes, list):
        kept = [v for v in volumes
                if "kubelet-plugins/volume/exec" not in str(v.get("hostPath", ""))]
        changed = changed or len(kept) != len(volumes)
        cm["extraVolumes"] = kept
    return changed


def hook_drop_flexvolume(upgrader, role):
    """kubeadm 1.36 no longer mounts the flex-volume directory into the
    controller-manager: drop the flag from the cluster configuration before
    `kubeadm upgrade apply` regenerates the static pod."""
    if role != "bootstrap":
        return
    host = upgrader.host
    cm = kubectl_json(host, ADMIN_KUBECONFIG,
                      ["-n", "kube-system", "get", "configmap", "kubeadm-config"])
    cfg = load_yaml_text(host, cm["data"]["ClusterConfiguration"])
    if not drop_flexvolume(cfg):
        return
    cm["data"]["ClusterConfiguration"] = json.dumps(cfg, indent=2)
    for field in ("resourceVersion", "uid", "creationTimestamp", "managedFields"):
        cm.get("metadata", {}).pop(field, None)
    kubectl(host, ADMIN_KUBECONFIG, ["replace", "-f", "-"],
            input_text=json.dumps(cm))
    host.log("removed flex-volume-plugin-dir from kubeadm-config")


HOOKS_BEFORE_MINOR = {
    # kubeadm 1.36 no longer mounts the flex-volume dir into the
    # controller-manager (kubernetes#136423)
    (1, 36): [hook_drop_flexvolume],
    # kubeadm 1.37 removes the v1beta3 config API (kubernetes#136016)
    (1, 37): [hook_migrate_kubeadm_config_file],
}


# =========================================================================
# Graph loading
# =========================================================================
def load_best_graph(host, cfg):
    """The published graph (with digests) when reachable, else the copy
    shipped in the image."""
    try:
        data = json.loads(host.fetch(cfg["graphUrl"]).decode())
        releases = load_graph(data)
        if releases:
            return releases
    except Exception as exc:  # pylint: disable=broad-except
        host.log("cannot fetch %s (%s); using the graph in the image"
                 % (cfg["graphUrl"], exc))
    if not host.exists(LOCAL_GRAPH_FILE):
        raise UpgradeError("no upgrade graph available")
    return load_graph(json.loads(host.read(LOCAL_GRAPH_FILE)))


def load_config(host):
    path = CONFIG_FILE if host.exists(CONFIG_FILE) else CONFIG_DEFAULT_FILE
    user = load_yaml_file(host, path) if host.exists(path) else {}
    return merge_config(user or {})


# =========================================================================
# CLI
# =========================================================================
class Lock:
    def __init__(self, host):
        self.path = host.path(STATE_DIR + "/lock")
        self.fh = None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fh = open(self.path, "w", encoding="utf-8")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise UpgradeError("another k4all-upgrade is running") from exc
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def _active(state):
    return state and state.get("phase") not in (None, "DONE") and \
        (state.get("hop") or state.get("pending"))


def cmd_status(host, cfg, args):
    state = load_state(host)
    try:
        version = current_version(host)
    except UpgradeError as exc:
        version = "unknown (%s)" % exc
    info = {"version": version, "mode": cfg["mode"], "autoAllow": cfg["autoAllow"],
            "window": cfg["window"], "state": state}
    if args.json:
        print(json.dumps(info, indent=2))
        return 0
    print("Release:   %s" % version)
    print("Policy:    mode=%s autoAllow=%s window=%s %s +%smin"
          % (cfg["mode"], cfg["autoAllow"], ",".join(cfg["window"]["days"]),
             cfg["window"]["start"], cfg["window"]["durationMinutes"]))
    if not state:
        print("Upgrade:   none")
        return 0
    print("Upgrade:   target %s, phase %s" % (state.get("target"), state.get("phase")))
    if state.get("hop"):
        print("Hop:       %s -> %s (%s)" % (state["hop"]["from"], state["hop"]["to"],
                                           state["hop"]["kind"]))
    if state.get("pending"):
        print("Then:      %s" % " -> ".join(r["version"] for r in state["pending"]))
    if state.get("hold"):
        print("HOLD:      %s" % state["hold"]["reason"])
    return 0


def _plan(host, cfg, args, upgrader):
    current = normalize_version(args.from_version) if args.from_version \
        else current_version(host)
    releases = upgrader.graph_loader()
    errors = validate_graph(releases)
    if errors:
        raise UpgradeError("the upgrade graph is invalid: %s" % "; ".join(errors))
    return current, plan_path(releases, current, args.to)


def cmd_plan(host, cfg, args, upgrader):
    current, path = _plan(host, cfg, args, upgrader)
    if not path:
        print("%s is already the latest reachable release" % current)
        return 0
    cur = current
    for rel in path:
        print("%s -> %s  [%s] Kubernetes %s, CRI-O %s, Fedora %d"
              % (cur, rel.version, hop_kind(cur, rel.version), rel.kubernetes,
                 rel.crio, rel.fedora))
        cur = rel.version
    return 0


def cmd_run(host, cfg, args, upgrader):
    state = load_state(host)
    if _active(state):
        raise UpgradeError("an upgrade is already in progress (phase %s); use "
                           "`k4all-upgrade resume` or `clear-hold`" % state["phase"])
    current, path = _plan(host, cfg, args, upgrader)
    if not path:
        host.log("%s is already the latest reachable release" % current)
        return 0
    host.log("plan: %s -> %s" % (current, " -> ".join(r.version for r in path)))
    if not args.yes:
        if not sys.stdin.isatty():
            raise UpgradeError("refusing to reboot without --yes")
        answer = input("The node will reboot %d time(s). Continue? [y/N] "
                       % len(path))
        if answer.strip().lower() not in ("y", "yes"):
            return 1
    state = new_state(args.to, "run", path, current, cfg["image"])
    save_state(host, state)
    upgrader.drive(state)
    return 1 if state.get("hold") else 0


def cmd_auto(host, cfg, args, upgrader):
    if cfg["mode"] != "auto":
        return 0
    state = load_state(host)
    if _active(state):
        # A plan started by the timer continues between hops; anything else
        # (a manual run, a phase after a reboot) belongs to `resume`.
        if not state.get("hold") and state.get("mode") == "auto" \
                and state["phase"] in ("IDLE", "PREFLIGHT"):
            upgrader.drive(state)
        return 0
    if not in_window(host.now(), cfg["window"]):
        return 0
    current, path = _plan(host, cfg, args, upgrader)
    path = auto_allowed(path, current, cfg["autoAllow"])
    if not path:
        return 0
    state = new_state(None, "auto", path, current, cfg["image"])
    save_state(host, state)
    upgrader.drive(state)
    return 0


def cmd_resume(host, cfg, args, upgrader):
    state = load_state(host)
    if not _active(state):
        return 0
    if state.get("hold"):
        host.log("on hold: %s" % state["hold"]["reason"])
        return 0
    upgrader.drive(state)
    return 1 if state.get("hold") else 0


def cmd_clear_hold(host, cfg, args, upgrader):
    state = load_state(host)
    if not state:
        return 0
    if args.abandon:
        state["history"].append({"from": state.get("current"),
                                 "to": (state.get("hop") or {}).get("to"),
                                 "result": "abandoned",
                                 "at": host.now().isoformat(timespec="seconds")})
        upgrader.resume_operator(state.get("hop"))
        state.update({"hop": None, "pending": [], "phase": "DONE", "hold": None})
        upgrader.annotate(None)
    else:
        state["hold"] = None
    save_state(host, state)
    return 0


def cmd_sync_manifest(host, cfg, args, upgrader):
    upgrader.sync_manifest()
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="k4all-upgrade",
        description="Upgrade this k4all node one safe release hop at a time.")
    parser.add_argument("--root", default="/", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("status", help="show release, policy and upgrade state")
    p.add_argument("--json", action="store_true")
    for name, text in (("plan", "show the hops to a release"),
                       ("run", "upgrade now, rebooting as needed")):
        p = sub.add_parser(name, help=text)
        p.add_argument("--to", default="latest",
                       help="target release (default: latest)")
        p.add_argument("--from", dest="from_version",
                       help="override the detected current release")
        if name == "run":
            p.add_argument("--yes", action="store_true",
                           help="do not ask for confirmation")
    p = sub.add_parser("auto", help="used by k4all-upgrade.timer")
    p.add_argument("--to", default="latest", help=argparse.SUPPRESS)
    p.add_argument("--from", dest="from_version", help=argparse.SUPPRESS)
    sub.add_parser("resume", help="continue an upgrade (used at boot)")
    p = sub.add_parser("clear-hold", help="clear a HOLD after fixing its cause")
    p.add_argument("--abandon", action="store_true",
                   help="forget the remaining hops")
    sub.add_parser("sync-manifest",
                   help="apply this image's ReleaseManifest to the cluster")
    return parser


def main(argv=None, host=None):
    args = build_parser().parse_args(argv)
    host = host or Host(args.root)
    try:
        cfg = load_config(host)
        upgrader = Upgrader(host, cfg)
        if args.command == "status":
            return cmd_status(host, cfg, args)
        handlers = {"plan": cmd_plan, "run": cmd_run, "auto": cmd_auto,
                    "resume": cmd_resume, "clear-hold": cmd_clear_hold,
                    "sync-manifest": cmd_sync_manifest}
        if args.command == "plan":
            return handlers["plan"](host, cfg, args, upgrader)
        with Lock(host):
            return handlers[args.command](host, cfg, args, upgrader)
    except (UpgradeError, NoPathError) as exc:
        host.log("error: %s" % exc)
        return 2


if __name__ == "__main__":
    sys.exit(main())
