RESUME_LOCK_WAIT = 600
# Before a reboot each pod gets its own terminationGracePeriodSeconds to
# stop, at least POD_STOP_SECONDS (what every pod got up to v2.6.6) and at
# most podStopMaxSeconds (see Upgrader.stop_pods).
POD_STOP_SECONDS = 30
# kubelet's annotation on each container of a pod: the pod's
# terminationGracePeriodSeconds (pkg/kubelet/kuberuntime/labels.go). The pod
# sandbox has no such annotation.
GRACE_ANNOTATION = "io.kubernetes.pod.terminationGracePeriod"
CRICTL = "crictl --runtime-endpoint unix:///run/crio/crio.sock"
# One stop per pod, all at once; each input line is "<seconds> <pod id>".
# crictl's --timeout is the deadline of the CRI call. CRI-O (v1.36.8,
# stopPodSandbox) first tears the pod's network down, then stops the
# containers with what is left of the deadline, less 1 s for the infra
# container (stopTimeoutFromContext), and kills them at the end: 2 s more
# give the containers the pod's seconds. A failed network teardown fails the
# call with the containers untouched (Upgrader.stop_pods stops the CNI agent
# last so that it does not happen), but CRI-O marks the network stopped:
# while the pod has time left, the stop is tried again (3 tries at most), and
# the next call goes straight to the containers. Each pod prints "<pod id>
# <0, or 1 when its stop failed> <seconds it took> <tries>"; the script fails
# (xargs: 123) when one stop did.
STOP_ONE_POD = (
    "s=$(date +%s); end=$((s + $0)); t=$(($0 + 2)); r=1; n=0; "
    "while [ $n -lt 3 ]; do n=$((n + 1)); "
    + CRICTL + " --timeout=${t}s stopp \"$1\" >/dev/null && { r=0; break; }; "
    "t=$((end - $(date +%s) + 1)); [ $t -gt 2 ] || break; sleep 1; done; "
    "echo \"$1 $r $(($(date +%s) - s)) $n\"; [ $r -eq 0 ]")
STOP_PODS_SCRIPT = "xargs -r -n 2 -P 0 sh -c '" + STOP_ONE_POD + "'"
# xargs: some of the commands it ran exited 1-125, here some `crictl stopp`.
XARGS_SOME_FAILED = 123
RELEASE_MANIFEST_NAME = "k4all"
FIELD_MANAGER = "k4all-upgrade"
OPERATOR_COMPONENT = "k4all-operator"
KUBE_VIP_COMPONENT = "kube-vip"
KUBE_VIP_MANIFEST = "/etc/kubernetes/manifests/kube-vip.yaml"
K4ALL_CONFIG_FILE = "/etc/k4all-config.yaml"
K4ALL_RELEASE_FILE = "/etc/k4all-release.yaml"
KUBE_VIP_IMAGE = "ghcr.io/kube-vip/kube-vip"
SUPER_ADMIN_KUBECONFIG = "/etc/kubernetes/super-admin.conf"
OPERATOR_NAMESPACE = "k4all-operator-system"
OPERATOR_DEPLOYMENT = "k4all-operator-controller-manager"

DEFAULT_CONFIG = {
