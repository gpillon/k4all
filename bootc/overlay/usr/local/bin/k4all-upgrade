#!/usr/bin/env python3
# K4All node upgrade tool
# SPDX-License-Identifier: GPL-3.0-or-later
"""Walk k4all release hops on a bootc node without ever skipping a
Kubernetes minor.

Each hop goes through the same phases:

    PREFLIGHT -> BACKUP -> STAGE -> PRE_REBOOT -> DRAIN -> REBOOT
    -> POST_BOOT -> COMMIT

The new image is staged with ``bootc switch --download-only``. When the hop
changes Kubernetes, the control plane is upgraded with the kubeadm taken from
the staged image *before* the reboot, so the kubelet is never newer than the
apiserver. The reboot then brings kubelet and CRI-O to the new version.

State lives in /var/lib/k4all/upgrade/state.json (/var survives switch and
rollback). ``k4all-upgrade resume`` runs at boot and continues the hop.
"""

import argparse
import base64
import collections
import datetime
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request

