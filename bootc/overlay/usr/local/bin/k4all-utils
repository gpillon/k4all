    echo "$args"
}

retry_command() {
  local command="$1"
  local max_retries="$2"
  local delay="$3"
  local retry_count=0
  local success=false

  while [ "$retry_count" -lt "$max_retries" ]; do
    echo "Attempt $(($retry_count + 1))..."

    # Execute the command
    if eval "$command"; then
      echo "Command executed successfully."
      success=true
      break
    else
      echo "Command failed. Retrying in $delay seconds..."
      retry_count=$(($retry_count + 1))
      sleep "$delay"
    fi
  done

  # Check if we succeeded after all retries
  if [ "$success" = false ]; then
    echo "Command failed after $max_retries retries."
    return 1
  fi
}

# Function to set up kubeconfig for a specified user
function setup_kubeconfig_for_user() {
  local user_name=$1
  local user_home=$2
  local override_file_name=${3:-"admin.conf"}

  mkdir -p "${user_home}/.kube"
  cp /etc/kubernetes/${override_file_name} "${user_home}/.kube/config"
  chown "${user_name}:${user_name}" "${user_home}/.kube/config"
}

# Function to finalize the setup for a specified user
finalize_k8s_setup_for_user() {
  local user_name=$1
  local user_home=$2

  # Ensure the .kube directory exists
  mkdir -p "${user_home}/.kube"

  # Generate the kubectl completion script
  local completion_file="${user_home}/.kube/completion.bash.inc"
  kubectl completion bash > "$completion_file"

  # Source the completion script in the user's .bash_profile if not already sourced
  local source_string="source '$completion_file'"
  if ! grep -qF "$source_string" "${user_home}/.bash_profile"; then
    printf "\n# kubectl shell completion\n$source_string\n" >> "${user_home}/.bash_profile"
  fi
}

function get_network_device() {
    ip route show default | awk '/default/ {print $5; exit}'
}

# Function to get the first available physical network interface
get_first_physical_interface() {
  ip link show | awk '/^[0-9]+: [^lo]/ {print $2}' | grep -v 'ovs-bridge' | sed 's/://g' | head -n 1
}

# Function to get the physical interface from the Open vSwitch bridge
get_physical_interface_for_ovs_port() {
  local ovs_port=$1
  ovs-vsctl list interface "$ovs_port" 2>/dev/null | grep 'type.*system' >/dev/null && echo "$ovs_port" || echo ""
}

# Function to find the original physical interface used in the bridge
get_original_physical_interface() {
  for port in $(ovs-vsctl list-ports ovs-bridge); do
    # shellcheck disable=SC2155 # kept: split, a failure here would stop set -e callers
    local physical_interface=$(get_physical_interface_for_ovs_port "$port")
    if [ -n "$physical_interface" ]; then
      echo "$physical_interface"
      return
    fi
  done
  # If no physical interface is found, return the first physical interface available
  get_first_physical_interface
}

get_real_interface() {
  # shellcheck disable=SC2155 # kept: split, a failure here would stop set -e callers
  local NET_DEV=$(get_network_device)

  if [ "$NET_DEV" == "ovs-bridge" ]; then
    # shellcheck disable=SC2155 # kept: split, a failure here would stop set -e callers
    local PHYS_NET_DEV=$(get_original_physical_interface)
  else
    local PHYS_NET_DEV=$NET_DEV
  fi
  echo $PHYS_NET_DEV
}

remove_tagged_block() {
  local file_path="$1"
  local start_tag="$2"
  local end_tag="$3"
  
  sed -i "/#### ${start_tag} ####/,/#### ${end_tag} ####/d" "$file_path"
}


get_ip() {
    local ha_type
    ha_type=$(yq e '.spec.cluster.ha.type' "$K4ALL_CONFIG_FILE" 2>/dev/null)
    if [ "$ha_type" = "keepalived" ]; then
        yq e '.spec.cluster.ha.apiControlEndpoint' "$K4ALL_CONFIG_FILE"
    else
        hostname -I | awk '{print $1}'
    fi
}

# Function to get the current FQDN
get_fqdn() {
    hostname -f
}

# Function to check if the FQDN contains a domain part
has_domain() {
    local fqdn=$1
    [[ "$fqdn" =~ \. ]]
}

# Function to patch the ingress with a given host
patch_ingress() {
    local host=$1
    local route_number=$2
    local route_host_prefix=$3
    local ingress_name=$4
    local ingress_namespace=$5


    kubectl --kubeconfig=$KUBECONFIG patch ingress $ingress_name -n $ingress_namespace --type=json -p="[
      {
        \"op\": \"replace\",
        \"path\": \"/spec/rules/$route_number/host\",
        \"value\": \"$route_host_prefix.$host\"
      }
    ]"
}

get_ingress_urls() {
  # get_ingress_urls "namespace" "ingress-name"
  local ingress_name="$1"
  local namespace="$2"

  if [[ -z "$namespace" || -z "$ingress_name" ]]; then
    echo "Usage: get_ingress_urls <namespace> <ingress_name>" >&2
    exit 1
  fi

  if ! kubectl get ingress "$ingress_name" -n "$namespace" &> /dev/null; then
    echo "Ingress '$ingress_name' not found in namespace '$namespace'" >&2
    exit 1
  fi

  kubectl get ingress "$ingress_name" -n "$namespace" -o jsonpath='{range .spec.rules[*]}{.host}{"\n"}{end}' | while read host; do
    kubectl get ingress "$ingress_name" -n "$namespace" -o jsonpath="{range .spec.rules[?(@.host=='$host')].http.paths[*]}https://$host{.path}{'\n'}{end}"
  done
}

cidr_to_mask() {
  local cidr=$1
  local mask=""
  local full_octets=$((cidr / 8))
  local partial_octet=$((cidr % 8))

  for ((i=0; i<4; i++)); do
    # shellcheck disable=SC2324 # appends on purpose: the mask is a string
    if [ $i -lt $full_octets ]; then
      mask+=255
    elif [ $i -eq $full_octets ]; then
      mask+=$((256 - 2**(8-partial_octet)))
    else
      mask+=0
    fi
    if [ $i -lt 3 ]; then
      mask+='.'
    fi
  done

  echo $mask
}

# Function to convert subnet mask to CIDR notation
mask_to_cidr() {
  c=0 x=0$( printf '%o' ${1//./ } )
  while [ $x -gt 0 ]; do
      let c+=$((x%2)) 'x>>=1'
  done

  echo $c ; 
}

# Function to get the system's architecture
get_architecture() {
    uname -m
}

# Function to set CLI_ARCH based on the detected architecture
set_cli_arch() {
    # shellcheck disable=SC2155 # kept: split, a failure here would stop set -e callers
    local ARCH=$(get_architecture)
    case "${ARCH}" in
        x86_64)
            CLI_ARCH="amd64"
            ;;
        armv7l | armv8* | aarch64)
            CLI_ARCH="arm64"
            ;;
        *)
            echo "Unsupported architecture: ${ARCH}"
            exit 1
            ;;
    esac
    echo "CLI_ARCH is set to: ${CLI_ARCH}"
    export CLI_ARCH
}

patch_deployment_image_registry() {
    local ns="$1"
    local deploy="$2"
    local container_index="${3:-0}"
    local registry="${4:-docker.io}"

    # recupera immagine attuale
    local image
    image=$(kubectl -n "$ns" get deploy "$deploy" -o jsonpath="{.spec.template.spec.containers[$container_index].image}")

    if [[ -z "$image" ]]; then
        echo "❌ Impossibile recuperare l'immagine del deployment $deploy nel namespace $ns"
        return 1
    fi

    # Controlla se ha già un registry (un punto nel primo token prima dello slash)
    local first_token="${image%%/*}"
    if [[ "$first_token" == *.* ]]; then
        echo "✅ Nessuna patch necessaria, immagine già con registry: $image"
        return 0
    fi

    local new_image=""
    if [[ "$image" == */* ]]; then
        # Caso org/repo[:tag]
        new_image="${registry}/${image}"
    else
        # Caso solo nome immagine
        if [[ "$registry" == "docker.io" ]]; then
            new_image="${registry}/library/${image}"
        else
            # per gli altri registry aggiungo l'org = nome immagine
            local repo="${image%%:*}"
            new_image="${registry}/${repo}/${image}"
        fi
    fi

    echo "⚙️  Patching $deploy (ns=$ns, container=$container_index): $image -> $new_image"
    kubectl -n "$ns" patch deployment "$deploy" \
      --type='json' \
      -p="[ {\"op\": \"replace\", \"path\": \"/spec/template/spec/containers/$container_index/image\", \"value\": \"$new_image\"} ]"
}
# --- The kubelet's node IP -------------------------------------------------
# Without --node-ip the kubelet picks the node's address itself at every
# start, from the hostname (systemd's nss-myhostname lists every local
# address) or the default route. Once k4all moves the IP from the NIC to
# ovs-bridge and the CNI adds its own interfaces, it can register an address
# of the pod network (cilium_host) as the node's InternalIP. k4all pins the
# address once, before the kubelet first starts, and keeps it pinned.
KUBELET_SYSCONFIG="${KUBELET_SYSCONFIG:-/etc/sysconfig/kubelet}"
KUBEADM_FLAGS_FILE="${KUBEADM_FLAGS_FILE:-/var/lib/kubelet/kubeadm-flags.env}"
KUBELET_KUBECONFIG_FILE="${KUBELET_KUBECONFIG_FILE:-/etc/kubernetes/kubelet.conf}"
# The address k4all wrote: one it may move when the node's address changes.
K4ALL_NODE_IP_STATE="${K4ALL_NODE_IP_STATE:-/var/lib/k4all/kubelet-node-ip}"

# node_ip_foreign_dev DEV: true for interfaces whose addresses are never the
# node's own (CNI, tunnels, VMs, containers).
node_ip_foreign_dev() {
    case "$1" in
        "" | lo | cilium_* | lxc* | cali* | tunl* | vxlan* | flannel* | cni* | docker* | podman* \
            | veth* | kube-ipvs* | genev* | ovs-system | br-int | k6t-* | tap* | virbr*) return 0 ;;
    esac
    return 1
}

# route_src_to IP: "SRC DEV" of the route the kernel takes towards IP, plus
# " local" when IP is an address of this node. Nothing without a route.
route_src_to() {
    ip -4 -o route get "$1" 2>/dev/null | awk '
        { for (i = 1; i <= NF; i++) { if ($i == "src") s = $(i + 1); if ($i == "dev") d = $(i + 1) }
          if ($1 == "local") l = " local" }
        END { if (s != "") print s, d l }'
}

# api_server_ip: the IPv4 address of the API server in kubelet.conf (empty
# before the node joined, or when it does not resolve).
api_server_ip() {
    local host
    [ -f "$KUBELET_KUBECONFIG_FILE" ] || return 0
    host=$(sed -n 's#^[[:space:]]*server:[[:space:]]*https\?://\([^:/]*\).*#\1#p' "$KUBELET_KUBECONFIG_FILE" | head -n 1)
    host=${host#[}
    host=${host%]}
    [ -n "$host" ] || return 0
    if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$host"
    else
        getent ahostsv4 "$host" 2>/dev/null | awk 'NR == 1 {print $1}'
    fi
}

# node_ip_on_host IP: true when IP is a global address of one of the node's
# own interfaces.
node_ip_on_host() {
    local dev
    dev=$(ip -4 -o addr show scope global 2>/dev/null | awk -v ip="$1" '{split($4, a, "/"); if (a[1] == ip) {print $2; exit}}')
    [ -n "$dev" ] && ! node_ip_foreign_dev "$dev"
}

# node_ip_candidate: the node's address. The source address towards the API
# server when that is another node (a worker, a joining control plane); else
# the source address of the default route: on a control plane holding the
# API VIP the VIP is local, and the kernel's source is the primary address.
node_ip_candidate() {
    local api r src dev
    api=$(api_server_ip)
    if [ -n "$api" ]; then
        r=$(route_src_to "$api")
        if [ -n "$r" ] && [[ "$r" != *" local" ]]; then
            read -r src dev _ <<<"$r"
            if ! node_ip_foreign_dev "$dev" && node_ip_on_host "$src"; then
                echo "$src"
                return 0
            fi
        fi
    fi
    dev=$(ip -4 route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
    [ -n "$dev" ] && ! node_ip_foreign_dev "$dev" || return 0
    r=$(route_src_to 192.0.2.1)
    read -r src dev _ <<<"$r"
    if [ -n "$src" ] && ! node_ip_foreign_dev "$dev" && node_ip_on_host "$src"; then
        echo "$src"
    fi
}

# kubelet_node_ip_flag FILE: the --node-ip value FILE sets, if any.
kubelet_node_ip_flag() {
    local flag
    [ -f "$1" ] || return 0
    flag=$(grep -o -- '--node-ip[= ][^ "'"'"']*' "$1" 2>/dev/null | head -n 1) || true
    [ -n "$flag" ] && echo "${flag:10}"
    return 0
}

# set_kubelet_extra_node_ip IP: KUBELET_EXTRA_ARGS in /etc/sysconfig/kubelet
# gets --node-ip=IP; its other flags stay.
set_kubelet_extra_node_ip() {
    local ip="$1" line args
    mkdir -p "$(dirname "$KUBELET_SYSCONFIG")"
    touch "$KUBELET_SYSCONFIG"
    line=$(grep -m 1 '^KUBELET_EXTRA_ARGS=' "$KUBELET_SYSCONFIG" || true)
    args=${line#KUBELET_EXTRA_ARGS=}
    args=${args#\"}
    args=${args%\"}
    args=${args#\'}
    args=${args%\'}
    args=$(echo "$args" | sed -E 's/(^|[[:space:]])--node-ip[= ][^[:space:]]*//g; s/^[[:space:]]+//; s/[[:space:]]+$//')
    args="${args:+$args }--node-ip=$ip"
    if [ -n "$line" ]; then
        sed -i "s#^KUBELET_EXTRA_ARGS=.*#KUBELET_EXTRA_ARGS=\"$args\"#" "$KUBELET_SYSCONFIG"
    else
        echo "KUBELET_EXTRA_ARGS=\"$args\"" >>"$KUBELET_SYSCONFIG"
    fi
}

# pin_kubelet_node_ip: pin the kubelet to the node's address, before the
# kubelet starts (k4all-node-ip.service, kubeadm init and join). A --node-ip
# k4all did not write (kubeadm's flags, a restore, the admin) is left as it
# is. The one k4all wrote moves only when its address left the node (a new
# DHCP lease). Prints what it did; changes nothing when no address is found.
pin_kubelet_node_ip() {
    local current mine ip
    current=$(kubelet_node_ip_flag "$KUBEADM_FLAGS_FILE")
    if [ -n "$current" ]; then
        echo "kubelet node IP: $current, set in $KUBEADM_FLAGS_FILE"
        return 0
    fi
    current=$(kubelet_node_ip_flag "$KUBELET_SYSCONFIG")
    mine=$(cat "$K4ALL_NODE_IP_STATE" 2>/dev/null || true)
    if [ -n "$current" ] && [ "$current" != "$mine" ]; then
        echo "kubelet node IP: $current, set in $KUBELET_SYSCONFIG"
        return 0
    fi
    if [ -n "$current" ] && node_ip_on_host "$current"; then
        echo "kubelet node IP: $current"
        return 0
    fi
    ip=$(node_ip_candidate)
    if [ -z "$ip" ]; then
        echo "kubelet node IP: no address found (no route to the API server, no default route): not pinned"
        return 0
    fi
    set_kubelet_extra_node_ip "$ip"
    mkdir -p "$(dirname "$K4ALL_NODE_IP_STATE")"
    echo "$ip" >"$K4ALL_NODE_IP_STATE"
    if [ -n "$current" ]; then
        echo "kubelet node IP: $current left the node, pinned to $ip"
    else
        echo "kubelet node IP: pinned to $ip"
    fi
}
