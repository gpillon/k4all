{
  "version": "2.0.1",
  "networking": {
    "cni": {
      "type": "calico"
    },
    "firewalld": {
      "enabled": "false"
    },
    "iface": {
      "dev": "auto",
      "ipconfig": "dhcp"
    }
  },
  "disk": {
    "root": {
      "disk": "auto",
      "size_mib": "20%"
    },
    "keep_lvm": "true"
  },
  "storage": {
    "vg_data": {
      "enabled": "true",
      "disk": "auto",
      "size": "remaining"
    }
  },
  "features": {
    "virt": {
      "enabled": "false",
      "emulation": "auto"
    },
    "argocd": {
      "enabled": "false"
    }
  },
  "cluster": {
    "apiEndPointUseHostName": "false",
    "customApiEndPoint": "",
    "ha": {
      "interface": "auto",
      "type": "none"
    }
  },
  "proxy": {
    "http_proxy": "",
    "https_proxy": "",
    "no_proxy": ""
  }
}
