[Unit]
Description=K4All - Restore from Backup (if backup archive found)
DefaultDependencies=no
Before=fck8s-role-dispatcher.service
Before=fck8s-k8s-setup-ph2.service
Before=fck8s-k8s-setup-ph3.service
Before=fck8s-k8s-setup-init.service
Before=kubelet.service
After=fck8s-restore.service
After=fck8s-first-boot.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/k4all-migrate-config.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
