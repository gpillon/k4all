[Unit]
Description=K4All - Install Metric Server
Requires=fck8s-node-ready-and-schedulable.service
After=fck8s-node-ready-and-schedulable.service
ConditionPathExists=/etc/kubernetes/admin.conf
ConditionPathExists=!/opt/k4all/setup-metrics.done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-metrics.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

