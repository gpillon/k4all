[Unit]
Description=K4All - Continue a release upgrade after reboot
After=network-online.target crio.service kubelet.service fck8s-migrate.service
Wants=network-online.target
ConditionPathExists=/var/lib/k4all/upgrade/state.json

[Service]
# exec, not oneshot: the post-boot checks can take minutes and must not
# hold back multi-user.target.
Type=exec
# --boot: only hops past their reboot; a hop that waits belongs to the
# timer and to the agent.
ExecStart=/usr/local/bin/k4all-upgrade resume --boot

[Install]
WantedBy=multi-user.target
