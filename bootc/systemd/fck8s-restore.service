[Unit]
Description=K4All - Restore from Backup (if backup archive found)
DefaultDependencies=no
Before=fck8s-role-dispatcher.service fck8s-k8s-setup-ph2.service fck8s-k8s-setup-ph3.service
After=fck8s-first-boot.service local-fs.target
ConditionPathExists=!/opt/k4all/restore.done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/k4all-restore.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
